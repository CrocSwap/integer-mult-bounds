diff --git a/tests/test_deferred_signed_optimization.py b/tests/test_deferred_signed_optimization.py
new file mode 100644
--- /dev/null
+++ b/tests/test_deferred_signed_optimization.py
@@ -0,0 +1,65 @@
+"""Subprocess controls for the deferred-signed verification boundary.
+
+Maintainer hardening with OpenAI Codex assistance; Apache-2.0.
+These controls do not certify the multiplication theorem.
+"""
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+PACKAGE = ROOT/'research/deferred-signed'
+DRIVERS = ('verify.py', 'check_complex_identity.py',
+           'round7_literal_frame_ledger.py', 'round7_tensor_endpoint_controls.py',
+           'round6_complex_interface_controls.py', 'round6_complex_literal_ledger.py',
+           'round7_balanced_assembly_candidate.py')
+
+
+class OptimizationControls(unittest.TestCase):
+    def test_all_drivers_reject_optimized_execution_before_work(self):
+        modes = ((['-O'], ''), (['-OO'], ''), ([], '1'), ([], '2'))
+        for driver in DRIVERS:
+            for flags, optimization in modes:
+                with self.subTest(driver=driver, flags=flags, env=optimization):
+                    with tempfile.TemporaryDirectory() as directory:
+                        result = subprocess.run(
+                            [sys.executable, *flags, str(PACKAGE/driver)],
+                            cwd=directory,
+                            env=dict(os.environ, PYTHONOPTIMIZE=optimization),
+                            capture_output=True, text=True, timeout=10)
+                        self.assertNotEqual(result.returncode, 0)
+                        self.assertIn('Assertions must remain enabled', result.stderr)
+                        self.assertEqual(result.stdout, '')
+                        self.assertEqual(list(Path(directory).iterdir()), [])
+
+    def test_unoptimized_verifier_still_accepts_help(self):
+        result = subprocess.run(
+            [sys.executable, str(PACKAGE/'verify.py'), '--help'],
+            env=dict(os.environ, PYTHONOPTIMIZE=''),
+            capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('--replay', result.stdout)
+
+    def test_normal_source_pin_check_rejects_bad_hash(self):
+        spec = importlib.util.spec_from_file_location('guarded_deferred_verify', PACKAGE/'verify.py')
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        original_read = module.read
+
+        def changed_read(path):
+            result = original_read(path)
+            if Path(path) == PACKAGE/'SOURCE.json':
+                result['files']['.github/workflows/verify.yml'] = '0'*64
+            return result
+
+        module.read = changed_read
+        with self.assertRaisesRegex(AssertionError, 'source drift'):
+            module.verify_pins()
+
+
+if __name__ == '__main__':
+    unittest.main()
