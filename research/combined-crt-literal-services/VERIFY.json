{
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/source_check.py"
      ],
      "checks": "Authenticate all fourteen exact source files and reject a byte mutation.",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/verify.py"
      ],
      "checks": "Recreate the 70-role union and exact receipt: all primitive formulas, ownership, heads, histories, sealed complete CRT source invocation and four controls.",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-B",
        "-W",
        "error",
        "{package}/verify.py"
      ],
      "checks": "Repeat the complete deterministic receipt with Python assertions disabled.",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/review/check_join.py"
      ],
      "checks": "Independently reverse every state/role relocation and execute composed service traces with raw cells, separate numeric oracle, exact bills, suspended heads, historical tails and a bad role-map control.",
      "timeout_seconds": 120
    }
  ],
