  ⟨⟨56, 797284050375059, 700000000000000, 143200863318327805355599598986694337887174314034914, 143200863318327805355599598986694337887174314034919⟩, 1248, 0⟩]

def lowCut : Claim := ⟨10, 11, 50, 2425488982512924493014879543340159618052184678638, 2425488982512924493014879543340159618052184678643⟩

def highCut : Claim := ⟨11, 13, 50, 2726223169118157683569082859190315987564460060854, 2726223169118157683569082859190315987564460060859⟩

def floorCost : Claim := ⟨16, 17, 50, 3751458101362136341527504761035997125100712438316, 3751458101362136341527504761035997125100712438321⟩

def complexCut : Claim := ⟨11, 1, 7, 2058589199190980830650682003974609807383732971288, 2058589199190980830650682003974609807383732971293⟩

def complexCost : Claim := ⟨11, 387992803563, 100000000000000, 1475162402281397758280503096807531758032739501864, 1475162402281397758280503096807531758032739501869⟩

def scalarRows : List Claim := [lowCut, highCut, floorCost, complexCut, complexCost]

theorem bitMain_ok : (bitMain.map Row.power).all (valid bits frac) = true := by decide +kernel

theorem bitLow_ok : (bitLow.map Row.power).all (valid bits frac) = true := by decide +kernel

theorem bitHigh_ok : (bitHigh.map Row.power).all (valid bits frac) = true := by decide +kernel

theorem bitDrop_ok : (bitDrop.map Row.power).all (valid bits frac) = true := by decide +kernel

theorem complexMain_ok : (complexMain.map Row.power).all (valid bits frac) = true := by decide +kernel

theorem complexTilt_ok : (complexTilt.map Row.power).all (valid bits frac) = true := by decide +kernel

theorem scalars_ok : scalarRows.all (valid bits frac) = true := by decide +kernel


def tables : List (List Row) := [bitMain, bitLow, bitHigh, bitDrop, complexMain, complexTilt]
def claims : List Claim := tables.flatMap (fun xs => xs.map Row.power) ++ scalarRows

theorem table_sound (c : Claim) (hc : c ∈ claims) :
    0 < c.den ∧ c.lo^c.den ≤ c.rank^c.num * 2^(frac*c.den) ∧
      c.rank^c.num * 2^(frac*c.den) ≤ c.hi^c.den := by
  apply valid_sound bits
  apply List.all_eq_true.mp _ c hc
  simp only [claims, tables, List.flatMap_cons, List.flatMap_nil, List.all_append,
    List.all_nil, Bool.and_true, bitMain_ok, bitLow_ok, bitHigh_ok, bitDrop_ok,
    complexMain_ok, complexTilt_ok, scalars_ok]

def upperPaid (xs : List Row) (select : Nat → Bool := fun _ => true) : Nat :=
  (xs.map (fun row => if select row.power.rank then row.paid * row.power.hi else 0)).sum

def lowerTarget (xs : List Row) : Nat := (xs.map (fun row => row.target * row.power.lo)).sum
def upperTarget (xs : List Row) : Nat := (xs.map (fun row => row.target * row.power.hi)).sum
def targetCount (xs : List Row) : Nat := (xs.map Row.target).sum

def ratioBelow (x y num den : Nat) : Prop := 0 < y ∧ x*den < num*y
instance (x y num den : Nat) : Decidable (ratioBelow x y num den) :=
  inferInstanceAs (Decidable (0 < y ∧ x*den < num*y))

theorem bit_alpha : ratioBelow (upperPaid bitMain) (lowerTarget bitMain) 249999999999998000563 250000000000000000000 := by decide +kernel

theorem bit_first_low : ratioBelow (upperPaid bitLow (fun r => r ≤ 4) * grid) (lowCut.lo * lowerTarget bitMain) 720828660325258853331 2000000000000000000000 := by decide +kernel

theorem bit_rest_low : ratioBelow (upperPaid bitLow * grid) (lowCut.lo * lowerTarget bitMain) 9460180868969874332523 10000000000000000000000 := by decide +kernel

theorem bit_first_high : ratioBelow (upperPaid bitHigh (fun r => 4 < r) * grid) (highCut.lo * lowerTarget bitMain) 5969937509690282459981 10000000000000000000000 := by decide +kernel

theorem bit_rest_high : ratioBelow (upperPaid bitHigh * grid) (highCut.lo * lowerTarget bitMain) 9247497622443579677377 10000000000000000000000 := by decide +kernel

theorem bit_discard : ratioBelow (floorCost.hi * upperTarget bitDrop) (grid * lowerTarget bitMain) 1178602023822729540311 1250000000000000000000 := by decide +kernel

theorem complex_alpha : ratioBelow (upperPaid complexMain) (lowerTarget complexMain) 999999999999999999999999999 1000000000000000000000000000 := by decide +kernel

theorem complex_gamma : ratioBelow (upperPaid complexTilt * grid) (complexCut.lo * lowerTarget complexMain) 31 32 := by decide +kernel

theorem complex_delta : ratioBelow (12 * targetCount complexMain * grid^2) (complexCost.lo * lowerTarget complexMain) 31 32 := by decide +kernel


end RankMoments

