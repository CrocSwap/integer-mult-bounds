+def transfer_section_succ(I4, O4, I8, stats):
+    """as transfer_section, but each I8-only gate is placed just before the O4 image of its next matched I8 gate"""
+    a, b = align(I4, O4), align(I4, I8)
+    o2i = {j: i for i, j in a.items()}; i8from4 = {j: i for i, j in b.items()}
+    anchor = {j8: a[i4] for j8, i4 in i8from4.items() if i4 in a}
+    before, tail, buf = {}, [], []
+    for j8, g in enumerate(I8):
+        if j8 in anchor:
+            if buf: before.setdefault(anchor[j8], []).extend(buf); buf = []
+        elif j8 not in i8from4: buf.append(copy.deepcopy(g)); stats['kept_own'] += 1
+        else: stats['dropped_by_stage'] += 1
+    tail = buf
+    out = []
+    for k, g in enumerate(O4):
+        out.extend(before.get(k, []))
+        if k in o2i:
+            i4 = o2i[k]
+            if i4 in b:
+                g8 = copy.deepcopy(I8[b[i4]])
+                if I4[i4][-1] != g[-1]: g8[-1] = copy.deepcopy(g[-1]); stats['frames_changed'] += 1
+                out.append(g8)
+        else:
+            out.append(copy.deepcopy(g)); stats['introduced'] += 1
+    out.extend(tail)
+    return out
+
