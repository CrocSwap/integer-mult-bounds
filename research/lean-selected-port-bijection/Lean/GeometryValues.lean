import GeometryCatalog
import SignedTraceCore
namespace CurrentMain.ComplexGeometry
open CurrentMain.BinaryFrame CurrentMain.SignedTrace

structure NodeRecord where
  basis : Nat
  leftEdge : Nat
  rightEdge : Nat
  deriving DecidableEq, Repr

structure OpRecord where
  node : Nat
  frame : Nat
  edge : Nat
  deriving DecidableEq, Repr

def basisEdgeCheck (edges : Nat → EdgeRecord) (small large edge : Nat) : Bool :=
  decide (small=large) || decide ((edges edge).small=small ∧ (edges edge).large=large)

theorem basisEdgeCheck_sound (bases : Nat → BasisRecord) (edges : Nat → EdgeRecord)
    (valid : ∀ i, edgeValid bases (edges i)=true) (small large edge : Nat)
    (checked : basisEdgeCheck edges small large edge=true) :
    ∀ n, Span (bases small).rows n → Span (bases large).rows n := by
  rcases Bool.or_eq_true_iff.mp checked with same | linked
  · have eq : small=large := of_decide_eq_true same
    subst large
    exact fun _ member => member
  · have ids : (edges edge).small=small ∧ (edges edge).large=large := of_decide_eq_true linked
    simpa only [ids.1,ids.2] using (edgeValid_sound bases (edges edge) (valid edge)).1

def nodeCheck (bases : Nat → BasisRecord) (edges : Nat → EdgeRecord)
    (graph : Graph) (inputMask : Nat → Nat) (nodes : Nat → NodeRecord) (n : Nat) : Bool :=
  match graph n with
  | .zero => decide ((bases (nodes n).basis).rows=[])
  | .input i => decide ((bases (nodes n).basis).rows=[inputMask i])
  | .add l r _ => decide (l<n ∧ r<n) &&
      basisEdgeCheck edges (nodes l).basis (nodes n).basis (nodes n).leftEdge &&
      basisEdgeCheck edges (nodes r).basis (nodes n).basis (nodes n).rightEdge

/-- Sign does not change binary support. Closure under XOR records the actual
subspace generated by the input masks occurring in a signed graph value. -/
inductive GraphSupport (graph : Graph) (inputMask : Nat → Nat) : Nat → Nat → Prop where
  | zero (n : Nat) : GraphSupport graph inputMask n 0
  | input (n i : Nat) (spec : graph n=.input i) : GraphSupport graph inputMask n (inputMask i)
  | left (n l r : Nat) (neg : Bool) (spec : graph n=.add l r neg) (x : Nat)
      (member : GraphSupport graph inputMask l x) : GraphSupport graph inputMask n x
  | right (n l r : Nat) (neg : Bool) (spec : graph n=.add l r neg) (x : Nat)
      (member : GraphSupport graph inputMask r x) : GraphSupport graph inputMask n x
  | xor (n x y : Nat) (left : GraphSupport graph inputMask n x)
      (right : GraphSupport graph inputMask n y) : GraphSupport graph inputMask n (x ^^^ y)

theorem nodeCheck_support (bases : Nat → BasisRecord) (edges : Nat → EdgeRecord)
    (valid : ∀ i, edgeValid bases (edges i)=true) (graph : Graph)
    (inputMask : Nat → Nat) (nodes : Nat → NodeRecord)
    (checked : ∀ n, nodeCheck bases edges graph inputMask nodes n=true)
    (n x : Nat) (member : GraphSupport graph inputMask n x) :
    Span (bases (nodes n).basis).rows x := by
  induction member with
  | zero n => exact span_zero _
  | input n i spec =>
    have eq : (bases (nodes n).basis).rows=[inputMask i] :=
      of_decide_eq_true (by simpa only [nodeCheck,spec] using checked n)
    rw [eq]
    exact span_mem _ _ (by simp)
  | left n l r neg spec x member ih =>
    have all := checked n
    simp only [nodeCheck,spec] at all
    exact basisEdgeCheck_sound bases edges valid _ _ _
      (Bool.and_eq_true_iff.mp (Bool.and_eq_true_iff.mp all).1).2 x ih
  | right n l r neg spec x member ih =>
    have all := checked n
    simp only [nodeCheck,spec] at all
    exact basisEdgeCheck_sound bases edges valid _ _ _ (Bool.and_eq_true_iff.mp all).2 x ih
  | xor n x y left right ihl ihr => exact span_xor _ _ _ ihl ihr

def valuePortCheck (frames : Nat → FrameRecord) (edges : Nat → EdgeRecord)
    (nodes : Nat → NodeRecord) (port : OpRecord) : Bool :=
  basisEdgeCheck edges (nodes port.node).basis (frames port.frame).basis port.edge

theorem valuePortCheck_sound (bases : Nat → BasisRecord) (frames : Nat → FrameRecord)
    (edges : Nat → EdgeRecord) (catalog : ValidCatalog bases frames edges)
    (nodes : Nat → NodeRecord) (port : OpRecord)
    (checked : valuePortCheck frames edges nodes port=true) (n : Nat)
    (member : Span (bases (nodes port.node).basis).rows n) :
    Span (frameRows bases frames port.frame) n :=
  basisEdgeCheck_sound bases edges catalog.edges_valid _ _ _ checked n member

def operationsCheck (frames : Nat → FrameRecord) (edges : Nat → EdgeRecord)
    (nodes : Nat → NodeRecord) (operations : Nat → OpRecord) :
    List Annotation → List Nat → Bool
  | [], [] => true
  | a::rest, i::indices => decide ((operations i).node=a.result) &&
      valuePortCheck frames edges nodes (operations i) &&
      operationsCheck frames edges nodes operations rest indices
  | _, _ => false

theorem operationsCheck_append (frames : Nat → FrameRecord) (edges : Nat → EdgeRecord)
    (nodes : Nat → NodeRecord) (operations : Nat → OpRecord)
    (first second : List Annotation) (left right : List Nat)
    (a : operationsCheck frames edges nodes operations first left=true)
    (b : operationsCheck frames edges nodes operations second right=true) :
    operationsCheck frames edges nodes operations (first++second) (left++right)=true := by
  induction first generalizing left with
  | nil => cases left <;> simp_all [operationsCheck]
  | cons op rest ih =>
    cases left with
    | nil => simp [operationsCheck] at a
    | cons index indices =>
      have both := Bool.and_eq_true_iff.mp a
      have tail := ih indices both.2
      simp only [List.cons_append,operationsCheck, (Bool.and_eq_true_iff.mp both.1).1,
        (Bool.and_eq_true_iff.mp both.1).2,tail,Bool.true_and]

end CurrentMain.ComplexGeometry
