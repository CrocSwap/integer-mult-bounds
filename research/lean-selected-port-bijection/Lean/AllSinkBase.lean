def Valid (s : SinkRecord) : Prop :=
  s.pivot ∈ s.targets ∧ s.targets.length = 8 ∧ s.writes.length > 0 ∧
  s.lastWrite < s.firstPivotRead ∧ s.writes.all (fun w => decide (w.ca = 1 ∧ w.cb = 1)) = true
instance (s : SinkRecord) : Decidable (Valid s) := by unfold Valid; infer_instance

def compatible (s t : SinkRecord) : Bool :=
  if s.role = t.role then true else s.targets.all (fun i => !t.targets.contains i)

theorem selected_count : selectedSinks.length = 46 := by rfl

theorem selected_write_count : (selectedSinks.map (fun s => s.writes.length)).foldl Nat.add 0 = 119 := by rfl

theorem selected_target_count : (selectedSinks.flatMap (fun s => s.targets)).length = 368 := by rfl

theorem all_valid : selectedSinks.all (fun s => decide (Valid s)) = true := by rfl

