    check=lambda:legacy.pin_package(OLD/'inputs/pr7624/research/p104-w2-primal-dual-bypass')
    return with_custody(lambda:execute_body(root,work,stage,ledger,ident,consumer,legacy),check,work/(stage+'-custody-error.json'))

def custody_controls():
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        path=Path(d)/'secondary.json'
        def body():raise ValueError('primary control')
        def check():raise RuntimeError('custody control')
        try:with_custody(body,check,path)
        except ValueError as ex:
            need(str(ex)=='primary control' and any('secondary source custody failure' in x for x in ex.__notes__),'primary failure was masked')
        else:raise ValueError('dual failure accepted')
        row=read(path);need(row['primary_present'] is True and row['type']=='RuntimeError','secondary custody not recorded')
        only=Path(d)/'only.json'
        try:with_custody(lambda:None,check,only)
        except RuntimeError as ex:need(str(ex)=='custody control','custody-only error changed')
        else:raise ValueError('custody-only failure accepted')
        need(read(only)['primary_present'] is False,'custody-only diagnostic')
    return {'status':'PASS_CUSTODY_CONTROLS','dual_failure_preserves_primary':True,'custody_only_fails':True}

