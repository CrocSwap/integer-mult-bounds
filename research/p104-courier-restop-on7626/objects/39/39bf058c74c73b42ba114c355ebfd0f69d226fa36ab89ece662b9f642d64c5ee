def with_custody(body, check, diagnostic):
    # Preserve the scientific/body failure when a source custody check also
    # fails. A custody-only failure still fails the stage; log failure is
    # secondary and cannot replace an existing failure.
    primary=None;value=None
    try:value=body()
    except BaseException as ex:primary=ex
    secondary=None
    try:check()
    except BaseException as ex:secondary=ex
    if secondary is not None:
        details={'status':'SOURCE_CUSTODY_FAILED','type':type(secondary).__name__,'message':str(secondary),'primary_present':primary is not None}
        try:write(diagnostic,details)
        except BaseException as log_error:
            if primary is not None:primary.add_note('custody diagnostic write failure: '+repr(log_error))
            else:secondary.add_note('custody diagnostic write failure: '+repr(log_error))
        if primary is not None:primary.add_note('secondary source custody failure: '+repr(secondary))
    if primary is not None:raise primary
    if secondary is not None:raise secondary
    return value

