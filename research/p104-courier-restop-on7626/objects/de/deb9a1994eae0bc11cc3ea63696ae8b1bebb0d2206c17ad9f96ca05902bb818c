"""Exact literal source-to-successor binding; library only, no science execution."""
import gzip
import hashlib
import json

SOURCE_CAN = 'df521d552dc35de6271e67655e4f9c466bc9247d37a5196b85613870209106a2'
SOURCE_GZ = '501876971143a0588403d653852b2305893d9b385be94f0f5d7134ebd97e03f0'
CANDIDATE_CAN = 'b80b6e74bff87c8d8160c5e121dac7c68df0827a7061847b896075417a346238'
CANDIDATE_GZ = '3b0947df9d291308279a00e009f9c1f845151b5b40f81960a53a2949cb44c9a9'
MANIFEST_SHA = '5a3e0bcad804b9c91758bd2acdf8fa9490a8202e98b9b58305477b70f83a9857'
ORIGINS_SHA = '2ba9e98c76939497d5e68b377583e58cdfa523df1fbdd8d03e2d5bdd1a34a6d9'
HEAD = '5987b208bc05d066f01f800a3d88538cb216eccd'


def need(ok, message):
    if not ok:
        raise ValueError(message)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def canonical(obj):
    return json.dumps(obj, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode()


def check(source_raw, candidate_raw, manifest_raw, origins_raw):
    """Verify both exact bytes and full insertion/deletion projection.

    This establishes literal identity only. It is not the dirty-entry first gate,
    owned-observation proof, native replay, or a passing price receipt.
    """
    need(sha(source_raw) == SOURCE_GZ and sha(candidate_raw) == CANDIDATE_GZ and
         sha(manifest_raw) == MANIFEST_SHA and sha(origins_raw) == ORIGINS_SHA,
         'exact input bytes')
    source = json.loads(gzip.decompress(source_raw)); candidate = json.loads(gzip.decompress(candidate_raw))
    m = json.loads(manifest_raw); claimed_origins = json.loads(origins_raw)
    need(sha(canonical(source)) == SOURCE_CAN and sha(canonical(candidate)) == CANDIDATE_CAN,
         'canonical source or candidate')
    need(m['source_head'] == HEAD and m['source_canonical_sha256'] == SOURCE_CAN and
         m['source_gzip_sha256'] == SOURCE_GZ and m['source_events'] == 77371 and
         len(source['program']) == 77371 and len(candidate['program']) == 77373,
         'source identity or event shape')
    need({k:v for k,v in source.items() if k != 'program'} ==
         {k:v for k,v in candidate.items() if k != 'program'}, 'boundary metadata differs')
    program = source['program']; dels = {}; insertions = {}
    need(type(m['delete']) is list and type(m['insert_before']) is list and
         len(m['delete']) == 17, 'delete inventory')
    for row in m['delete']:
        i = row['source_index']
        need(type(i) is int and 0 <= i < len(program) and i not in dels and
             row['event'] == program[i], 'delete anchor mismatch')
        dels[i] = row['event']
    for row in m['insert_before']:
        i = row['source_index']; events = row['events']
        need(type(i) is int and 0 <= i < len(program) and i not in insertions and
             type(events) is list and events and all(type(e) is list and e for e in events),
             'insert anchor or payload mismatch')
        if 'anchor' in row:
            need(row['anchor'] == program[i], 'insert event anchor mismatch')
        insertions[i] = events
    need(sum(len(es) for es in insertions.values()) == 19, 'insert count')
    out = []; origins = []; reverse = [None] * len(program)
    for i, e in enumerate(program):
        for x in insertions.get(i, []):
            out.append(x); origins.append(None)
        if i not in dels:
            reverse[i] = len(out); out.append(e); origins.append(i)
    need(out == candidate['program'] and origins == claimed_origins, 'full literal projection')
    return {'source_canonical_sha256': SOURCE_CAN, 'candidate_canonical_sha256': CANDIDATE_CAN,
            'source_gzip_sha256': SOURCE_GZ, 'candidate_gzip_sha256': CANDIDATE_GZ,
            'manifest_sha256': MANIFEST_SHA, 'origins_sha256': ORIGINS_SHA,
            'source_events': len(program), 'candidate_events': len(out),
            'deleted': len(dels), 'inserted': 19, 'original_to_candidate': reverse}
