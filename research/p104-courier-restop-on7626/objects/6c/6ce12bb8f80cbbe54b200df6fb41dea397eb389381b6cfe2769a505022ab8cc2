CAND='b80b6e74bff87c8d8160c5e121dac7c68df0827a7061847b896075417a346238'
BASE_GZ='501876971143a0588403d653852b2305893d9b385be94f0f5d7134ebd97e03f0'
CAND_GZ='3b0947df9d291308279a00e009f9c1f845151b5b40f81960a53a2949cb44c9a9'
EXACT='ebef891409dca22052498c5e19bf8d01f31f7aadc6d93b6bba1e5c6c8811a645'
