{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [
    "numpy==2.5.4"
  ],
  "inputs": [
    "research/coupled-carrier-cap740/cap_check.py",
    "research/coupled-carrier-cap740/common.py",
    "research/coupled-carrier-cap740/vendor/PR3133-CAP.json",
    "research/coupled-carrier-cap740/vendor/PR3133-CREDITS.md",
    "research/coupled-carrier-cap740/vendor/PR3133-FILL.json.gz",
    "research/coupled-carrier-cap740/vendor/PR3133-NOTICE",
    "research/coupled-carrier-cap740/vendor/PR3133-PROVIDERS.json",
    "research/coupled-carrier-cap740/vendor/lift.py",
    "research/rank7-joint-endframes/allocation/DISPATCH.json",
    "research/rank7-joint-endframes/allocation/ORDER.json",
    "research/rank7-joint-endframes/allocation/vendor/PLAN.json.gz",
    "research/rank7-joint-endframes/allocation/vendor/TEMPLATE.json.gz",
    "research/rank7-joint-endframes/allocation/vendor/independent_owners.py"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 300,
      "checks": "Fresh local operator/frame proof and controls, literal owner reconstruction/audit, two exact moment engines and transfer, all2551 packing patterns, plus narrow recorded-summary consistency; not a full native/admission replay."
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/full-admission/fresh_replay_evidence.py",
        "check",
        "--root",
        "{package}/full-admission/fresh-replay"
      ],
      "timeout_seconds": 30,
      "checks": "Check the separately recorded completed public-wrapper receipt chain."
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/full-admission/fresh_replay_evidence.py",
        "controls",
        "--root",
        "{package}/full-admission/fresh-replay"
      ],
      "timeout_seconds": 30,
      "checks": "Reject unfinished attempt, external allocation, missing nested gate and stale terminal receipt at semantic predicates."
    }
  ]
}
