{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "research/rational-all-column-c-word/inputs/source-finite-c-word.py",
    "research/rational-all-column-c-word/inputs/source-c-dispatch.py",
    "research/rational-all-column-c-word/inputs/SOURCE-BUTTERFLIES.md",
    "research/rational-all-column-c-word/inputs/COMPILER-APPLICATION.md"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/source_check.py"
      ],
      "timeout_seconds": 15,
      "checks": "Exact source bytes, Git blob and SHA256 pins with a mutation control."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/verify.py"
      ],
      "timeout_seconds": 60,
      "checks": "Exact all-column semantics, signed code, closed tensor oracle, grid and phase/owner/retirement controls."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/review/check_rational_grid.py"
      ],
      "timeout_seconds": 90,
      "checks": "Independent recursive Fraction engine and original odd-debt/binary-guard derivation checks."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/review/check_final_code.py"
      ],
      "timeout_seconds": 120,
      "checks": "Independent final-code review, nonbinary productive stock, deep denominator debt, arbitrary scalar height and all short unary strings."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-B",
        "-W",
        "error",
        "{package}/verify.py"
      ],
      "timeout_seconds": 60,
      "checks": "Same primary exact checks with assertions disabled."
    }
  ]
}
