theorem cert : Cert FceilBank (1/100) := by
  intro t h1 h2
  rw [eq_ceil]
  by_cases c1 : t ≤ (1/50:ℝ)
  · exact piece1 t (by linarith) c1
  push_neg at c1
  by_cases c2 : t ≤ (3/50:ℝ)
  · exact piece2 end1 t (by linarith) c2
  push_neg at c2
  by_cases c3 : t ≤ (11/100:ℝ)
  · exact piece3 end2 t (by linarith) c3
  push_neg at c3
  by_cases c4 : t ≤ (9/50:ℝ)
  · exact piece4 end3 t (by linarith) c4
  push_neg at c4
  by_cases c5 : t ≤ (7/25:ℝ)
  · exact piece5 end4 t (by linarith) c5
  push_neg at c5
  by_cases c6 : t ≤ (41/100:ℝ)
  · exact piece6 end5 t (by linarith) c6
  push_neg at c6
  by_cases c7 : t ≤ (3/5:ℝ)
  · exact piece7 end6 t (by linarith) c7
  push_neg at c7
  by_cases c8 : t ≤ (87/100:ℝ)
  · exact piece8 end7 t (by linarith) c8
  push_neg at c8
  exact piece9 end8 t (by linarith) h2

