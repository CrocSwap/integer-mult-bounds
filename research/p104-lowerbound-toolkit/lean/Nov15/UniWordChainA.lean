/-
UniWordChainA (lane UNI-L4, Nov 19).  WORDCHAIN data layer for the folded word t7669 (UniWCData, generated by unigen/genwc.py):
packed base-16 height tables, binary-tree sums `tsum` (depth 13, no deep recursion; LEANSWARM/BRIDGE.md encodings), kernel-checked totals
  D = 56, A = 10943, climb = 10887 (so excess = D + A - climb = 112 = 2 D),  descent count 23,
and the 8 descent chains: pure (height strictly drops, chart dst_j = chart src_{j+1}, height continuity, relay pair in the fold's relay list),
nodup src / dst charts (in/out <= 1), shapes, and the cover argument (23 chain steps = all 23 descent banks).  Kernel only.
-/
import Nov15.UniWCData
import Mathlib.Data.Finset.Card
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Tactic

namespace UniWC
open Finset T7669Data

def nib (X i : ℕ) : ℕ := X / 16 ^ i % 16

/-- binary-tree sum of g (nib X i) (nib Y i) over i in [lo, lo + 2^d). -/
def tsum (g : ℕ → ℕ → ℕ) (X Y : ℕ) : ℕ → ℕ → ℕ
  | 0, lo => g (nib X lo) (nib Y lo)
  | d + 1, lo => tsum g X Y d lo + tsum g X Y d (lo + 2 ^ d)

theorem tsum_eq (g : ℕ → ℕ → ℕ) (X Y : ℕ) :
    ∀ d lo, tsum g X Y d lo = ∑ i ∈ range (2 ^ d), g (nib X (lo + i)) (nib Y (lo + i))
  | 0, lo => by simp [tsum]
  | d + 1, lo => by
    rw [tsum, tsum_eq g X Y d lo, tsum_eq g X Y d (lo + 2 ^ d), pow_succ, mul_two, Finset.sum_range_add]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [add_assoc]

theorem nib_zero {X : ℕ} (n : ℕ) (hX : X < 16 ^ n) {i : ℕ} (hi : n ≤ i) : nib X i = 0 := by
  unfold nib
  rw [Nat.div_eq_of_lt (lt_of_lt_of_le hX (Nat.pow_le_pow_right (by norm_num) hi))]

/-- sums over [0, n) equal the tree sum when both tables vanish past n. -/
theorem sum_range_tsum (g : ℕ → ℕ → ℕ) (hg : g 0 0 = 0) (X Y n d : ℕ) (hX : X < 16 ^ n) (hY : Y < 16 ^ n)
    (hn : n ≤ 2 ^ d) : ∑ i ∈ range n, g (nib X i) (nib Y i) = tsum g X Y d 0 := by
  rw [tsum_eq]
  simp only [zero_add]
  refine Finset.sum_subset (range_subset_range.2 hn) ?_
  intro x _ hx
  have hx' : n ≤ x := by simpa using hx
  rw [nib_zero n hX hx', nib_zero n hY hx', hg]

def gD (a b : ℕ) : ℕ := a - b
def gA (a b : ℕ) : ℕ := b - a
def gC (a b : ℕ) : ℕ := if b < a then 1 else 0

theorem HS_lt : HS < 16 ^ NB := by decide +kernel
theorem HD_lt : HD < 16 ^ NB := by decide +kernel
theorem FI_lt : FI < 16 ^ NF := by decide +kernel
theorem FF_lt : FF < 16 ^ NF := by decide +kernel

theorem D_data : tsum gD HS HD 13 0 = 56 := by decide +kernel
theorem A_data : tsum gA HS HD 13 0 = 10943 := by decide +kernel
theorem C_data : tsum gA FI FF 11 0 = 10887 := by decide +kernel
theorem N_data : tsum gC HS HD 13 0 = 23 := by decide +kernel

theorem D_sum : ∑ i ∈ range NB, gD (nib HS i) (nib HD i) = 56 := by
  rw [sum_range_tsum gD rfl HS HD NB 13 HS_lt HD_lt (by decide), D_data]
theorem A_sum : ∑ i ∈ range NB, gA (nib HS i) (nib HD i) = 10943 := by
  rw [sum_range_tsum gA rfl HS HD NB 13 HS_lt HD_lt (by decide), A_data]
theorem C_sum : ∑ i ∈ range NF, gA (nib FI i) (nib FF i) = 10887 := by
  rw [sum_range_tsum gA rfl FI FF NF 11 FI_lt FF_lt (by decide), C_data]
theorem N_sum : ∑ i ∈ range NB, gC (nib HS i) (nib HD i) = 23 := by
  rw [sum_range_tsum gC rfl HS HD NB 13 HS_lt HD_lt (by decide), N_data]

/-! ## the descent chains -/

def hst (i : ℕ) : ℕ := nib HS i
def hdt (i : ℕ) : ℕ := nib HD i

/-- consecutive descents of a pure relay chain: chart continuity, height continuity, relay evidence from the fold. -/
def Link (a b : ℕ × ℕ × ℕ) : Prop := a.2.2 = b.2.1 ∧ hdt a.1 = hst b.1 ∧ (b.1, a.1) ∈ relays
instance : DecidableRel Link := fun a b => by unfold Link; infer_instance

def PureChain (c : List (ℕ × ℕ × ℕ)) : Prop := (∀ s ∈ c, s.1 < NB ∧ hdt s.1 < hst s.1) ∧ List.IsChain Link c
instance (c : List (ℕ × ℕ × ℕ)) : Decidable (PureChain c) := by unfold PureChain; infer_instance

theorem chains_pure : ∀ c ∈ chains, PureChain c := by decide +kernel

def shapeOf (c : List (ℕ × ℕ × ℕ)) : List ℕ := hst (c.headD (0, 0, 0)).1 :: c.map fun s => hdt s.1
theorem chains_shapes : chains.map shapeOf = shapes := by decide +kernel
theorem chains_count : chains.length = 8 := by decide +kernel
theorem steps_count : chains.flatten.length = 23 := by decide +kernel
theorem steps_nodup : (chains.flatten.map (·.1)).Nodup := by decide +kernel
/-- tie: every chart is the source of at most one chain step and the target of at most one. -/
theorem src_nodup : (chains.flatten.map (·.2.1)).Nodup := by decide +kernel
theorem dst_nodup : (chains.flatten.map (·.2.2)).Nodup := by decide +kernel
theorem chain_mass : (chains.flatten.map fun s => hst s.1 - hdt s.1).sum = 56 := by decide +kernel

theorem steps_desc : ∀ s ∈ chains.flatten, s.1 < NB ∧ hdt s.1 < hst s.1 := by
  intro s hs
  obtain ⟨c, hc, hsc⟩ := List.mem_flatten.1 hs
  exact (chains_pure c hc).1 s hsc

/-- COVER: the 23 chain steps are exactly the descent banks. -/
theorem desc_cover : ∀ i < NB, hdt i < hst i → ∃ s ∈ chains.flatten, s.1 = i := by
  set S : Finset ℕ := (chains.flatten.map (·.1)).toFinset with hS
  set T : Finset ℕ := (range NB).filter fun i => hdt i < hst i with hT
  have hST : S ⊆ T := by
    intro i hi
    obtain ⟨s, hs, rfl⟩ := List.mem_map.1 (List.mem_toFinset.1 hi)
    have := steps_desc s hs
    simp only [hT, Finset.mem_filter, Finset.mem_range]
    exact this
  have hSc : S.card = 23 := by
    rw [hS, List.toFinset_card_of_nodup steps_nodup, List.length_map, steps_count]
  have hTc : T.card = 23 := by
    rw [hT, Finset.card_filter]
    have : ∀ i, (if hdt i < hst i then 1 else 0) = gC (nib HS i) (nib HD i) := fun i => by
      simp only [gC, hst, hdt]; congr
    rw [Finset.sum_congr rfl fun i _ => this i, N_sum]
  have hEq : S = T := Finset.eq_of_subset_of_card_le hST (by omega)
  intro i hi hd
  have : i ∈ T := by simp [hT, hi, hd]
  rw [← hEq, hS] at this
  obtain ⟨s, hs, hsi⟩ := List.mem_map.1 (List.mem_toFinset.1 this)
  exact ⟨s, hs, hsi⟩

end UniWC
