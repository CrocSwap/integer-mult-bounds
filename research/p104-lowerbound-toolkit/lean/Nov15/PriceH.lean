/-
PriceH (lane PRICEH, Nov 20).  The per-call RUNG PREMISE `hprice` of UniPort.rung_port for a GENERAL label rank h.
  HCall h n QR : abstract call at label rank h: heights of fields (fa,fb) and banks (bs,bt) in 0..h, a set Mn of QR-main
    fields climbing h-1 (|Mn| = 2n+2QR), and the HEIGHT-CUT CONTRACT `hcut` (for every mask m: crossing fields + 2n·[m separates
    {1,h}|{0,h-1}] <= crossing banks).  At P104 (h = 9, n = 104) `hcut` is BankFitHS1.cut_hs (208 = 2n); for other h it is the
    named premise (the net-level cut lemma is typed at Fin 9 charts and is NOT retyped here).
  MolData h : the molecule certificate: for L = 1..h-1 an exact nonneg integer cut decomposition W L of
    D_L·min(L,d) + E_L·min(1,d) on heights 0..h with 2·sep >= D_L + E_L (L <= h-2), E_1 = E_{h-1} = 0 (generated by
    cards/WILD/NOVEL/priceh/gen.py, verified there in Fractions, here by decide+kernel).
  price_h : 0 <= bud (budget  c_1 - Σ_{L=2}^{h-2} (E_L/D_L) c_L ,  c_L = 2g_L - g_{L-1} - g_{L+1},  g d = d^s)  ⟹
      mains·(h-1)^s + X·(h^s-(h-1)^s) + n·(1 + (h-2)^s - (h-1)^s) <= Σ_banks d^s - helperCredit   for any X <= excess.
  rung_port_h : UniPort.rung_port with hprice discharged by price_h (S = 0).
Kernel only.
-/
import Nov15.BankMassF
import Mathlib.Tactic.IntervalCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.FieldSimp
import Mathlib.Algebra.BigOperators.Intervals

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace PriceH
open Finset BankNC0 BankMassF

/-- cut indicator of mask m on heights i, j -/
def xcut (m i j : ℕ) : ℕ := if m.testBit i = m.testBit j then 0 else 1

def decVal (W : List (ℕ × ℕ)) (i j : ℕ) : ℕ := (W.map fun p => p.2 * xcut p.1 i j).sum

/-- the separating cuts at label rank h: S ∩ {0,1,h-1,h} = {1,h} or {0,h-1}. -/
def isSepH (h m : ℕ) : Bool :=
  (m.testBit 1 && m.testBit h && !m.testBit 0 && !m.testBit (h - 1)) ||
  (!m.testBit 1 && !m.testBit h && m.testBit 0 && m.testBit (h - 1))

def sepValH (h : ℕ) (W : List (ℕ × ℕ)) : ℕ := (W.map fun p => if isSepH h p.1 then p.2 else 0).sum

/-- second difference c_L = 2 g L - g (L-1) - g (L+1) -/
def ccg (g : ℕ → ℝ) (L : ℕ) : ℝ := 2 * g L - g (L - 1) - g (L + 1)

/-- molecule certificate at label rank h -/
structure MolData (h : ℕ) where
  D : ℕ → ℕ
  E : ℕ → ℕ
  W : ℕ → List (ℕ × ℕ)
  hD : ∀ L, L ≤ h - 1 → 1 ≤ L → 0 < D L
  hdec : ∀ L, L ≤ h - 1 → 1 ≤ L → ∀ i, i ≤ h → ∀ j, j ≤ h →
    decVal (W L) i j = D L * min L (dh i j) + E L * min 1 (dh i j)
  hsep : ∀ L, L ≤ h - 2 → 1 ≤ L → D L + E L ≤ 2 * sepValH h (W L)
  hE1 : E 1 = 0
  hEtop : E (h - 1) = 0

/-- the m1-budget (helper mass needed by the molecules) -/
noncomputable def bud (h : ℕ) (MD : MolData h) (g : ℕ → ℝ) : ℝ :=
  ccg g 1 - ∑ L ∈ Icc 2 (h - 2), ((MD.E L : ℝ) / (MD.D L : ℝ)) * ccg g L

/-- abstract call at label rank h with the height-cut contract -/
structure HCall (h n QR : ℕ) (Fld Bank : Type) [Fintype Fld] [DecidableEq Fld] [Fintype Bank] where
  fa : Fld → ℕ
  fb : Fld → ℕ
  bs : Bank → ℕ
  bt : Bank → ℕ
  hfa : ∀ f, fa f ≤ h
  hfb : ∀ f, fb f ≤ h
  hbs : ∀ k, bs k ≤ h
  hbt : ∀ k, bt k ≤ h
  Mn : Finset Fld
  hmain : ∀ f ∈ Mn, dh (fa f) (fb f) = h - 1
  hcard : Mn.card = 2 * n + 2 * QR
  hcut : ∀ m : ℕ, ∑ f, xcut m (fa f) (fb f) + (if isSepH h m then 2 * n else 0) ≤
    ∑ k, xcut m (bs k) (bt k)

section call
variable {h n QR : ℕ} {Fld Bank : Type} [Fintype Fld] [DecidableEq Fld] [Fintype Bank]

def HCall.climb (c : HCall h n QR Fld Bank) (f : Fld) : ℕ := dh (c.fa f) (c.fb f)
def HCall.bankd (c : HCall h n QR Fld Bank) (k : Bank) : ℕ := dh (c.bs k) (c.bt k)

/-- excess mass: banked |Δh| minus field climb -/
noncomputable def HCall.excess (c : HCall h n QR Fld Bank) : ℝ :=
  ∑ k, (c.bankd k : ℝ) - ∑ f, (c.climb f : ℝ)

/-- banked price Σ d^s -/
noncomputable def HCall.spec (c : HCall h n QR Fld Bank) (s : ℝ) : ℝ := ∑ k, ((c.bankd k : ℕ) : ℝ) ^ s

/-- helper credit: Σ over non-main fields of climb^s -/
noncomputable def HCall.cred (c : HCall h n QR Fld Bank) (s : ℝ) : ℝ :=
  ∑ f ∈ univ \ c.Mn, ((c.climb f : ℕ) : ℝ) ^ s

theorem dec_all (c : HCall h n QR Fld Bank) (W : List (ℕ × ℕ)) :
    ∑ f, decVal W (c.fa f) (c.fb f) + 2 * n * sepValH h W ≤ ∑ k, decVal W (c.bs k) (c.bt k) := by
  induction W with
  | nil => simp [decVal, sepValH]
  | cons p W ih =>
    have hdv : ∀ i j, decVal (p :: W) i j = p.2 * xcut p.1 i j + decVal W i j := by
      intro i j; simp [decVal]
    have hsv : sepValH h (p :: W) = (if isSepH h p.1 then p.2 else 0) + sepValH h W := by
      simp [sepValH]
    simp only [hdv, hsv, sum_add_distrib, ← mul_sum]
    have hcut := c.hcut p.1
    have h2 : p.2 * (∑ f, xcut p.1 (c.fa f) (c.fb f) + (if isSepH h p.1 then 2 * n else 0)) ≤
        p.2 * ∑ k, xcut p.1 (c.bs k) (c.bt k) := Nat.mul_le_mul_left _ hcut
    have h3 : 2 * n * (if isSepH h p.1 then p.2 else 0) = p.2 * (if isSepH h p.1 then 2 * n else 0) := by
      split_ifs <;> ring
    rw [mul_add] at h2
    rw [mul_add, h3]
    omega

end call

/-- Abel summation of a concave price into truncated windows. -/
theorem abel (g : ℕ → ℝ) (h0 : g 0 = 0) :
    ∀ m d, d ≤ m + 1 → ∑ L ∈ Icc 1 m, ccg g L * ((min L d : ℕ) : ℝ) = g d - (g (m + 1) - g m) * d := by
  intro m
  induction m with
  | zero =>
    intro d hd
    interval_cases d <;> simp [h0]
  | succ m ih =>
    intro d hd
    rw [Finset.sum_Icc_succ_top (by omega)]
    have hc : ccg g (m + 1) = 2 * g (m + 1) - g m - g (m + 2) := by simp [ccg]
    rcases Nat.lt_or_ge d (m + 2) with hlt | hge
    · rw [ih d (by omega), hc, Nat.min_eq_right (by omega : d ≤ m + 1)]
      show _ = g d - (g (m + 2) - g (m + 1)) * d
      ring
    · have hd : d = m + 2 := by omega
      subst hd
      have e : ∑ L ∈ Icc 1 m, ccg g L * ((min L (m + 2) : ℕ) : ℝ) =
          ∑ L ∈ Icc 1 m, ccg g L * ((min L (m + 1) : ℕ) : ℝ) := by
        refine Finset.sum_congr rfl (fun L hL => ?_)
        have : L ≤ m := (Finset.mem_Icc.mp hL).2
        rw [Nat.min_eq_left (by omega : L ≤ m + 2), Nat.min_eq_left (by omega : L ≤ m + 1)]
      rw [e, ih (m + 1) le_rfl, hc, Nat.min_eq_left (by omega : m + 1 ≤ m + 2)]
      show _ = g (m + 2) - (g (m + 2) - g (m + 1)) * ((m + 2 : ℕ) : ℝ)
      push_cast
      ring

section main
variable {h n QR : ℕ} {Fld Bank : Type} [Fintype Fld] [DecidableEq Fld] [Fintype Bank]

set_option maxHeartbeats 1000000 in
/-- **price_h**: the per-call rung premise at label rank h = m+3, from the molecule certificate and the m1 budget. -/
theorem price_h (MD : MolData h) (hh : 3 ≤ h) (c : HCall h n QR Fld Bank) {s : ℝ} (hs0 : 0 < s) (hs1 : s ≤ 1)
    (hbud : 0 ≤ bud h MD (fun d : ℕ => (d : ℝ) ^ s)) (X : ℝ) (hX : X ≤ c.excess) :
    ((2 * n + 2 * QR : ℕ) : ℝ) * ((h : ℝ) - 1) ^ s + X * ((h : ℝ) ^ s - ((h : ℝ) - 1) ^ s)
      + (n : ℝ) * (1 + ((h : ℝ) - 2) ^ s - ((h : ℝ) - 1) ^ s) ≤ c.spec s - c.cred s := by
  classical
  obtain ⟨m, rfl⟩ : ∃ m, h = m + 3 := ⟨h - 3, by omega⟩
  set g : ℕ → ℝ := fun d : ℕ => (d : ℝ) ^ s with hg
  obtain ⟨p0, pm, pc⟩ := rpow_price hs0 hs1 (m + 4)
  have h0 : g 0 = 0 := p0
  have hcc : ∀ L, 1 ≤ L → L ≤ m + 2 → 0 ≤ ccg g L := by
    intro L h1 h2
    obtain ⟨j, rfl⟩ : ∃ j, L = j + 1 := ⟨L - 1, by omega⟩
    have := pc j (by omega)
    simp only [ccg, hg, Nat.add_sub_cancel]
    push_cast at this ⊢
    rw [show (j : ℝ) + 1 + 1 = j + 2 by ring]
    linarith
  have hsl : 0 ≤ g (m + 2 + 1) - g (m + 2) := by
    have := pm (m + 2) (by omega)
    simp only [hg]; push_cast at this ⊢; linarith
  -- heights
  have hcl : ∀ f, c.climb f ≤ m + 3 := fun f => by
    have := c.hfa f; have := c.hfb f; unfold HCall.climb dh; omega
  have hbk : ∀ k, c.bankd k ≤ m + 3 := fun k => by
    have := c.hbs k; have := c.hbt k; unfold HCall.bankd dh; omega
  -- window sums
  let Fs : ℕ → ℝ := fun L => ∑ f, ((min L (c.climb f) : ℕ) : ℝ)
  let Bs : ℕ → ℝ := fun L => ∑ k, ((min L (c.bankd k) : ℕ) : ℝ)
  let T : ℕ → ℝ := fun L => Bs L - Fs L
  -- molecule inequality (reals): D T_L + E T_1 >= 2 n sep
  have hmol : ∀ L, 1 ≤ L → L ≤ m + 2 →
      2 * (n : ℝ) * (sepValH (m + 3) (MD.W L) : ℝ) ≤ (MD.D L : ℝ) * T L + (MD.E L : ℝ) * T 1 := by
    intro L h1 h2
    have hd := dec_all c (MD.W L)
    have e1 : ∀ f, decVal (MD.W L) (c.fa f) (c.fb f) =
        MD.D L * min L (c.climb f) + MD.E L * min 1 (c.climb f) := fun f =>
      MD.hdec L (by omega) h1 _ (c.hfa f) _ (c.hfb f)
    have e2 : ∀ k, decVal (MD.W L) (c.bs k) (c.bt k) =
        MD.D L * min L (c.bankd k) + MD.E L * min 1 (c.bankd k) := fun k =>
      MD.hdec L (by omega) h1 _ (c.hbs k) _ (c.hbt k)
    simp only [e1, e2, sum_add_distrib, ← mul_sum] at hd
    have hd' : (((MD.D L * ∑ f, min L (c.climb f) + MD.E L * ∑ f, min 1 (c.climb f)
        + 2 * n * sepValH (m + 3) (MD.W L) : ℕ)) : ℝ) ≤
        ((MD.D L * ∑ k, min L (c.bankd k) + MD.E L * ∑ k, min 1 (c.bankd k) : ℕ) : ℝ) := by
      exact_mod_cast hd
    simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_sum, Nat.cast_ofNat] at hd'
    simp only [T, Bs, Fs]
    linarith
  have hT1 : (n : ℝ) ≤ T 1 := by
    have h1 := hmol 1 le_rfl (by omega)
    have h2 := MD.hsep 1 (by omega) le_rfl
    rw [MD.hE1] at h2 h1
    have hD := MD.hD 1 (by omega) le_rfl
    have h2' : ((MD.D 1 : ℕ) : ℝ) ≤ 2 * (sepValH (m + 3) (MD.W 1) : ℝ) := by exact_mod_cast (by simpa using h2)
    have hDp : (0 : ℝ) < (MD.D 1 : ℝ) := by exact_mod_cast hD
    have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    simp only [Nat.cast_zero, zero_mul, add_zero] at h1
    by_contra hlt
    push Not at hlt
    nlinarith
  have hTtop : 0 ≤ T (m + 2) := by
    have h1 := hmol (m + 2) (by omega) le_rfl
    have hE : MD.E (m + 2) = 0 := by have := MD.hEtop; simpa using this
    rw [hE] at h1
    have hD := MD.hD (m + 2) (by omega) (by omega)
    have hDp : (0 : ℝ) < (MD.D (m + 2) : ℝ) := by exact_mod_cast hD
    have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hsep0 : (0 : ℝ) ≤ (sepValH (m + 3) (MD.W (m + 2)) : ℝ) := Nat.cast_nonneg _
    simp only [Nat.cast_zero, zero_mul, add_zero] at h1
    by_contra hlt
    push Not at hlt
    nlinarith [mul_nonneg hn hsep0]
  have hstar : ∀ L, 2 ≤ L → L ≤ m + 1 →
      (n : ℝ) * (1 + (MD.E L : ℝ) / (MD.D L : ℝ)) ≤ T L + (MD.E L : ℝ) / (MD.D L : ℝ) * T 1 := by
    intro L h1 h2
    have hm := hmol L (by omega) (by omega)
    have hs := MD.hsep L (by omega) (by omega)
    have hs' : ((MD.D L : ℕ) : ℝ) + (MD.E L : ℝ) ≤ 2 * (sepValH (m + 3) (MD.W L) : ℝ) := by exact_mod_cast hs
    have hDp : (0 : ℝ) < (MD.D L : ℝ) := by exact_mod_cast MD.hD L (by omega) (by omega)
    have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have key : (n : ℝ) * ((MD.D L : ℝ) + (MD.E L : ℝ)) ≤ (MD.D L : ℝ) * T L + (MD.E L : ℝ) * T 1 := by
      nlinarith [mul_le_mul_of_nonneg_left hs' hn]
    rw [← sub_nonneg]
    have : T L + (MD.E L : ℝ) / (MD.D L : ℝ) * T 1 - (n : ℝ) * (1 + (MD.E L : ℝ) / (MD.D L : ℝ)) =
        ((MD.D L : ℝ) * T L + (MD.E L : ℝ) * T 1 - (n : ℝ) * ((MD.D L : ℝ) + (MD.E L : ℝ))) / (MD.D L : ℝ) := by
      field_simp
    rw [this]
    exact div_nonneg (by linarith) hDp.le
  -- window representation of g
  have hrepr : ∀ d, d ≤ m + 3 → g d = ∑ L ∈ Icc 1 (m + 2), ccg g L * ((min L d : ℕ) : ℝ)
      + (g (m + 2 + 1) - g (m + 2)) * d := by
    intro d hd
    have := abel g h0 (m + 2) d hd
    linarith
  have eB : ∑ k, g (c.bankd k) = ∑ L ∈ Icc 1 (m + 2), ccg g L * Bs L
      + (g (m + 2 + 1) - g (m + 2)) * ∑ k, (c.bankd k : ℝ) := by
    rw [Finset.sum_congr rfl (fun k _ => hrepr _ (hbk k)), sum_add_distrib, Finset.sum_comm, ← mul_sum]
    congr 1
    refine Finset.sum_congr rfl (fun L _ => ?_)
    simp only [Bs]; rw [mul_sum]
  have eF : ∑ f, g (c.climb f) = ∑ L ∈ Icc 1 (m + 2), ccg g L * Fs L
      + (g (m + 2 + 1) - g (m + 2)) * ∑ f, (c.climb f : ℝ) := by
    rw [Finset.sum_congr rfl (fun f _ => hrepr _ (hcl f)), sum_add_distrib, Finset.sum_comm, ← mul_sum]
    congr 1
    refine Finset.sum_congr rfl (fun L _ => ?_)
    simp only [Fs]; rw [mul_sum]
  -- the weighted window sum
  have hsplitT : ∑ L ∈ Icc 1 (m + 2), ccg g L * T L =
      ccg g 1 * T 1 + ∑ L ∈ Icc 2 (m + 1), ccg g L * T L + ccg g (m + 2) * T (m + 2) := by
    rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ m + 1 + 1)]
    have : Icc 1 (m + 1) = insert 1 (Icc 2 (m + 1)) := (by ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega)
    rw [this, Finset.sum_insert (by simp)]
  have hsplitC : ∑ L ∈ Icc 1 (m + 1), ccg g L = ccg g 1 + ∑ L ∈ Icc 2 (m + 1), ccg g L := by
    have : Icc 1 (m + 1) = insert 1 (Icc 2 (m + 1)) := (by ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega)
    rw [this, Finset.sum_insert (by simp)]
  have hS1 : ∑ L ∈ Icc 1 (m + 1), ccg g L = g 1 + g (m + 1) - g (m + 2) := by
    have := abel g h0 (m + 1) 1 (by omega)
    have e : ∑ L ∈ Icc 1 (m + 1), ccg g L * ((min L 1 : ℕ) : ℝ) = ∑ L ∈ Icc 1 (m + 1), ccg g L := by
      refine Finset.sum_congr rfl (fun L hL => ?_)
      have : 1 ≤ L := (Finset.mem_Icc.mp hL).1
      rw [Nat.min_eq_right this]; simp
    rw [e] at this
    have e2 : g (m + 1 + 1) = g (m + 2) := rfl
    rw [e2] at this
    simp at this
    linarith
  have hbud' : 0 ≤ ccg g 1 - ∑ L ∈ Icc 2 (m + 1), ((MD.E L : ℝ) / (MD.D L : ℝ)) * ccg g L := by
    have e : m + 3 - 2 = m + 1 := by omega
    unfold bud at hbud
    rw [e] at hbud
    exact hbud
  have hmid : ∑ L ∈ Icc 2 (m + 1), ccg g L * T L ≥
      (n : ℝ) * ∑ L ∈ Icc 2 (m + 1), ccg g L +
      ((n : ℝ) - T 1) * ∑ L ∈ Icc 2 (m + 1), ((MD.E L : ℝ) / (MD.D L : ℝ)) * ccg g L := by
    have step : ∀ L ∈ Icc 2 (m + 1), (n : ℝ) * ccg g L + ((n : ℝ) - T 1) * (((MD.E L : ℝ) / (MD.D L : ℝ)) * ccg g L)
        ≤ ccg g L * T L := by
      intro L hL
      have hL2 := Finset.mem_Icc.mp hL
      have hc := hcc L (by omega) (by omega)
      have := mul_le_mul_of_nonneg_left (hstar L hL2.1 hL2.2) hc
      nlinarith [this]
    have := Finset.sum_le_sum step
    rw [sum_add_distrib, ← mul_sum, ← mul_sum] at this
    linarith
  have hsum : (n : ℝ) * (g 1 + g (m + 1) - g (m + 2)) ≤ ∑ L ∈ Icc 1 (m + 2), ccg g L * T L := by
    rw [hsplitT]
    have htop : 0 ≤ ccg g (m + 2) * T (m + 2) := mul_nonneg (hcc _ (by omega) le_rfl) hTtop
    rw [← hS1, hsplitC]
    have hprod := mul_nonneg hbud' (sub_nonneg.2 hT1)
    nlinarith [hmid, hprod, htop]
  -- assemble
  have hsub : ∑ f ∈ univ \ c.Mn, g (c.climb f) + ∑ f ∈ c.Mn, g (c.climb f) = ∑ f, g (c.climb f) :=
    Finset.sum_sdiff (Finset.subset_univ _)
  have hMn : ∑ f ∈ c.Mn, g (c.climb f) = (2 * n + 2 * QR : ℕ) * g (m + 2) := by
    rw [Finset.sum_congr rfl (fun f hf => by
      rw [show c.climb f = m + 2 by have := c.hmain f hf; unfold HCall.climb; omega])]
    simp [c.hcard]
  have hspec : c.spec s = ∑ k, g (c.bankd k) := rfl
  have hcred : c.cred s = ∑ f ∈ univ \ c.Mn, g (c.climb f) := rfl
  have hexc : c.excess = ∑ k, (c.bankd k : ℝ) - ∑ f, (c.climb f : ℝ) := rfl
  have eT : ∑ L ∈ Icc 1 (m + 2), ccg g L * T L =
      ∑ L ∈ Icc 1 (m + 2), ccg g L * Bs L - ∑ L ∈ Icc 1 (m + 2), ccg g L * Fs L := by
    rw [← sum_sub_distrib]; refine Finset.sum_congr rfl (fun L _ => ?_); simp only [T]; ring
  have e1 : ((m + 3 : ℕ) : ℝ) - 1 = ((m + 2 : ℕ) : ℝ) := by push_cast; ring
  have e2 : ((m + 3 : ℕ) : ℝ) - 2 = ((m + 1 : ℕ) : ℝ) := by push_cast; ring
  have g1 : g 1 = 1 := by simp [hg]
  have e3 : g (m + 2 + 1) = ((m + 3 : ℕ) : ℝ) ^ s := rfl
  have e4 : g (m + 2) = ((m + 2 : ℕ) : ℝ) ^ s := rfl
  have e5 : g (m + 1) = ((m + 1 : ℕ) : ℝ) ^ s := rfl
  rw [e1, e2]
  rw [← e4, ← e5, ← e3]
  have hX' : X ≤ ∑ k, (c.bankd k : ℝ) - ∑ f, (c.climb f : ℝ) := by rw [← hexc]; exact hX
  have hmul : X * (g (m + 2 + 1) - g (m + 2)) ≤
      (g (m + 2 + 1) - g (m + 2)) * (∑ k, (c.bankd k : ℝ) - ∑ f, (c.climb f : ℝ)) := by
    linarith [mul_le_mul_of_nonneg_left hX' hsl]
  rw [hspec, hcred]
  rw [g1] at hsum
  linarith [hsub, hMn, eB, eF, eT, hsum, hmul]

end main


end PriceH

#print axioms PriceH.price_h
