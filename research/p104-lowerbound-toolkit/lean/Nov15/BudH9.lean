/-
BudH9 (lane DISCHARGE, Nov 20).  The budget premise `hbud` of PriceH.rung_port_h at h = 9 (the P104 rank), PROVED in Lean.
  bud9 = c_1 - (1/3) c_3 - c_5 - c_6 - c_7  with g d = d^s, s = 1-kappa  =  -F/3,  F = -6 + 2*2^s + 2*3^s - 4*4^s + 3*5^s + 3*7^s - 3*8^s.
  Certificate BudH9Cert.cert (generated by wordshapeh/genbud.py: rpow enclosures a/10^24, decide+kernel):  F < 0 on [146/15625, 1].
  hbud9 : for any kbar >= 146/15625.  rung_port_h9_bud : PriceHMain.rung_port_h9 with hbud removed.
Kernel only.
-/
import Nov15.BudH9Cert
import Nov15.PriceHMain
import Nov15.BudH

set_option linter.unusedVariables false

namespace BudH9
open PriceH Finset BudH BankNC0 SafeRungsPrice

theorem bud9_eq (κ : ℝ) (h1 : κ < 1) :
    bud 9 md9 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) = -BudH9Cert.FceilBank (1 - κ) / 3 := by
  have hz := zero_rpow_nat κ h1
  have hI : Finset.Icc 2 (9 - 2) = {2, 3, 4, 5, 6, 7} := by decide
  unfold bud
  rw [hI]
  simp [Finset.sum_insert, ccg, md9, molD9, molE9, BudH9Cert.FceilBank, hz]
  norm_num
  ring

theorem bud9_nonneg (κ : ℝ) (hk : (146 : ℝ) / 15625 ≤ κ) (h1 : κ < 1) :
    0 ≤ bud 9 md9 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) := by
  have := BudH9Cert.cert κ hk h1.le
  rw [bud9_eq κ h1]; linarith

theorem hbud9 (kbar : ℝ) (hkb : (146 : ℝ) / 15625 ≤ kbar) (κ : ℝ) (hκ1 : κ < 1) :
    kbar ≤ κ → 0 ≤ bud 9 md9 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) :=
  fun h => bud9_nonneg κ (le_trans hkb h) hκ1

/-- non-vacuity: strictly positive at the P104 ceiling. -/
theorem bud9_pos_at_ceiling : 0 < bud 9 md9 (fun d : ℕ => (d : ℝ) ^ (1 - (93454 : ℝ) / 10000000)) := by
  have hk : (146 : ℝ) / 15625 ≤ (93454 : ℝ) / 10000000 := by norm_num
  have := BudH9Cert.cert ((93454 : ℝ) / 10000000) hk (by norm_num)
  rw [bud9_eq _ (by norm_num)]
  have h2 := BudH9Cert.cert ((93454 : ℝ) / 10000000) hk (by norm_num)
  linarith

/-- the h = 9 rung theorem with the budget premise discharged. -/
theorem rung_port_h9_bud (n QR : ℕ) (ρD ρR kbar : ℝ) (L : ℕ) (T P : List (ℕ × ℕ))
    (hkb : (146 : ℝ) / 15625 ≤ kbar)
    (hcert : Cert (fun s => cdat s T - cdat s P - (L : ℝ) * UniPort.PortInv n QR 9 ρD ρR 0 s) kbar)
    {Fld Bank : Fin L → Type} [∀ i, Fintype (Fld i)] [∀ i, DecidableEq (Fld i)] [∀ i, Fintype (Bank i)]
    (C : ∀ i, HCall 9 n QR (Fld i) (Bank i)) (Dm Rm : Fin L → ℝ)
    (hD : ∀ i, ρD * n ≤ Dm i) (hR : ∀ i, ρR * n ≤ Rm i) (hX : ∀ i, Dm i + Rm i ≤ (C i).excess)
    (κ : ℝ) (hκ0 : 0 ≤ κ) (hκ1 : κ < 1)
    (hV : cdat (1 - κ) P + ∑ i, (C i).spec (1 - κ) ≤ cdat (1 - κ) T + ∑ i, (C i).cred (1 - κ)) :
    κ < kbar :=
  rung_port_h9 n QR ρD ρR kbar L T P hcert C Dm Rm hD hR hX κ hκ0 hκ1 (hbud9 kbar hkb κ hκ1) hV

end BudH9

#print axioms BudH9.bud9_nonneg
