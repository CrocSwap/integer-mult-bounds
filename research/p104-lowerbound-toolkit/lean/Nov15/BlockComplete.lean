/-- bitmap of the certified normal pairs, recomputed from FrameCert.certs -/
def keyBM : Nat := certs.foldl (fun m c => m ||| 2 ^ (cu1 c + 512 * cu2 c)) 0
theorem listedBM_eq : listedBM = keyBM := by decide +kernel

lemma foldl_key : ∀ (l : List (List Nat)) (acc k : Nat),
    (l.foldl (fun m c => m ||| 2 ^ (cu1 c + 512 * cu2 c)) acc).testBit k = true →
    acc.testBit k = true ∨ ∃ c ∈ l, cu1 c + 512 * cu2 c = k := by
  intro l
  induction l with
  | nil => intro acc k h; exact Or.inl h
  | cons c cs ih =>
    intro acc k h
    rcases ih _ _ h with h1 | ⟨c', hc', hk⟩
    · rw [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at h1
      rcases h1 with h2 | h2
      · exact Or.inl h2
      · exact Or.inr ⟨c, List.mem_cons_self, h2⟩
    · exact Or.inr ⟨c', List.mem_cons_of_mem _ hc', hk⟩

/-- all certified normals are < 512 -/
theorem certs_bound : certs.all (fun c => decide (cu1 c < 512) && decide (cu2 c < 512)) = true := by decide +kernel

lemma listed_mem (a b : Nat) (ha : a < 512) (hb : b < 512) (h : listedBM.testBit (a + 512 * b) = true) :
    ∃ c ∈ certs, cu1 c = a ∧ cu2 c = b := by
  rw [listedBM_eq] at h
  rcases foldl_key certs 0 _ h with h0 | ⟨c, hc, hk⟩
  · simp at h0
  · have hb := List.all_eq_true.1 certs_bound c hc
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hb
    exact ⟨c, hc, by omega, by omega⟩

/-- sanity: the table rows range over exactly 43435 canonical pairs (counted in 8 chunks of 64 rows) -/
def cntRow (a : Nat) : Nat := ((List.range 512).filter (fun b => canonP a b)).length
theorem canon_chunk0 : (List.range 64).foldl (fun s j => s + cntRow (0 + j)) 0 = 14763 := by decide +kernel
theorem canon_chunk1 : (List.range 64).foldl (fun s j => s + cntRow (64 + j)) 0 = 12288 := by decide +kernel
