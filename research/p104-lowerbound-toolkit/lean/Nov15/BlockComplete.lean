/-- COMPLETENESS: every 7-dim section (two distinct nonzero normals u1,u2 < 512) that meets all 759 frames
has the same Lam as one of the 1152 certified ones. -/
theorem block_complete (u1 u2 : Nat) (h1 : 0 < u1) (h2 : 0 < u2) (hne : u1 ≠ u2)
    (h1' : u1 < 512) (h2' : u2 < 512)
    (hb : ∀ i, i < 759 → frameAt i &&& lamMask u1 u2 ≠ 0) :
    ∃ c ∈ certs, lamMask (cu1 c) (cu2 c) = lamMask u1 u2 := by
  obtain ⟨a, b, ha0, hab, hbc, hb512, hL⟩ := canon_exists u1 u2 h1 h2 hne h1' h2'
  have hcan : canonP a b = true := by simp [canonP, ha0, hab, hbc]
  have hrow := table_ok a (by omega)
  unfold rowOK at hrow
  have h3 := List.all_eq_true.1 hrow b (List.mem_range.2 hb512)
  rw [hcan] at h3
  simp only [Bool.not_true, Bool.false_or] at h3
  obtain ⟨w, hw⟩ : ∃ w, w = (tabW a >>> (12 * b)) % 4096 := ⟨_, rfl⟩
  rw [← hw] at h3
  unfold entryOK3 at h3
  by_cases hw759 : w < 759
  · exfalso
    rw [if_pos hw759, beq_iff_eq, lamMask'_eq, hL] at h3
    exact hb _ hw759 h3
  · rw [if_neg hw759] at h3
    obtain ⟨c, hc, hc1, hc2⟩ := listed_mem a b (by omega) hb512 h3
    exact ⟨c, hc, by rw [hc1, hc2, hL]⟩

/-- every certified Lam really is blocking (meets every frame): the converse of block_complete -/
def blockChk (c : List Nat) : Bool :=
  (List.range 759).all (fun i => frameAt i &&& lamMask' (cu1 c) (cu2 c) != 0)

theorem all_app3 {a b : List (List Nat)} (ha : a.all blockChk = true) (hb : b.all blockChk = true) :
    (a ++ b).all blockChk = true := by
  rw [List.all_append, ha, hb]; rfl

