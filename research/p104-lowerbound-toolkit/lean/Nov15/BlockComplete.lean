namespace BlockComplete
open FrameCert

def colTab : List Nat := [2693757524304395857463084056575,11012714439538383722371697606687,2297612027131688139919253833696,6417331103353818979839167707169,7762033948357662581424501342274,10678306053213735288605612525700,254686196767249804836779462912,370723109138499335602051973640,19676977059188188168080071599120]

theorem colTab_eq : ∀ j, j < 9 → colTab.getD j 0 = colMask j := by decide +kernel

def parMask' (u : Nat) : Nat :=
  (List.range 9).foldl (fun a j => if u.testBit j then a ^^^ colTab.getD j 0 else a) 0

lemma foldl_congr_par (u : Nat) : ∀ (l : List Nat) (init : Nat), (∀ j ∈ l, j < 9) →
    l.foldl (fun a j => if u.testBit j then a ^^^ colTab.getD j 0 else a) init =
    l.foldl (fun a j => if u.testBit j then a ^^^ colMask j else a) init := by
  intro l
  induction l with
  | nil => intros; rfl
  | cons j js ih =>
    intro init h
    simp only [List.foldl_cons]
    rw [colTab_eq j (h j (by simp))]
    exact ih _ (fun k hk => h k (by simp [hk]))

lemma parMask'_eq (u : Nat) : parMask' u = parMask u :=
  foldl_congr_par u _ 0 (by intro j hj; simpa using hj)

/-- fast lamMask (precomputed column table) -/
def lamMask' (u1 u2 : Nat) : Nat := (2 ^ 104 - 1) ^^^ (parMask' u1 ||| parMask' u2)

lemma lamMask'_eq (u1 u2 : Nat) : lamMask' u1 u2 = lamMask u1 u2 := by
  simp only [lamMask', lamMask, parMask'_eq]

/-! ## linearity of parMask -/
def pmL (u : Nat) : List Nat → Nat
  | [] => 0
  | j :: js => (if u.testBit j then colMask j else 0) ^^^ pmL u js

lemma pm_foldl (u : Nat) : ∀ (l : List Nat) (init : Nat),
    l.foldl (fun a j => if u.testBit j then a ^^^ colMask j else a) init = init ^^^ pmL u l := by
  intro l
  induction l with
  | nil => intro init; simp [pmL]
  | cons j js ih =>
    intro init
    simp only [List.foldl_cons, pmL]
    by_cases hb : u.testBit j = true
    · simp only [hb, if_true]; rw [ih, Nat.xor_assoc]
    · have hb' : u.testBit j = false := by simpa using hb
      simp only [hb', Bool.false_eq_true, if_false, Nat.zero_xor]; rw [ih]

lemma parMask_eq_pmL (u : Nat) : parMask u = pmL u (List.range 9) := by
  unfold parMask; rw [pm_foldl]; simp

lemma xor_lc (a b c : Nat) : a ^^^ (b ^^^ c) = b ^^^ (a ^^^ c) := by
  rw [← Nat.xor_assoc, Nat.xor_comm a b, Nat.xor_assoc]

lemma xor_cc (a b : Nat) : a ^^^ (a ^^^ b) = b := by
  rw [← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]

lemma pmL_xor (x y : Nat) : ∀ l, pmL (x ^^^ y) l = pmL x l ^^^ pmL y l := by
  intro l
  induction l with
  | nil => simp [pmL]
  | cons j js ih =>
    simp only [pmL, ih, Nat.testBit_xor]
    cases x.testBit j <;> cases y.testBit j <;> simp [Nat.xor_assoc, xor_lc, xor_cc]

lemma parMask_xor (x y : Nat) : parMask (x ^^^ y) = parMask x ^^^ parMask y := by
  simp only [parMask_eq_pmL, pmL_xor]

lemma or_xor_left (p q : Nat) : p ||| (p ^^^ q) = p ||| q := by
  apply Nat.eq_of_testBit_eq; intro i
  simp only [Nat.testBit_or, Nat.testBit_xor]
  cases p.testBit i <;> cases q.testBit i <;> simp

/-- the section depends only on the span of the two normals -/
lemma lam_xor (a b : Nat) : lamMask a (a ^^^ b) = lamMask a b := by
  unfold lamMask; rw [parMask_xor, or_xor_left]

lemma lam_comm (a b : Nat) : lamMask a b = lamMask b a := by
  unfold lamMask; rw [Nat.or_comm]

/-- sorting a triple: some canonical pair (a<b<a^b) has the same section -/
lemma canon_exists (x y : Nat) (hx0 : 0 < x) (hy0 : 0 < y) (hxy : x ≠ y) (hx : x < 512) (hy : y < 512) :
    ∃ a b, 0 < a ∧ a < b ∧ b < (a ^^^ b) ∧ b < 512 ∧ lamMask a b = lamMask x y := by
  obtain ⟨z, hzdef⟩ : ∃ z, z = x ^^^ y := ⟨_, rfl⟩
  have hz : z < 512 := hzdef ▸ Nat.xor_lt_two_pow (n := 9) hx hy
  have e1 : y ^^^ x = z := by rw [hzdef, Nat.xor_comm]
  have e2 : x ^^^ z = y := by rw [hzdef, ← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
  have e3 : z ^^^ x = y := by rw [Nat.xor_comm]; exact e2
  have e4 : y ^^^ z = x := by rw [hzdef, Nat.xor_comm x y, ← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
  have e5 : z ^^^ y = x := by rw [Nat.xor_comm]; exact e4
  have hz0 : 0 < z := by
    rcases Nat.eq_zero_or_pos z with h | h
    · apply absurd _ hxy
      calc x = (x ^^^ y) ^^^ y := by rw [Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]
        _ = y := by rw [← hzdef, h, Nat.zero_xor]
    · exact h
  have hxz : x ≠ z := fun h => by
    have : y = 0 := by rw [← e2, ← h, Nat.xor_self]
    omega
  have hyz : y ≠ z := fun h => by
    have : x = 0 := by rw [← e4, ← h, Nat.xor_self]
    omega
  have L1 : lamMask x z = lamMask x y := by rw [hzdef]; exact lam_xor x y
  have L2 : lamMask y z = lamMask x y := by
    rw [lam_comm x y, ← lam_xor y x, e1]
  have L3 : lamMask z x = lamMask x y := by rw [lam_comm z x]; exact L1
  have L4 : lamMask z y = lamMask x y := by rw [lam_comm z y]; exact L2
  have L5 : lamMask y x = lamMask x y := (lam_comm x y).symm
  by_cases c1 : x < y ∧ y < z
  · exact ⟨x, y, hx0, c1.1, by rw [← hzdef]; exact c1.2, hy, rfl⟩
  by_cases c2 : x < z ∧ z < y
  · exact ⟨x, z, hx0, c2.1, by rw [e2]; exact c2.2, hz, L1⟩
  by_cases c3 : y < x ∧ x < z
  · exact ⟨y, x, hy0, c3.1, by rw [e1]; exact c3.2, hx, L5⟩
  by_cases c4 : y < z ∧ z < x
  · exact ⟨y, z, hy0, c4.1, by rw [e4]; exact c4.2, hz, L2⟩
  by_cases c5 : z < x ∧ x < y
  · exact ⟨z, x, hz0, c5.1, by rw [e3]; exact c5.2, hx, L3⟩
  have c6 : z < y ∧ y < x := by omega
  exact ⟨z, y, hz0, c6.1, by rw [e5]; exact c6.2, hy, L4⟩

/-- bitmap over keys a+512*b of the 1152 certified normal pairs -/
def listedBM : Nat := 


/-! ## the completeness check -/
def canonP (a b : Nat) : Bool := decide (0 < a) && decide (a < b) && decide (b < (a ^^^ b))

/-- w < 759: frame w is disjoint from Lam(a,b) (so (a,b) is NOT blocking);
w >= 759: (a,b) is a certified pair (bit of listedBM; listedBM = bitmap of certs, checked once). -/
def entryOK3 (a b w : Nat) : Bool :=
  if w < 759 then frameAt w &&& lamMask' a b == 0
  else listedBM.testBit (a + 512 * b)

/-- row a of the table: W packs 12-bit witnesses w(a,b) at bit 12*b, for every canonical b (a<b<a^b) -/
def rowOK (a W : Nat) : Bool :=
  (List.range 512).all (fun b => !(canonP a b) || entryOK3 a b ((W >>> (12 * b)) % 4096))

