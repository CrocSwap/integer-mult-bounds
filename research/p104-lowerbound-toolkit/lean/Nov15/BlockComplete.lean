theorem blockChk_sound (c : List Nat) (h : blockChk c = true) :
    ∀ i, i < 759 → frameAt i &&& lamMask (cu1 c) (cu2 c) ≠ 0 := by
  intro i hi
  have := List.all_eq_true.1 h i (List.mem_range.2 hi)
  rw [lamMask'_eq] at this
  simpa using this

theorem certs_blocking : ∀ c ∈ certs, ∀ i, i < 759 → frameAt i &&& lamMask (cu1 c) (cu2 c) ≠ 0 :=
  fun c hc => blockChk_sound c (List.all_eq_true.1 certs_blocking_chk c hc)

/-! ## wiring into the all-or-nothing law -/
/-- ALL-OR-NOTHING for ANY blocking 7-dim section given by normals (u1,u2): no list hypothesis left. -/
theorem all_or_nothing_blocking (u1 u2 : Nat) (h1 : 0 < u1) (h2 : 0 < u2) (hne : u1 ≠ u2)
    (h1' : u1 < 512) (h2' : u2 < 512)
    (hb : ∀ i, i < 759 → frameAt i &&& lamMask u1 u2 ≠ 0)
    (A B : Finset (Fin 104)) (H_FS4 : ind (A ∩ B) ∈ Fperp)
    (H_supp : A ⊆ lamSet (lamMask u1 u2)) :
    A ∩ B = ∅ ∨ (A = lamSet (lamMask u1 u2) ∧ lamSet (lamMask u1 u2) ⊆ B) := by
  obtain ⟨c, hc, hl⟩ := block_complete u1 u2 h1 h2 hne h1' h2' hb
  rw [← hl] at H_supp ⊢
  exact all_or_nothing_real c hc A B H_FS4 H_supp

/-- blocking 7-dim sections are EXACTLY the certified list (up to the span of the normals) -/
theorem blocking_iff_listed (u1 u2 : Nat) (h1 : 0 < u1) (h2 : 0 < u2) (hne : u1 ≠ u2)
    (h1' : u1 < 512) (h2' : u2 < 512) :
    (∀ i, i < 759 → frameAt i &&& lamMask u1 u2 ≠ 0) ↔
      ∃ c ∈ certs, lamMask (cu1 c) (cu2 c) = lamMask u1 u2 := by
  constructor
  · exact block_complete u1 u2 h1 h2 hne h1' h2' 
  · rintro ⟨c, hc, hl⟩
    rw [← hl]; exact certs_blocking c hc

/-! ## non-vacuity / tamper tests -/
theorem certs0_mem : certs.getD 0 [] ∈ certs := by
  have : 0 < certs.length := by rw [certs_length]; omega
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem this]
  simp

/-- the hypothesis of block_complete is satisfiable: certified Lam 0 meets every frame -/
theorem nv_blocking_instance : ∀ i, i < 759 → frameAt i &&& lamMask (cu1 (certs.getD 0 [])) (cu2 (certs.getD 0 [])) ≠ 0 :=
  certs_blocking _ certs0_mem

/-- ... and it is not always true: the section (1,2) is NOT blocking (a disjoint frame exists) -/
theorem nv_nonblocking_instance : ∃ i, i < 759 ∧ frameAt i &&& lamMask 1 2 = 0 := ⟨(tabW 1 >>> 24) % 4096, by decide +kernel, by decide +kernel⟩

/-- tamper 1: claiming frame 0 as a witness against a certified (blocking) pair is rejected -/
theorem tamper_listed_as_witness :
    entryOK3 (cu1 (certs.getD 0 [])) (cu2 (certs.getD 0 [])) 0 = false := by decide +kernel
/-- tamper 2: claiming the non-blocking pair (1,2) is listed is rejected -/
theorem tamper_unlisted_as_listed : entryOK3 1 2 759 = false := by decide +kernel
/-- tamper 3: row 1 with the (1,2) entry overwritten by the 'listed' flag fails the row check; the true row passes -/
theorem tamper_row_rejected :
    rowOK 1 (tabW 1 - ((tabW 1 >>> 24) % 4096) * 2 ^ 24 + 759 * 2 ^ 24) = false := by decide +kernel
theorem untampered_row_ok : rowOK 1 (tabW 1) = true := table_ok 1 (by omega)

theorem ind_empty_mem : ind (∅ : Finset (Fin 104)) ∈ Fperp := by
  intro m _
  simp [ind, dot]

/-- the all-or-nothing law at a certified Lam with the trivial row (A = B = empty): hypotheses satisfiable -/
theorem nv_all_or_nothing :
    (∅ : Finset (Fin 104)) ∩ ∅ = ∅ ∨
      ((∅ : Finset (Fin 104)) = lamSet (lamMask (cu1 (certs.getD 0 [])) (cu2 (certs.getD 0 []))) ∧
        lamSet (lamMask (cu1 (certs.getD 0 [])) (cu2 (certs.getD 0 []))) ⊆ ∅) :=
  all_or_nothing_blocking _ _ (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) nv_blocking_instance ∅ ∅
    (by simpa using ind_empty_mem) (Finset.empty_subset _)

