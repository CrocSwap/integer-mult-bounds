/-!
LINP104 (lane LEANLINEAR).  The P104 instance of LinFinal.linear_cost_ge.
Data (labels = rows 0..103 of C120 mod 2 in F2^8, B = E8 Gram mod 2, the 0/1 pattern Q from labels.txt)
are embedded as packed Nat masks (generated by gen_p104 from d56dir/mod4/{e8base.json,labels.txt}).
Certified in the kernel by `decide`:  B symmetric, B*Binv = 1, B(c_t,c_t)=0 on all labels,
Q(labels.txt) = 1 + B(c_t,c_s) on all 104^2 cells, and HNoQuadric: the 36 monomials (8 linear + 28 quadratic)
are independent on 36 chosen labels (an explicit left inverse), i.e. P0 is injective on the labels.
NOT certified in Lean: that these masks ARE the E8/labels.txt data (checked in python), and the decoder-side
hypothesis hMu (an invertible 8x8 principal M on 8 rows; follows from Kbar = B by Cauchy-Binet).
-/
open Matrix Finset LinCore LinFinal

namespace P104

open P104Data

def cm (t : ℕ) : Fin 8 → F2 := fun i => if (xMasks.getD t 0).testBit i then 1 else 0
def lab (t : Fin 104) : Fin 8 → F2 := cm t.1
def Bm : Matrix (Fin 8) (Fin 8) F2 := Matrix.of fun i j => if (bmMasks.getD i 0).testBit j then 1 else 0
def Binv : Matrix (Fin 8) (Fin 8) F2 := Matrix.of fun i j => if (binvMasks.getD i 0).testBit j then 1 else 0

lemma Bm_transpose : Bm.transpose = Bm := by decide +kernel
lemma Bm_symm : ∀ i j : Fin 8, Bm i j = Bm j i := by
  intro i j
  have := congrFun (congrFun Bm_transpose i) j
  simpa [Matrix.transpose_apply] using this.symm
lemma Binv_mul : Binv * Bm = 1 := by decide +kernel
lemma Bm_unit : IsUnit Bm.det := Matrix.isUnit_det_of_left_inverse Binv_mul

/-! ### Nat-bit arithmetic for the pattern checks (cheap in the kernel) -/
def bitN (m i : ℕ) : ℕ := if m.testBit i then 1 else 0

def sumTo (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => sumTo f k + f k

lemma sumTo_eq (f : ℕ → ℕ) (n : ℕ) : sumTo f n = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp [sumTo]
  | succ k ih => simp [sumTo, Finset.sum_range_succ, ih]

/-- B(x,y) = sum_j sum_i B_{ji} x_i y_j computed in Nat (kernel-friendly) -/
def nform (x y : ℕ) : ℕ :=
  sumTo (fun j => sumTo (fun i => bitN (bmMasks.getD j 0) i * bitN x i * bitN y j) 8) 8

def nformF (x y : ℕ) : ℕ :=
  ∑ j ∈ Finset.range 8, ∑ i ∈ Finset.range 8, bitN (bmMasks.getD j 0) i * bitN x i * bitN y j

lemma nform_eq (x y : ℕ) : nform x y = nformF x y := by
  simp only [nform, nformF, sumTo_eq]

lemma lab_bit (t : Fin 104) (i : Fin 8) : lab t i = (bitN (xMasks.getD t.1 0) i.1 : F2) := by
  unfold lab cm bitN; split_ifs <;> simp

lemma Bm_bit (j i : Fin 8) : Bm j i = (bitN (bmMasks.getD j.1 0) i.1 : F2) := by
  unfold Bm bitN; simp only [Matrix.of_apply]; split_ifs <;> simp

lemma form_nat (t s : Fin 104) :
    ((Bm *ᵥ lab t) ⬝ᵥ lab s : F2) = (nform (xMasks.getD t.1 0) (xMasks.getD s.1 0) : F2) := by
  rw [nform_eq]
  simp only [nformF, Matrix.mulVec, dotProduct, Nat.cast_sum, Nat.cast_mul, lab_bit, Bm_bit]
  rw [Finset.sum_range]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finset.sum_range, Finset.sum_mul]

def altAll : Bool := (List.range 104).all fun t => nform (xMasks.getD t 0) (xMasks.getD t 0) % 2 == 0

lemma altAll_true : altAll = true := by decide +kernel

lemma alt_nat (t : Fin 104) : nform (xMasks.getD t.1 0) (xMasks.getD t.1 0) % 2 = 0 := by
  have h := altAll_true
  unfold altAll at h
  rw [List.all_eq_true] at h
  have := h t.1 (List.mem_range.2 t.2)
  simpa using this

lemma Bm_alt : ∀ t : Fin 104, (Bm *ᵥ lab t) ⬝ᵥ lab t = 0 := by
  intro t
  rw [form_nat]
  have : (2 : ℕ) ∣ nform (xMasks.getD t.1 0) (xMasks.getD t.1 0) := Nat.dvd_of_mod_eq_zero (alt_nat t)
  exact (ZMod.natCast_eq_zero_iff _ 2).2 this

/-- the 0/1 pattern Q of labels.txt: parity of the overlap of the 9-bit masks -/
def Qlab (t s : Fin 104) : ℤ :=
  if ((List.range 9).filter (fun i => (labMasks.getD t.1 0 &&& labMasks.getD s.1 0).testBit i)).length % 2 = 1
  then 1 else 0

def patRow (t : ℕ) : Bool := (List.range 104).all fun s =>
  (((Qlab ⟨t % 104, Nat.mod_lt _ (by norm_num)⟩ ⟨s % 104, Nat.mod_lt _ (by norm_num)⟩ : ℤ) - 1 -
    (nform (xMasks.getD t 0) (xMasks.getD s 0) : ℤ)) % 2 == 0)


end P104
