/-
BudH (lane WORDSHAPEH, Nov 20).  The budget premise `hbud` of PriceH.rung_port_h / HCutGen.rung_port_net_h, PROVED in Lean for h = 7 and h = 8.
  hbud : kbar <= kappa -> 0 <= bud h md_h (fun d => d^(1-kappa))     (bud = c_1 - sum_{L=2}^{h-2} (E_L/D_L) c_L, c_L = 2 g_L - g_{L-1} - g_{L+1}).
  bud7 = 2 - 2^s + 3^s - 4^s - 5^s + 6^s ;  bud8 = (1/15)(33 - 16*2^s + 8*3^s - 10*4^s - 15*6^s + 15*7^s)   (s = 1 - kappa; checked by simp from md7/md8).
  Certificates: BudH7Cert.cert / BudH8Cert.cert (generated by cards/WILD/NOVEL/wordshapeh/genbud.py from UniBud's rpow machinery: convex piece-wise envelope on
  the grid, rational enclosures a/10^24 <= r^(1-t) <= (a+1)/10^24 by integer inequalities, decide+kernel):  -N*bud < 0 on [146/15625, 1].
  bud7_nonneg / bud8_nonneg : for 146/15625 <= kappa <= 1 (kappa < 1 for the 0^s = 0 step).
  hbud7 / hbud8 : the exact shape the rung theorems consume, for any kbar >= 146/15625 = .009344 (= the P104 ceiling .0093454 minus 1e-6).
  Non-vacuity: the numerical instances at kappa = .0093454 (margins .0087676 and .0052416 as exact rational lower bounds) -- budget never binding.
Kernel only.
-/
import Nov15.BudH7Cert
import Nov15.BudH8Cert
import Nov15.PriceHI7
import Nov15.PriceHI8

set_option linter.unusedVariables false

namespace BudH
open PriceH Finset

theorem zero_rpow_nat (κ : ℝ) (h1 : κ < 1) : (0 : ℝ) ^ (1 - κ) = 0 :=
  Real.zero_rpow (by linarith)

theorem bud7_eq (κ : ℝ) (h1 : κ < 1) :
    bud 7 md7 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) = -BudH7Cert.FceilBank (1 - κ) := by
  have hz := zero_rpow_nat κ h1
  have hI : Finset.Icc 2 (7 - 2) = {2, 3, 4, 5} := by decide
  unfold bud
  rw [hI]
  simp [Finset.sum_insert, ccg, md7, molD7, molE7, BudH7Cert.FceilBank, hz]
  norm_num
  ring

theorem bud8_eq (κ : ℝ) (h1 : κ < 1) :
    bud 8 md8 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) = -BudH8Cert.FceilBank (1 - κ) / 15 := by
  have hz := zero_rpow_nat κ h1
  have hI : Finset.Icc 2 (8 - 2) = {2, 3, 4, 5, 6} := by decide
  unfold bud
  rw [hI]
  simp [Finset.sum_insert, ccg, md8, molD8, molE8, BudH8Cert.FceilBank, hz]
  norm_num
  ring

theorem bud7_nonneg (κ : ℝ) (hk : (146 : ℝ) / 15625 ≤ κ) (h1 : κ < 1) :
    0 ≤ bud 7 md7 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) := by
  have := BudH7Cert.cert κ hk h1.le
  rw [bud7_eq κ h1]; linarith

theorem bud8_nonneg (κ : ℝ) (hk : (146 : ℝ) / 15625 ≤ κ) (h1 : κ < 1) :
    0 ≤ bud 8 md8 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) := by
  have := BudH8Cert.cert κ hk h1.le
  rw [bud8_eq κ h1]; linarith

/-- the premise of `rung_port_h7` / `rung_port_net_h7`, discharged for any kbar >= 146/15625. -/
theorem hbud7 (kbar : ℝ) (hkb : (146 : ℝ) / 15625 ≤ kbar) (κ : ℝ) (hκ1 : κ < 1) :
    kbar ≤ κ → 0 ≤ bud 7 md7 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) :=
  fun h => bud7_nonneg κ (le_trans hkb h) hκ1

theorem hbud8 (kbar : ℝ) (hkb : (146 : ℝ) / 15625 ≤ kbar) (κ : ℝ) (hκ1 : κ < 1) :
    kbar ≤ κ → 0 ≤ bud 8 md8 (fun d : ℕ => (d : ℝ) ^ (1 - κ)) :=
  fun h => bud8_nonneg κ (le_trans hkb h) hκ1

/-! ### Non-vacuity: the budgets are strictly positive at the P104 ceiling (not just >= 0). -/
theorem bud7_pos_at_ceiling : 0 < bud 7 md7 (fun d : ℕ => (d : ℝ) ^ (1 - (93454 : ℝ) / 10000000)) := by
  have hk : (146 : ℝ) / 15625 ≤ (93454 : ℝ) / 10000000 := by norm_num
  have := BudH7Cert.cert ((93454 : ℝ) / 10000000) hk (by norm_num)
  rw [bud7_eq _ (by norm_num)]; linarith

end BudH

#print axioms BudH.bud7_nonneg
#print axioms BudH.bud8_nonneg
#print axioms BudH.hbud7
#print axioms BudH.hbud8
