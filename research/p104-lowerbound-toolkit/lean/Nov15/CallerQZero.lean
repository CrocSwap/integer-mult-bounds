def C1W : CWord 4 3 := ⟨c1Evs, fun _ => 1, ![{1, 2}, {1, 2}, {0, 1, 2}, {0, 1, 2}]⟩

theorem c1_wf : WF C1W := by
  intro e he s t a b h
  subst h
  simp [C1W, c1Evs] at he
  rcases he with ⟨rfl, rfl, -, -⟩ | ⟨rfl, rfl, -, -⟩ | ⟨rfl, rfl, -, -⟩ <;> decide

theorem c1_legal : Legal C1W := by
  refine ⟨c1_wf, ?_⟩
  intro S _ _ q i D hq hi
  show pre q i D c1Evs 69 = target q D C1W
  rw [c1_pre q i D hq hi]
  ext r c; fin_cases r <;> fin_cases c <;> simp [ck69, target, C1W, qp, Matrix.diagonal] <;> ring

end final

section nonvac
open CallerAsm Finset
theorem c1_odd : ∀ r, C1W.ex r % 2 = 1 := by intro r; fin_cases r <;> decide
theorem c1_deg : ∀ r, 2 ≤ (C1W.mask r).card := by intro r; fin_cases r <;> decide
theorem c1_card : Fintype.card (Iota C1W) = 6 := by
  rw [Fintype.card_subtype]
  decide +kernel
def c1J : JB C1W where
  pos := ![1, 20, 43]
  mono := by intro a b h; fin_cases a <;> fin_cases b <;> simp_all <;> decide
  lt := fun s => by fin_cases s <;> decide
  u := ![2, 0, 0]
  v := ![3, 1, 1]
  a := ![(-1), (-1), (-1)]
  b := ![(1/2), (2), (9/4)]
  a0 := fun s => by fin_cases s <;> norm_num
  b0 := fun s => by fin_cases s <;> norm_num
  uv := fun s => by fin_cases s <;> decide
  h0 := fun s => by fin_cases s <;> rfl
  h1 := fun s => by fin_cases s <;> rfl
  h2 := fun s => by fin_cases s <;> rfl

/-- C1 discharges every hypothesis of `word_hp_B` except the stage K-block one (`hlam`, [C exact]: dets 2, -4, -5). -/
theorem c1_hp (hlam : ∀ s, IsUnit ((CallerSign.sgK (βw C1W) (CallerSign.sgG (Aw C1W Complex.I) (Bw C1W Complex.I))).submatrix
      (c1J.col s) (c1J.col s)).det) : cHat C1W ≤ CallerHP.HPr 3 :=
  word_hp_B c1_legal c1J c1_odd (le_refl 3) c1_card (by rw [c1_card]) hlam c1_deg

theorem c1_nonvac : Legal C1W ∧ (∀ r, C1W.ex r % 2 = 1) ∧ Fintype.card (Iota C1W) = 2 * 3 ∧ 4 + 2 = Fintype.card (Iota C1W)
    ∧ ∀ r, 2 ≤ (C1W.mask r).card :=
  ⟨c1_legal, c1_odd, c1_card, by rw [c1_card], c1_deg⟩
end nonvac
