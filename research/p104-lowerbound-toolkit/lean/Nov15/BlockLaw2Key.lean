/-- all 6 ordered pairs of every certified line, split into 16 pieces of 16384 bits -/
def bmL : List Nat := [
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ]

/-- cheap bit test on the split bitmap -/
def bmTest (k : Nat) : Bool := (bmL.getD (k / 16384) 0).testBit (k % 16384)

/-- soundness direction only: all 6 ordered pairs of every certified line have their bit set -/
def certBM (c : List Nat) : Bool :=
  let a := cu1 c
  let b := cu2 c
  bmTest (a + 512 * b) && bmTest (b + 512 * a) && bmTest (a + 512 * (a ^^^ b)) &&
  bmTest ((a ^^^ b) + 512 * a) && bmTest (b + 512 * (a ^^^ b)) && bmTest ((a ^^^ b) + 512 * b)

lemma canon_exists2 (x y : Nat) (hx0 : 0 < x) (hy0 : 0 < y) (hxy : x ≠ y) (hx : x < 512) (hy : y < 512) :
    ∃ a b, 0 < a ∧ a < b ∧ b < (a ^^^ b) ∧ b < 512 ∧ lamMask a b = lamMask x y ∧
      ((x = a ∧ y = b) ∨ (x = a ∧ y = a ^^^ b) ∨ (x = b ∧ y = a) ∨ (x = a ^^^ b ∧ y = a) ∨
       (x = b ∧ y = a ^^^ b) ∨ (x = a ^^^ b ∧ y = b)) := by
  obtain ⟨z, hzdef⟩ : ∃ z, z = x ^^^ y := ⟨_, rfl⟩
  have hz : z < 512 := hzdef ▸ Nat.xor_lt_two_pow (n := 9) hx hy
  have e1 : y ^^^ x = z := by rw [hzdef, Nat.xor_comm]
  have e2 : x ^^^ z = y := by rw [hzdef, ← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
  have e3 : z ^^^ x = y := by rw [Nat.xor_comm]; exact e2
  have e4 : y ^^^ z = x := by rw [hzdef, Nat.xor_comm x y, ← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
  have e5 : z ^^^ y = x := by rw [Nat.xor_comm]; exact e4
  have hz0 : 0 < z := by
    rcases Nat.eq_zero_or_pos z with h | h
    · apply absurd _ hxy
      calc x = (x ^^^ y) ^^^ y := by rw [Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]
        _ = y := by rw [← hzdef, h, Nat.zero_xor]
    · exact h
  have hxz : x ≠ z := fun h => by
    have : y = 0 := by rw [← e2, ← h, Nat.xor_self]
    omega
  have hyz : y ≠ z := fun h => by
    have : x = 0 := by rw [← e4, ← h, Nat.xor_self]
    omega
  have L1 : lamMask x z = lamMask x y := by rw [hzdef]; exact lam_xor x y
  have L2 : lamMask y z = lamMask x y := by
    rw [lam_comm x y, ← lam_xor y x, e1]
  have L3 : lamMask z x = lamMask x y := by rw [lam_comm z x]; exact L1
  have L4 : lamMask z y = lamMask x y := by rw [lam_comm z y]; exact L2
  have L5 : lamMask y x = lamMask x y := (lam_comm x y).symm
  by_cases c1 : x < y ∧ y < z
  · exact ⟨x, y, hx0, c1.1, by rw [← hzdef]; exact c1.2, hy, rfl, Or.inl ⟨rfl, rfl⟩⟩
  by_cases c2 : x < z ∧ z < y
  · exact ⟨x, z, hx0, c2.1, by rw [e2]; exact c2.2, hz, L1, Or.inr (Or.inl ⟨rfl, by rw [e2]⟩)⟩
  by_cases c3 : y < x ∧ x < z
  · exact ⟨y, x, hy0, c3.1, by rw [e1]; exact c3.2, hx, L5, Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))⟩
  by_cases c4 : y < z ∧ z < x
  · exact ⟨y, z, hy0, c4.1, by rw [e4]; exact c4.2, hz, L2,
      Or.inr (Or.inr (Or.inr (Or.inl ⟨by rw [e4], rfl⟩)))⟩
  by_cases c5 : z < x ∧ x < y
  · exact ⟨z, x, hz0, c5.1, by rw [e3]; exact c5.2, hx, L3,
      Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨rfl, by rw [e3]⟩))))⟩
  have c6 : z < y ∧ y < x := by omega
  exact ⟨z, y, hz0, c6.1, by rw [e5]; exact c6.2, hy, L4,
    Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨by rw [e5], rfl⟩))))⟩

theorem all_appB {a b : List (List Nat)} (ha : a.all certBM = true) (hb : b.all certBM = true) :
    (a ++ b).all certBM = true := by
  rw [List.all_append, ha, hb]; rfl

