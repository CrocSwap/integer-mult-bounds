/-- a blocking 7-dim section (x,y) has its ordered pair in the split bitmap -/
theorem blocking_key (x y : Nat) (h1 : 0 < x) (h2 : 0 < y) (hne : x ≠ y) (h1' : x < 512) (h2' : y < 512)
    (hb : ∀ i, i < 759 → frameAt i &&& lamMask x y ≠ 0) :
    bmTest (x + 512 * y) = true := by
  obtain ⟨a, b, ha0, hab, hbc, hb512, hL, hxy⟩ := canon_exists2 x y h1 h2 hne h1' h2'
  have hcan : canonP a b = true := by simp [canonP, ha0, hab, hbc]
  have hrow := table_ok a (by omega)
  unfold rowOK at hrow
  have h3 := List.all_eq_true.1 hrow b (List.mem_range.2 hb512)
  rw [hcan] at h3
  simp only [Bool.not_true, Bool.false_or] at h3
  obtain ⟨w, hw⟩ : ∃ w, w = (tabW a >>> (12 * b)) % 4096 := ⟨_, rfl⟩
  rw [← hw] at h3
  unfold entryOK3 at h3
  by_cases hw759 : w < 759
  · exfalso
    rw [if_pos hw759, beq_iff_eq, lamMask'_eq, hL] at h3
    exact hb _ hw759 h3
  · rw [if_neg hw759] at h3
    obtain ⟨c, hc, hc1, hc2⟩ := listed_mem a b (by omega) hb512 h3
    have hcb := List.all_eq_true.1 certs_bm c hc
    simp only [certBM, hc1, hc2, Bool.and_eq_true] at hcb
    obtain ⟨⟨⟨⟨⟨k1, k2⟩, k3⟩, k4⟩, k5⟩, k6⟩ := hcb
    rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact k1
    · exact k3
    · exact k2
    · exact k4
    · exact k5
    · exact k6

def lineBad (x y : Nat) : Bool :=
  decide (0 < x) && decide (0 < y) && decide (x ≠ y) && decide (x < 512) && decide (y < 512) &&
    !(bmTest (x + 512 * y))

/-- the 6 lines of the plane spanned by a, b, u other than (a,b) (which is certified listed) -/
def planeOK (a b u : Nat) : Bool :=
  (u == 0 || u == a || u == b || u == (a ^^^ b)) ||
  lineBad a u || lineBad b u || lineBad (a ^^^ b) u ||
  lineBad a (b ^^^ u) || lineBad b (a ^^^ u) || lineBad (a ^^^ b) (a ^^^ u)

def planeChk (c : List Nat) : Bool := (List.range 512).all (planeOK (cu1 c) (cu2 c))

theorem all_appP {a b : List (List Nat)} (ha : a.all planeChk = true) (hb : b.all planeChk = true) :
    (a ++ b).all planeChk = true := by
  rw [List.all_append, ha, hb]; rfl

