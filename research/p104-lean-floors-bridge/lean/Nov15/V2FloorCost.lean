/-
V2FloorCost: the edge weights of V2-FLOOR and check.c's integer thresholds (lane LEAN-NEXT20, Nov 16). Generated by
cards/WILD/LEANCERT/v2floor/gencost.py. w(a,b) = θ·Wb + (1−θ)·Wa with f(r) = r ln r (FLOOR.md / check.c), and
T(a,b) = floor(2^30 (w − 1e−9)) as computed in long double by check.c (tt.c reproduces the table). Proved here:
T(a,b) ≤ 2^30·w(a,b) for all 1 ≤ a < b ≤ 8, for the joint (θ = 22257/2^19) and the β (θ = 1) certificates, from
|Σ_{i<16} x^{i+1}/(i+1) + log(1 − x)| ≤ x^17/(1 − x) at x = 1/9, 1/16, 1/25, 1/50 (Mathlib `abs_log_sub_add_sum_range_le`).
-/
import Mathlib.Analysis.SpecialFunctions.Log.Deriv
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Tactic.IntervalCases

namespace V2Floor
open Real Finset

noncomputable def flog (r : ℕ) : ℝ := (r : ℝ) * Real.log r
noncomputable def B1 : ℝ := flog 9 - flog 8
/-- β cost of an edge between dims a < b, with the JB line term. -/
noncomputable def Wb (a b : ℕ) : ℝ := flog (9 - a) - flog (9 - b) - flog (b - a) + (if a = 1 then B1 else 0)
/-- α cost, with the JB hyperplane term. -/
noncomputable def Wa (a b : ℕ) : ℝ := flog b - flog a - flog (b - a) + (if b = 8 then B1 else 0)
noncomputable def wt (θ : ℝ) (a b : ℕ) : ℝ := θ * Wb a b + (1 - θ) * Wa a b

theorem log4 : Real.log 4 = 2 * Real.log 2 := by
  rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; try norm_num
theorem log6 : Real.log 6 = Real.log 2 + Real.log 3 := by
  rw [show (6 : ℝ) = 2 * 3 by norm_num, Real.log_mul (by norm_num) (by norm_num)]
theorem log8 : Real.log 8 = 3 * Real.log 2 := by
  rw [show (8 : ℝ) = 2 ^ 3 by norm_num, Real.log_pow]; try norm_num
theorem log9 : Real.log 9 = 2 * Real.log 3 := by
  rw [show (9 : ℝ) = 3 ^ 2 by norm_num, Real.log_pow]; try norm_num


theorem idA : Real.log ((8 : ℝ) / 9) = 3 * Real.log 2 - 2 * Real.log 3 := by
  rw [Real.log_div (by norm_num) (by norm_num), log8, log9]; try ring

theorem sumA : (∑ i ∈ range 16, ((1 : ℝ) / 9) ^ (i + 1) / (i + 1)) = 3495561557096165099 / 29677971344651085456 := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]; norm_num

theorem bndA : |(3495561557096165099 / 29677971344651085456 : ℝ) + (3 * Real.log 2 - 2 * Real.log 3)| ≤ 1 / 14824161510814728 := by
  have h := Real.abs_log_sub_add_sum_range_le (x := (1 : ℝ) / 9) (by rw [abs_of_pos (by norm_num)]; norm_num) 16
  rw [sumA, show (1 : ℝ) - 1 / 9 = (8 : ℝ) / 9 by norm_num, idA, abs_of_pos (show (0 : ℝ) < 1 / 9 by norm_num)] at h
  refine le_trans h (le_of_eq ?_); norm_num

theorem idB : Real.log ((15 : ℝ) / 16) = Real.log 3 + Real.log 5 - 4 * Real.log 2 := by
  rw [Real.log_div (by norm_num) (by norm_num), show (15 : ℝ) = 3 * 5 by norm_num, Real.log_mul (by norm_num) (by norm_num),
    show (16 : ℝ) = 2 ^ 4 by norm_num, Real.log_pow]; push_cast; ring

theorem sumB : (∑ i ∈ range 16, ((1 : ℝ) / 16) ^ (i + 1) / (i + 1)) = 858035597690008879399669 / 13294937388803948040683520 := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]; norm_num

theorem bndB : |(858035597690008879399669 / 13294937388803948040683520 : ℝ) + (Real.log 3 + Real.log 5 - 4 * Real.log 2)| ≤ 1 / 276701161105643274240 := by
  have h := Real.abs_log_sub_add_sum_range_le (x := (1 : ℝ) / 16) (by rw [abs_of_pos (by norm_num)]; norm_num) 16
  rw [sumB, show (1 : ℝ) - 1 / 16 = (15 : ℝ) / 16 by norm_num, idB, abs_of_pos (show (0 : ℝ) < 1 / 16 by norm_num)] at h
  refine le_trans h (le_of_eq ?_); norm_num

theorem idC : Real.log ((24 : ℝ) / 25) = 3 * Real.log 2 + Real.log 3 - 2 * Real.log 5 := by
  rw [Real.log_div (by norm_num) (by norm_num), show (24 : ℝ) = 2 ^ 3 * 3 by norm_num, Real.log_mul (by norm_num) (by norm_num),
    Real.log_pow, show (25 : ℝ) = 5 ^ 2 by norm_num, Real.log_pow]; push_cast; ring

theorem sumC : (∑ i ∈ range 16, ((1 : ℝ) / 25) ^ (i + 1) / (i + 1)) = 137003268537289821415090499 / 3356114029884338378906250000 := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]; norm_num

theorem bndC : |(137003268537289821415090499 / 3356114029884338378906250000 : ℝ) + (3 * Real.log 2 + Real.log 3 - 2 * Real.log 5)| ≤ 1 / 558793544769287109375000 := by
  have h := Real.abs_log_sub_add_sum_range_le (x := (1 : ℝ) / 25) (by rw [abs_of_pos (by norm_num)]; norm_num) 16
  rw [sumC, show (1 : ℝ) - 1 / 25 = (24 : ℝ) / 25 by norm_num, idC, abs_of_pos (show (0 : ℝ) < 1 / 25 by norm_num)] at h
  refine le_trans h (le_of_eq ?_); norm_num

theorem idD : Real.log ((49 : ℝ) / 50) = 2 * Real.log 7 - Real.log 2 - 2 * Real.log 5 := by
  rw [Real.log_div (by norm_num) (by norm_num), show (49 : ℝ) = 7 ^ 2 by norm_num, Real.log_pow,
    show (50 : ℝ) = 2 * 5 ^ 2 by norm_num, Real.log_mul (by norm_num) (by norm_num), Real.log_pow]; push_cast; ring

theorem sumD : (∑ i ∈ range 16, ((1 : ℝ) / 50) ^ (i + 1) / (i + 1)) = 4443510503504216570021487229489 / 219946289062500000000000000000000 := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]; norm_num

theorem bndD : |(4443510503504216570021487229489 / 219946289062500000000000000000000 : ℝ) + (2 * Real.log 7 - Real.log 2 - 2 * Real.log 5)| ≤ 1 / 74768066406250000000000000000 := by
  have h := Real.abs_log_sub_add_sum_range_le (x := (1 : ℝ) / 50) (by rw [abs_of_pos (by norm_num)]; norm_num) 16
  rw [sumD, show (1 : ℝ) - 1 / 50 = (49 : ℝ) / 50 by norm_num, idD, abs_of_pos (show (0 : ℝ) < 1 / 50 by norm_num)] at h
  refine le_trans h (le_of_eq ?_); norm_num


/-- flog r in terms of log 2, 3, 5, 7. -/
theorem flog_vals : flog 1 = 0 ∧ flog 2 = 2 * Real.log 2 ∧ flog 3 = 3 * Real.log 3 ∧ flog 4 = 8 * Real.log 2 ∧
    flog 5 = 5 * Real.log 5 ∧ flog 6 = 6 * Real.log 2 + 6 * Real.log 3 ∧ flog 7 = 7 * Real.log 7 ∧
    flog 8 = 24 * Real.log 2 ∧ flog 9 = 18 * Real.log 3 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    (simp only [flog]; push_cast; (try simp only [log4, log6, log8, log9, Real.log_one, mul_zero]); try (first | ring | simp | (simp; ring)))


