    {
      "argv": ["{python}", "-I", "-W", "error", "-B", "{package}/test_verify.py"],
      "timeout_seconds": 60,
      "checks": "Six behavioral groups including source corruption, actual-prefix mutants and helper/trace omissions"
    },
    {
      "argv": ["{python}", "-I", "-O", "-W", "error", "-B", "{package}/test_verify.py"],
      "timeout_seconds": 60,
      "checks": "All collision and rejection contracts remain active with Python assertions disabled"
    }
  ]
