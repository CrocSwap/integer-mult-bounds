-def quarter_turn(value, quadrant):
-    real, imag = value
-    if quadrant == 0:
-        return value
-    if quadrant == 1:
-        return -imag, real
-    if quadrant == 2:
-        return -real, -imag
-    return imag, -real
-
-
-def observe_phase(value, meter):
-    if meter is not None:
-        meter.phase_peak_l1 = max(meter.phase_peak_l1, abs(value[0])+abs(value[1]))
-
