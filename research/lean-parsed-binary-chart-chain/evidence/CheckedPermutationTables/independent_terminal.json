    "complete_joined_type": "@CurrentMain.CheckedPermutationTables.decoded_chart_sound : ∀ {n : ℕ}\n  (forward backward : CurrentMain.SelectedSourceSyntax.Value) (columns : Fin n → ℕ)\n  (updateVector coefficients : CurrentMain.CheckedBinaryChart.Address n)\n  (c : CurrentMain.CheckedBinaryChart.Candidate n),\n  CurrentMain.CheckedPermutationTables.decodeChart n forward backward columns updateVector coefficients = some c →\n    ∀ (hcheck : CurrentMain.CheckedBinaryChart.check c = true),\n      (∃ t,\n          CurrentMain.CheckedPermutationTables.decodeCertificate n forward backward = some t ∧\n            CurrentMain.CheckedPermutationTables.check t = true ∧\n              CurrentMain.CheckedPermutationTables.tableValue t.forward = forward ∧\n                CurrentMain.CheckedPermutationTables.tableValue t.backward = backward ∧\n                  (∀ (i : Fin n), c.permutation i = CurrentMain.CheckedPermutationTables.tableAt t.forward i) ∧\n                    ∀ (i : Fin n),\n                      (Equiv.symm c.permutation) i = CurrentMain.CheckedPermutationTables.tableAt t.backward i) ∧\n        c.columns = columns ∧\n          c.updateVector = updateVector ∧\n            c.coefficients = coefficients ∧\n              CurrentMain.CheckedBinaryChart.sourceLinear c = ↑(CurrentMain.CheckedBinaryChart.checkedEquiv c hcheck) ∧\n                (∀ (x : CurrentMain.CheckedBinaryChart.Address n),\n                    CurrentMain.CheckedBinaryChart.inverseAddress c\n                        ((CurrentMain.CheckedBinaryChart.sourceLinear c) x) =\n                      x) ∧\n                  ∀ (x : CurrentMain.CheckedBinaryChart.Address n),\n                    (CurrentMain.CheckedBinaryChart.sourceLinear c)\n                        (CurrentMain.CheckedBinaryChart.inverseAddress c x) =\n                      x"
  },
