{
  "commands": [
    {
      "argv": [
        "python3",
        "-I",
        "-W",
        "error",
        "-B",
        "routes.py"
      ],
      "timeout_seconds": 120,
      "writes": [
        "DESCRIPTORS.json.gz",
        "EXAMPLES.json"
      ]
    },
    {
      "argv": [
        "python3",
        "-I",
        "-W",
        "error",
        "-B",
        "check.py",
        "--output",
        "EVIDENCE.json"
      ],
      "timeout_seconds": 120,
      "writes": [
        "EVIDENCE.json"
      ]
    },
    {
      "argv": [
        "python3",
        "-I",
        "-O",
        "-W",
        "error",
        "-B",
        "check.py",
        "--output",
        "EVIDENCE-OPTIMIZED.json"
      ],
      "timeout_seconds": 120,
      "writes": [
        "EVIDENCE-OPTIMIZED.json"
      ]
    }
  ],
  "external_dependencies": "Python standard library only",
  "run_sequentially": true,
  "scope": "constructor and exact finite verifier; not a physical tape run",
  "working_directory": "package root"
}
