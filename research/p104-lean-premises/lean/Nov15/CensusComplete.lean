/-
LEAN-PREM5, Nov 17. Census completeness for #7630 (p104-reroutes-on7623), kernel-checked on the
extracted data (Nov15/CensusData.lean, generated by Nov15/censusgen/gen.py). See CensusComplete.md.
Subset checks run on sorted key lists by a linear merge; soundness of each check holds for ANY input
lists (sortedness only affects whether the check returns true, which `decide` verifies).
-/
import Nov15.NativeColumns
import Nov15.CensusData

namespace CensusComplete
open CensusData

abbrev Pr := Nat × Nat

def key (p : Pr) : Nat := p.1 * 2048 + p.2
def keys (l : List Pr) : List Nat := l.map key

def smallB (l : List Pr) : Bool := l.all (fun p => decide (p.1 < 2048 ∧ p.2 < 2048))

/-- sorted merge (fuel-bounded) -/
def mergeK : Nat → List Nat → List Nat → List Nat
  | 0, a, b => a ++ b
  | _, [], b => b
  | _, a, [] => a
  | f + 1, x :: xs, y :: ys => if x < y then x :: mergeK f xs (y :: ys) else y :: mergeK f (x :: xs) ys

/-- subset check by linear merge-walk -/
def subK : Nat → List Nat → List Nat → Bool
  | _, [], _ => true
  | _, _ :: _, [] => false
  | 0, _, _ => false
  | f + 1, x :: xs, y :: ys => if x == y then subK f xs (y :: ys) else if x < y then false else subK f (x :: xs) ys

theorem mergeK_sound : ∀ (f : Nat) (a b : List Nat) {x : Nat}, x ∈ mergeK f a b → x ∈ a ∨ x ∈ b := by
  intro f
  induction f with
  | zero => intro a b x h; simpa [mergeK] using h
  | succ f ih =>
    intro a b x h
    cases a with
    | nil => simpa [mergeK] using h
    | cons u us =>
      cases b with
      | nil => exact Or.inl (by simpa [mergeK] using h)
      | cons v vs =>
        simp only [mergeK] at h
        split at h
        · rcases List.mem_cons.mp h with rfl | h
          · simp
          · rcases ih _ _ h with h | h <;> simp_all
        · rcases List.mem_cons.mp h with rfl | h
          · simp
          · rcases ih _ _ h with h | h <;> simp_all

theorem subK_sound : ∀ (f : Nat) (a b : List Nat), subK f a b = true → ∀ x ∈ a, x ∈ b := by
  intro f
  induction f with
  | zero =>
    intro a b h x hx
    cases a with
    | nil => simp at hx
    | cons u us => cases b <;> simp [subK] at h
  | succ f ih =>
    intro a b h x hx
    cases a with
    | nil => simp at hx
    | cons u us =>
      cases b with
      | nil => simp [subK] at h
      | cons v vs =>
        simp only [subK] at h
        split at h
        · rename_i huv
          have huv' : u = v := by simpa using huv
          subst huv'
          rcases List.mem_cons.mp hx with rfl | hx
          · simp
          · exact ih _ _ h x hx
        · split at h
          · simp at h
          · have := ih _ _ h x hx
            exact List.mem_cons_of_mem _ this

theorem key_inj {p q : Pr} (hp : p.2 < 2048) (hq : q.2 < 2048) (h : key p = key q) : p = q := by
  obtain ⟨a, b⟩ := p; obtain ⟨c, d⟩ := q
  simp only [key] at h hp hq ⊢
  have : a = c := by omega
  subst this
  have : b = d := by omega
  subst this; rfl

theorem small_mem {l : List Pr} (h : smallB l = true) {p : Pr} (hp : p ∈ l) : p.1 < 2048 ∧ p.2 < 2048 := by
  simp only [smallB, List.all_eq_true, decide_eq_true_eq] at h
  exact h p hp

theorem mem_keys_iff {m : List Pr} (hm : smallB m = true) {p : Pr} (hp : p.2 < 2048) :
    key p ∈ keys m ↔ p ∈ m := by
  constructor
  · intro h
    obtain ⟨q, hq, e⟩ := List.mem_map.mp h
    exact (key_inj (small_mem hm hq).2 hp e) ▸ hq
  · intro h; exact List.mem_map.mpr ⟨p, h, rfl⟩

/-- a Boolean `subK` success gives pair-level inclusion -/
theorem subset_of_subK {l m : List Pr} (hl : smallB l = true) (hm : smallB m = true) {f : Nat}
    (h : subK f (keys l) (keys m) = true) : ∀ p ∈ l, p ∈ m := fun p hp =>
  (mem_keys_iff hm (small_mem hl hp).2).mp (subK_sound f _ _ h _ (List.mem_map.mpr ⟨p, hp, rfl⟩))

theorem small_census : smallB census = true := by decide +kernel
theorem small_census7623 : smallB census7623 = true := by decide +kernel
theorem small_usedW : smallB usedW = true := by decide +kernel
theorem small_usedB : smallB usedB = true := by decide +kernel
theorem small_newPairs : smallB newPairs = true := by decide +kernel

theorem census_length : census.length = 981 := by decide +kernel
theorem census7623_length : census7623.length = 964 := by decide +kernel
theorem usedW_length : usedW.length = 3024 := by decide +kernel
theorem usedB_length : usedB.length = 3021 := by decide +kernel

/-- the census only grew: none of #7623's 964 pairs dropped. -/
theorem census_extends : ∀ p ∈ census7623, p ∈ census :=
  subset_of_subK small_census7623 small_census (f := 5000) (by decide +kernel)

/-- Delta-census completeness (the true statement): used(#7630) ⊆ used(#7623) ∪ census.
This is check.py's `move_pairs(W) - move_pairs(B) <= allp`, as a kernel fact on the extracted data. -/
theorem used_subset_base_or_census : ∀ p ∈ usedW, p ∈ usedB ∨ p ∈ census := by
  have h : subK 20000 (keys usedW) (mergeK 20000 (keys usedB) (keys census)) = true := by decide +kernel
  intro p hp
  have hx := subK_sound _ _ _ h (key p) (List.mem_map.mpr ⟨p, hp, rfl⟩)
  have hp2 := (small_mem small_usedW hp).2
  rcases mergeK_sound _ _ _ hx with h1 | h1
  · exact Or.inl ((mem_keys_iff small_usedB hp2).mp h1)
  · exact Or.inr ((mem_keys_iff small_census hp2).mp h1)

theorem new_in_census : ∀ p ∈ usedW, p ∉ usedB → p ∈ census := fun p hp hb =>
  (used_subset_base_or_census p hp).resolve_left hb

/-- the pairs that stop being used (leave #7623's word) are also in the census. -/
theorem leaving_in_census : ∀ p ∈ usedB, p ∉ usedW → p ∈ census := by
  have h : subK 20000 (keys usedB) (mergeK 20000 (keys usedW) (keys census)) = true := by decide +kernel
  intro p hp hw
  have hx := subK_sound _ _ _ h (key p) (List.mem_map.mpr ⟨p, hp, rfl⟩)
  have hp2 := (small_mem small_usedB hp).2
  rcases mergeK_sound _ _ _ hx with h1 | h1
  · exact absurd ((mem_keys_iff small_usedW hp2).mp h1) hw
  · exact (mem_keys_iff small_census hp2).mp h1

/-- the five new MOVE pairs (README: all strictly nested), in the census, used now, not used by #7623. -/
theorem newPairs_facts : ∀ p ∈ newPairs, p ∈ usedW ∧ p ∉ usedB ∧ p ∈ census := by decide +kernel
theorem leavePairs_facts : ∀ p ∈ leavePairs, p ∈ usedB ∧ p ∉ usedW ∧ p ∈ census := by decide +kernel
theorem newPairs_length : newPairs.length = 5 := by decide +kernel
theorem leavePairs_length : leavePairs.length = 2 := by decide +kernel

/-- CORRECTION to LEAN-PREM3's premise: the literal "every used MOVE pair lies in the 981-pair
census" is FALSE (witness: the first used pair outside the census; generator count: 2143 of 3024). -/
def witness : Pr := (0, 249)
theorem witness_used : witness ∈ usedW := by decide +kernel
theorem witness_outside : witness ∉ census := by decide +kernel
theorem used_not_subset_census : ¬ (∀ p ∈ usedW, p ∈ census) := fun h =>
  witness_outside (h _ witness_used)

/-- Composition with `NativeColumns.census_coverage`: given the per-pair column checks on the census
(check.py `columns1/2`, hypothesis) and correctness of the pairs #7623's word already used
(inherited, hypothesis), every pair used by #7630's word is correct. -/
theorem all_used_correct (Correct : Pr → Prop)
    (hcensus : ∀ p ∈ census, Correct p) (hbase : ∀ p ∈ usedB, Correct p) :
    ∀ p ∈ usedW, Correct p := by
  have := NativeColumns.census_coverage
    (used := {p | p ∈ usedW}) (census := {p | p ∈ census ∨ p ∈ usedB}) Correct
    (fun p hp => (used_subset_base_or_census p hp).symm) (fun p hp => hp.elim (hcensus p) (hbase p))
  exact fun p hp => this p hp

/-- Without `hbase` only census pairs are covered. -/
theorem census_only (Correct : Pr → Prop) (hcensus : ∀ p ∈ census, Correct p) :
    ∀ p ∈ usedW, p ∈ census → Correct p := fun p _ hp => hcensus p hp

end CensusComplete

#print axioms CensusComplete.used_subset_base_or_census
#print axioms CensusComplete.leaving_in_census
#print axioms CensusComplete.used_not_subset_census
#print axioms CensusComplete.all_used_correct
