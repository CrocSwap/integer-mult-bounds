/-- forced helper stops at one chart: max 0 (rk - ab - oa) (R1 with Y in the quotient) -/
def forced (r : Row) : ℕ := r.rk - r.ab - r.oa
/-- need = rk - |Y|, |Y| = ab - kp -/
def need (r : Row) : ℕ := r.rk - (r.ab - r.kp)

theorem len : rows.length = 978 := by decide +kernel
/-- the 748 forced stops -/
theorem forced_sum : (rows.map forced).sum = 748 := by decide +kernel
/-- by chart dimension 0..8 -/
theorem forced_by_dim : (List.range 9).map (fun d => ((rows.filter fun r => r.dm == d).map forced).sum)
    = [0, 122, 150, 109, 40, 29, 94, 96, 108] := by decide +kernel
/-- R5's own form: need - kp - oa gives the same 748 -/
theorem forced_sum_need : (rows.map fun r => need r - r.kp - r.oa).sum = 748 := by decide +kernel
/-- feasibility control (0 violations): kp <= ab, |Y| <= rk, need <= sigma, and the two forms agree chartwise -/
def ctl (r : Row) : Bool :=
  decide (r.kp ≤ r.ab ∧ r.ab - r.kp ≤ r.rk ∧ need r ≤ r.sg ∧ forced r = need r - r.kp - r.oa)
theorem control : rows.all ctl = true := by decide +kernel
theorem sums : (rows.map Row.ab).sum = 2074 ∧ (rows.map Row.oa).sum = 47 ∧ (rows.map Row.kp).sum = 1274
    ∧ (rows.map need).sum = 2063 := by decide +kernel

/-- Fin-indexed sum = list sum -/
theorem sum_fin_get {α : Type*} (g : α → ℕ) : ∀ L : List α, ∑ i : Fin L.length, g (L.get i) = (L.map g).sum
  | [] => by simp
  | a :: L => by simp [Fin.sum_univ_succ, sum_fin_get g L]
end FloorK22Data
