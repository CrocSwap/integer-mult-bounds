import LevelFrameJoins
import FrameGeometry
import PortGeometry
import Mathlib.LinearAlgebra.Span.Defs

/-!
The literal source entrance frame is the line generated by its E8 root.
Apache-2.0. Prepared with substantial OpenAI Codex assistance.

This module interprets the independently checked frame-label joins over `ℚ`.
It does not define the entrance from a pending mask, and it does not transport
the schedule's levels or pending operators to arbitrary fields. The latter
is outside Phase 1.
-/

namespace PR442LevelModel
open scoped Matrix BigOperators
set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The rational root from the pinned source table, without normalization. -/
def q (port : Fin 120) : Fin 8 → ℚ := fun i => (rootVector port i : ℚ)

/-- `P_q = q qᵀ / 4`, with the literal E8 root of squared length four. -/
def rootProjector (port : Fin 120) : Matrix (Fin 8) (Fin 8) ℚ :=
  fun i j => q port i * q port j / 4

/-- Every entry of the independently identified literal entrance projector
agrees with the root formula. -/
theorem source_entrance_projector_entry (port : Fin 120) (i j : Fin 8) :
    FrameGeometry.projector ℚ (sourceEntrance port) i j =
      q port i * q port j / 4 := by
  change (4 : ℚ)⁻¹ * (FrameGeometry.scaled (sourceEntrance port) i j : ℚ) = _
  rw [entrance_scaled]
  simp only [Int.cast_mul]
  unfold q
  ring

/-- The literal source entrance projector is exactly `P_q`. -/
theorem source_entrance_projector (port : Fin 120) :
    FrameGeometry.projector ℚ (sourceEntrance port) = rootProjector port := by
  ext i j
  exact source_entrance_projector_entry port i j

/-- The root normalization is inherited from the existing checked port-chart
certificate, with the new literal-root/first-column join made explicit. -/
theorem root_square_sum (port : Fin 120) :
    (∑ i : Fin 8, q port i * q port i) = 4 := by
  have h := congrArg (fun m : Matrix (Fin 8) (Fin 8) ℚ => m 0 0)
    (PortGeometry.cast_orthogonal ℚ port)
  simpa [Matrix.mul_apply, Matrix.transpose_apply, Matrix.smul_apply,
    Matrix.one_apply, PortGeometry.castBasis, PortGeometry.integerBasis,
    Matrix.map, q, root_eq_basis, smul_eq_mul] using h

/-- Action of the literal entrance projector on an arbitrary rational vector. -/
theorem source_entrance_mulVec (port : Fin 120) (v : Fin 8 → ℚ) :
    FrameGeometry.projector ℚ (sourceEntrance port) *ᵥ v =
      ((q port ⬝ᵥ v) / 4) • q port := by
  funext i
  change (∑ j : Fin 8,
      FrameGeometry.projector ℚ (sourceEntrance port) i j * v j) =
    ((∑ j : Fin 8, q port j * v j) / 4) * q port i
  calc
    (∑ j : Fin 8,
        FrameGeometry.projector ℚ (sourceEntrance port) i j * v j) =
        ∑ j : Fin 8, (q port j * v j / 4) * q port i := by
      apply Finset.sum_congr rfl
      intro j _
      rw [source_entrance_projector_entry]
      ring
    _ = (∑ j : Fin 8, q port j * v j / 4) * q port i := by
      rw [Finset.sum_mul]
    _ = ((∑ j : Fin 8, q port j * v j) / 4) * q port i := by
      simp only [div_eq_mul_inv, Finset.sum_mul]

/-- The entrance projector fixes the literal root. -/
theorem source_entrance_fixes_root (port : Fin 120) :
    FrameGeometry.projector ℚ (sourceEntrance port) *ᵥ q port = q port := by
  rw [source_entrance_mulVec]
  have h : q port ⬝ᵥ q port = 4 := root_square_sum port
  rw [h]
  norm_num

/-- The actual range of the literal source entrance projector is `span(q)`.
The equality concerns all rational input vectors, not a set of test inputs. -/
theorem source_entrance_range (port : Fin 120) :
    Set.range (fun v : Fin 8 → ℚ =>
      FrameGeometry.projector ℚ (sourceEntrance port) *ᵥ v) =
    (Submodule.span ℚ ({q port} : Set (Fin 8 → ℚ)) : Set (Fin 8 → ℚ)) := by
  ext v
  constructor
  · rintro ⟨w, rfl⟩
    apply Submodule.mem_span_singleton.mpr
    exact ⟨(q port ⬝ᵥ w) / 4, (source_entrance_mulVec port w).symm⟩
  · intro hv
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hv
    refine ⟨c • q port, ?_⟩
    change FrameGeometry.projector ℚ (sourceEntrance port) *ᵥ (c • q port) = v
    rw [Matrix.mulVec_smul, source_entrance_fixes_root]
    exact hc

end PR442LevelModel
