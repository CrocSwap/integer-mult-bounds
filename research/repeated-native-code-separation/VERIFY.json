{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [
    "numpy==2.5.4"
  ],
  "inputs": [
    "research/coded-native-caller/CODE.json",
    "research/coded-native-caller/LICENSE",
    "research/coded-native-caller/NORMALIZERS.json",
    "research/coded-native-caller/NOTICE",
    "research/coded-native-caller/ORIGINS.json"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 600,
      "checks": "Replay all native moment entries from the dense source matrix; verify exact Gram independence and boundary controls."
    },
    {
      "argv": [
        "{python}",
        "-O",
        "-B",
        "{package}/verify.py",
        "--certificate-only"
      ],
      "timeout_seconds": 120,
      "checks": "Check the pinned certificate, both determinant algorithms and rejection controls under optimized Python; no dense replay."
    }
  ]
}
