/-! ## trees -/

theorem lft_nd {α : Type} (l r : Tr α) : Tr.lft (.nd l r) = l := rfl
theorem rgt_nd {α : Type} (l r : Tr α) : Tr.rgt (.nd l r) = r := rfl

