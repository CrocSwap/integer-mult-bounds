theorem decodeAll_append : ∀ (a b : List (Nat × Nat)), decodeAll (a ++ b) = decodeAll a ++ decodeAll b
  | [], b => by simp [decodeAll]
  | (n, x) :: a, b => by simp [decodeAll, decodeAll_append a b]

theorem chainEvs_eq : ∀ L : List (List (Nat × Nat) × Tr Nat), chainEvs L = decodeAll (L.map Prod.fst).flatten
  | [] => by simp [chainEvs, decodeAll]
  | x :: L => by
    have := chainEvs_eq L
    simp only [chainEvs, List.map_cons, List.flatten_cons] at this ⊢
    rw [this, decodeAll_append]

theorem brun_cat {NR : ℕ} {S2 S1 S0 : BS} {a b : List (Nat × Nat)}
    (hb : brun NR S2 (decodeAll b).reverse = some S1) (ha : brun NR S1 (decodeAll a).reverse = some S0) :
    brun NR S2 (decodeAll (a ++ b)).reverse = some S0 := by
  rw [decodeAll_append, List.reverse_append, brun_append, hb]; simpa using ha

theorem svv_filter (m : ℕ) : ∀ (l : SV) (o : ℕ),
    svv (l.filter (fun e => Nat.testBit m e.1)) o = if Nat.testBit m o then svv l o else 0
  | [], o => by simp [svv]
  | (i, x) :: l, o => by
    simp only [List.filter_cons]
    by_cases h : Nat.testBit m i = true
    · rw [if_pos h]; simp only [svv, svv_filter m l o]
      by_cases hi : i = o
      · subst hi; simp [h]
      · simp [hi]
    · rw [if_neg h, svv_filter m l o]; simp only [svv]
      by_cases hi : i = o
      · subst hi; simp [h]
      · simp [hi]

