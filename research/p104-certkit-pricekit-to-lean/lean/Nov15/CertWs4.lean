/-
CertWs4 (GENERATED by toolkit/certkit/certkit.py, lane CERTKIT).  The CONCRETE kernel-replayed trace trWs4 (chain UniInhabitWs4)
under the #7113 caller: its own invoice (the Valid form of Crossing.word: caller data + 17 × (helper climbs - MOVE prices),
fold_paid / path ends, NO Rows premise) equals PRICEKIT's invoice form F cs, so
  kword_bracket : lo ≤ kword ∧ kword ≤ hi,   kword = sSup {κ ∈ [0,1) | the word crosses its invoice at κ}
with lo/hi from CertWs4Num (PRICEKIT κ to 10 significant digits).  Kernel only.
-/
import Nov15.UniInhabitWs4Main
import Nov15.CertWs4Num

namespace CertWs4
open Uni WordModel Finset UniFold7113 UniUniversal SafeRungsPrice UniInhabitWs4 CertKit

attribute [local irreducible] trWs4 evsWs4 Tabs.maskT Tabs.ck26 Tabs.xI Tabs.yI Tabs.x2I Tabs.y2I Tabs.finP
  Tabs.initP Tabs.hI

/-- the word's Valid inequality at κ (exactly the `Crossing.word` field, 17 equal calls). -/
def ValidAt (κ : ℝ) : Prop :=
  cdat (1 - κ) Pcal + ∑ _i : Fin 17, wordPaid caller7113 (exec trWs4) specPrice (1 - κ) ≤
    cdat (1 - κ) Tcal + ∑ _i : Fin 17, ∑ r ∈ (helpers : Finset R7), gc (1 - κ) (hcred (exec trWs4) r)

/-- the word's own invoice: credit side minus paid side. -/
noncomputable def FW (κ : ℝ) : ℝ :=
  (cdat (1 - κ) Tcal + ∑ _i : Fin 17, ∑ r ∈ (helpers : Finset R7), gc (1 - κ) (hcred (exec trWs4) r)) -
    (cdat (1 - κ) Pcal + ∑ _i : Fin 17, wordPaid caller7113 (exec trWs4) specPrice (1 - κ))

theorem valid_iff (κ : ℝ) : ValidAt κ ↔ 0 ≤ FW κ := by
  unfold ValidAt FW; constructor <;> intro h <;> linarith

/-- the trace's invoice IS PRICEKIT's invoice form (kernel: fold histograms of the replayed trace). -/
theorem FW_eq (κ : ℝ) (hκ : κ ≠ 1) : FW κ = F cs κ := by
  have hσ : (1 - κ) ≠ 0 := sub_ne_zero.2 (Ne.symm hκ)
  unfold FW
  rw [paid7_hist _ hσ, cred7_hist]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, cdat, Tcal, Pcal, F, cs,
    List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  push_cast
  simp only [Real.one_rpow]
  ring

/-- **κ_word**: the largest κ ∈ [0,1) at which the concrete word crosses its own invoice. -/
noncomputable def kword : ℝ := sSup {κ : ℝ | 0 ≤ κ ∧ κ < 1 ∧ ValidAt κ}

theorem kword_eq : kword = kroot cs := by
  unfold kword kroot
  congr 1
  ext κ
  constructor
  · rintro ⟨h0, h1, hv⟩
    exact ⟨h0, by rw [← FW_eq κ h1.ne]; exact (valid_iff κ).1 hv⟩
  · rintro ⟨h0, hF⟩
    have hlt : κ < hi := by
      by_contra h; push Not at h; have := neg_all κ h; linarith
    have h1 : κ < 1 := hlt.trans hi_lt_one
    exact ⟨h0, h1, (valid_iff κ).2 (by rw [FW_eq κ h1.ne]; exact hF)⟩

/-- **kword_bracket**: the concrete word's κ agrees with PRICEKIT to 10 significant digits. -/
theorem kword_bracket : lo ≤ kword ∧ kword ≤ hi := by
  rw [kword_eq]; exact ⟨bracket.1, bracket.2.1⟩

/-- the word's invoice vanishes at kword (it is a crossing point, not just a sup). -/
theorem kword_root : FW kword = 0 := by
  have h := kword_bracket
  rw [FW_eq _ (ne_of_lt (h.2.trans_lt hi_lt_one)), kword_eq]; exact bracket.2.2.1

theorem valid_below (κ : ℝ) (h0 : 0 ≤ κ) (h1 : κ ≤ lo) : ValidAt κ := by
  have hk1 : κ ≠ 1 := ne_of_lt (h1.trans_lt (lo_lt_hi.trans hi_lt_one))
  rw [valid_iff, FW_eq κ hk1]; exact (pos_all κ h0 h1).le

theorem invalid_above (κ : ℝ) (h0 : hi ≤ κ) (h1 : κ < 1) : ¬ ValidAt κ := by
  rw [valid_iff, FW_eq κ h1.ne]; have := neg_all κ h0; linarith

end CertWs4

