/-- packing parameters; `ok` (UniRowsWs4PSound) ties the literal fields to W, kb, NO. -/
structure Pk where
  W : Nat
  kb : Nat
  NO : Nat
  B : Nat
  K : Nat
  Z0 : Nat
  MSK : Nat
  BN : Nat

/-- the number with NO copies of digit c (base 2^W). -/
def rp (W c : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => 2 ^ W * rp W c n + c

def Pk.okb (k : Pk) : Bool :=
  Nat.beq k.B (2 ^ k.W) && Nat.beq k.K (2 ^ k.kb) && Nat.ble (k.kb + 2) k.W &&
  Nat.beq k.Z0 (rp k.W k.K k.NO) && Nat.beq k.MSK (rp k.W (2 ^ k.W - 2 ^ (k.kb + 1)) k.NO) &&
  Nat.beq k.BN (2 ^ (k.W * k.NO))

/-- V is a valid packing: every digit < 2K, no digit at or beyond NO. -/
def bnd (k : Pk) (V : Nat) : Bool := Nat.beq (V &&& k.MSK) 0 && Nat.blt V k.BN

/-- backward ADD/SCALE core: V' with q·V' = q·Va + (±p)·(Vr − Z0); `none` unless exact and in bounds. -/
def comb (k : Pk) (Va Vr : Nat) (neg : Bool) (p q : Nat) : Option Nat :=
