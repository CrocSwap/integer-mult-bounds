/-
UniCtl (lane UNI-L0L1, L1 control, Nov 19).  um2-style gate in the kernel: for the folded banks of two 7113 words
(t7669: 6157 banks; w_s4 (REBUILDKIT/alt/r7, 19 owned descent runs, 7 multi-register chains): 6250 banks), the paid
histogram of |dim dst − dim src| over the bank list equals PRICEKIT's native P.  The bank lists are
(dim src, dim dst) of `Uni.Ev.mvCh` over the trace (Uni.mlog_charts), generated by cards/WILD/UNIMODEL/l1/um3.py
(which also asserts bank.fold order = program MOVE order and fold P == pricekit P).  The price per bank is
WordModel.mvPrice = |Δdim| = specPrice on nested subspace charts (Uni.specPrice_eq_mvPrice; 0 non-nested, um1).
Kernel only (decide, no native_decide).
-/
import Nov15.UniCtlData

namespace UniCtl

/-- |b − a| on ℕ. -/
def ad (p : Nat × Nat) : Nat := if p.1 ≤ p.2 then p.2 - p.1 else p.1 - p.2

/-- paid histogram (rank, count), ranks 1..9, zero counts dropped (pricekit `+P`). -/
def pHist (l : List (Nat × Nat)) : List (Nat × Nat) :=
  ((List.range 10).map (fun r => (r, l.countP (fun p => ad p == r)))).filter (fun q => q.1 != 0 && q.2 != 0)

set_option maxRecDepth 200000 in
theorem ctl_t7669 : t7669Banks.length = 6157 ∧ pHist t7669Banks = t7669PK := by decide +kernel
set_option maxRecDepth 200000 in
theorem ctl_ws4 : ws4Banks.length = 6250 ∧ pHist ws4Banks = ws4PK := by decide +kernel

end UniCtl

#print axioms UniCtl.ctl_t7669
#print axioms UniCtl.ctl_ws4
