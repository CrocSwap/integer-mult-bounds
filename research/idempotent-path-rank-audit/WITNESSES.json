{
  "orthogonal_lines": {
    "P": [[1,0],[0,0]], "Q": [[0,0],[0,1]],
    "expected_ranks": [1,1,0,0,0], "expected_excess": 0
  },
  "same_line": {
    "P": [[1,0],[0,0]], "Q": [[1,0],[0,0]],
    "expected_ranks": [1,1,1,1,2], "expected_excess": 2
  },
  "common_form_nonorthogonal_lines": {
    "P": [[1,0],[0,0]], "Q": [["1/2","1/2"],["1/2","1/2"]],
    "expected_ranks": [1,1,1,1,2], "expected_excess": 2
  },
  "one_sided_rank_one": {
    "P": [[1,0],[0,0]], "Q": [[0,1],[0,1]],
    "expected_ranks": [1,1,1,0,1], "expected_excess": 1
  },
  "reverse_one_sided_rank_one": {
    "P": [[0,1],[0,1]], "Q": [[1,0],[0,0]],
    "expected_ranks": [1,1,0,1,1], "expected_excess": 1
  },
  "common_form_partial_block_overlap": {
    "P": [[1,0,0],[0,1,0],[0,0,0]], "Q": [[0,0,0],[0,1,0],[0,0,1]],
    "expected_ranks": [2,2,1,1,1], "expected_excess": 2
  },
  "asymmetric_rank_two": {
    "P": [[1,0,0],[0,0,0],[0,0,1]], "Q": [[0,1,0],[0,1,0],[0,0,1]],
    "expected_ranks": [2,2,2,1,2], "expected_excess": 3
  },
  "unequal_rank_complements": {
    "P": [[1,0,0],[0,0,0],[0,0,0]], "Q": [[0,0,0],[0,1,0],[0,0,1]],
    "expected_ranks": [1,2,0,0,0], "expected_excess": 0
  },
  "zero_labels": {
    "P": [[0,0],[0,0]], "Q": [[0,0],[0,0]],
    "expected_ranks": [0,0,0,0,2], "expected_excess": 0
  },
  "equal_product_ranks_without_common_form": {
    "P": [[1,0],[0,0]], "Q": [[1,1],[0,0]],
    "expected_ranks": [1,1,1,1,2], "expected_excess": 2
  }
}
