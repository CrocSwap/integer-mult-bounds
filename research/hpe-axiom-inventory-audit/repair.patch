+def probe_inventory(source):
+    wanted = re.findall(
+        r"(?m)^[ \t]*#print[ \t]+axioms[ \t]+([\w.']+)[ \t]*$",
+        strip_comments(source),
+    )
+    if len(wanted) != len(EXPECTED_RESULTS) or set(wanted) != set(EXPECTED_RESULTS):
+        fail('axiom probe inventory differs from the 42 required results')
+    return wanted
+
+
+def check_axiom_reports(output, wanted):
+    seen = {}
+    pattern = r"'([\w.']+)' (?:depends on axioms: \[([^\]]*)\]|does not depend on any axioms)"
+    for match in re.finditer(pattern, output):
+        name = match.group(1)
+        if name in seen:
+            fail(f'duplicate axiom report for {name}')
+        seen[name] = [] if match.group(2) is None else [
+            a.strip() for a in match.group(2).split(',') if a.strip()
+        ]
+    if set(seen) != set(wanted):
+        fail('axiom reports differ from the required result inventory')
+    for name in wanted:
+        extra = set(seen[name]) - ALLOWED
+        if extra:
+            fail(f'{name} uses {sorted(extra)}')
+
