      "output": "None or exact list, 0..64 entries, each exact int in [0, 2**64-1]"
    },
    "fallback": "Any unsupported count, vector shape, length, exact type, negative sign or width returns NotImplemented without callbacks or state mutation; after retains the original output validation, builds original result/record dictionaries and calls the original json.dumps(...sort_keys=True,separators=(',',':'),ensure_ascii=True).encode('ascii') + newline expression",
    "order": ["unpack inputs", "original output validation", "encode complete record", "existing hasher.update(encoded)", "existing bytes += len(encoded)", "existing count += 1"],
    "canonical_key_order": {"record": ["call", "result", "us", "vs"], "list_result": ["type", "values"], "none_result": ["type"]},
    "runtime_admission": "Frozen ordinary CPython 3.12 JSON runtime; serial calls without mutation within call. No claim of arbitrary JSON monkeypatch equivalence. Native entry replacement is checked at the live guard boundary.",
    "binding_requirement": "Parent extends native ownership/entry freshness records before RuntimeGuard construction. Separate extension requires additional owner and callable checks; combined module requires encoder in native_items. Never alter captured wrapper closure identities afterward.",
    "memory": "8192-byte checked per-call stack buffer, one immutable bytes allocation/copy, no shared scratch, no retained input/output refs, GIL held while accessing exact container borrowed refs",
    "conversion": "PyLong_CheckExact before PyLong_AsUnsignedLongLong; check PyErr_Occurred, clear only OverflowError for fallback, propagate other errors; no mask conversion or double conversion",
    "digit_rendering": "Unsigned division/remainder decimal rendering; fixed ASCII punctuation/literals and final LF; locale independent",
    "parent_integration_choice": "Separate _trace_encoding extension with charged cold build, or parent-owned merge of encoder fragment into combined native module; lane does not edit existing native_gf2.c"
