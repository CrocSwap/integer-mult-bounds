  "primary": {
    "mechanism": "Replace only after's record serialization expression with stateless native bytes encoding on exact bounded values; fallback uses original expression",
    "before": "Unchanged exact Label/dict/int checks; snapshot big then small into ordered tuples before arithmetic",
    "adapter": "Parent injects make_trace_type(backend, native_encoder_module) before bind; construct final trace instance and closure values before RuntimeGuard captures them",
    "native_interface": "encode_record(call, us, vs, output) -> exact bytes including newline | NotImplemented; NULL only for genuine Python errors",
    "fast_domain": {
      "call": "exact int in [0, 2**64-1]",
      "us": "exact tuple, 0..64 entries, each exact int in [0, 2**64-1]",
