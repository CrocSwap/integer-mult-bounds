{
  "commands": [
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/verify.py"
      ],
      "checks": "Fresh unchanged finite dense-oracle, exact-order/type/width/fallback/source/runtime-binding controls; external cold build, no full benchmark.",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "{python}",
        "-B",
        "-O",
        "{package}/verify.py"
      ],
      "checks": "Same finite controls in deliberate optimized mode; full scientific assertions are not disabled.",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/verify_full.py"
      ],
      "checks": "One complete candidate correctness replay through unchanged full driver and150-second/1GiB inner guard; exact original certificate/stdout/types/witness/rank/complement and source checks; no hosted performance factor.",
      "timeout_seconds": 180
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/check_artifacts.py"
      ],
      "checks": "Bounded complete lossless canonical transport/typed-return/certificate checks; stream58MB witness, no scientific replay or benchmark.",
      "timeout_seconds": 60
    }
  ],
