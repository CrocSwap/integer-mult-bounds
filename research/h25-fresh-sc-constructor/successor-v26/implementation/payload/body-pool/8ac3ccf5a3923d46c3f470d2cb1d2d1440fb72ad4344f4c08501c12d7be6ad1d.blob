    _ca_desc = cold_caller_descriptor
    _ca_p = _ca_desc[5]
    _ca_type, _ca_function, _ca_id = _ca_p[0], _ca_p[1], _ca_p[2]
    _ca_error, _ca_value_error, _ca_zip = _ca_p[7], _ca_p[8], _ca_p[18]
    _ca_dispatch, _ca_record = _ca_desc[2], _ca_desc[3]
    if cold_authority is not _ca_desc[1] or _ca_dispatch is not _ca_record[0] or _ca_type(_ca_dispatch) is not _ca_function:
        raise _ca_error('Cold authority caller dispatcher identity differs')
    for (_ca_name, _ca_getter), _ca_expected in _ca_zip(_ca_p[4], _ca_record[1:7]):
        if _ca_id(_ca_getter(_ca_dispatch, _ca_function)) != _ca_id(_ca_expected):
            raise _ca_error('Cold authority caller dispatcher environment differs')
    if _ca_record[4] is not None or _ca_record[5] is not None or _ca_record[7]:
        raise _ca_error('Cold authority caller dispatcher defaults contract differs')
    for _ca_cell, _ca_expected in _ca_record[8]:
        try:
            _ca_observed_id = _ca_id(_ca_p[6](_ca_cell, _ca_p[5]))
        except _ca_value_error:
            raise _ca_error('Cold authority caller dispatcher cell became empty') from None
        if _ca_observed_id != _ca_id(_ca_expected):
            raise _ca_error('Cold authority caller dispatcher cell differs')
    # V8_CALLER_GATE_END cache_controls_v8.py:5
    _ca_dispatch(5, backend_handle, prebind_final)
    try:
        for helper_name in ("_code_named", "_check_factory_environment"):
            helper = getattr(adapter, helper_name)
            for kind in ("code", "defaults", "globals"):
                old_code, old_defaults = helper.__code__, helper.__defaults__
                if kind == "code":
                    helper.__code__ = bad.__code__
                elif kind == "defaults":
                    helper.__defaults__ = (False,)
                else:
                    changed_globals = dict(helper.__globals__)
                    changed_globals["_TYPE"] = bad
                    forged = adapter.FunctionType(helper.__code__, changed_globals,
                                                  helper.__name__, helper.__defaults__, helper.__closure__)
                    forged.__kwdefaults__ = helper.__kwdefaults__
                    setattr(adapter, helper_name, forged)
                try:
                    rejected = _capture(rejected_bind)
                finally:
                    helper.__code__, helper.__defaults__ = old_code, old_defaults
                    setattr(adapter, helper_name, helper)
                _need(rejected[:2] == ("error", "RuntimeError") and
                      "modified callable ran" not in rejected[2] and prebind_owner.runtime is None,
                      "V7 entered a changed cold helper/validator before authentication")
                mark_v7("cold-" + helper_name + "-" + kind, {
                    "actual": rejected, "modified_callable_marker_seen": False,
                    "pre_use_proof": "sealed-entry source order plus rejection",
                    "constructor_entered": False})

        for method_name, cell_name in (("__init__", "base_init"),
                                       ("check", "base_check"),
                                       ("check_backend", "base_backend_check")):
            method = prebind_final.__dict__[method_name]
            for kind in ("code", "defaults", "closure"):
                old_code, old_defaults = method.__code__, method.__defaults__
                cell = old_cell = None
                if kind == "code":
                    # A distinct code identity with unchanged behavior is enough
                    # to detect illegal late capture without running bad bytecode.
                    method.__code__ = method.__code__.replace(co_name="changed_" + method_name)
                elif kind == "defaults":
                    method.__defaults__ = (False,)
                else:
                    cell = method.__closure__[method.__code__.co_freevars.index(cell_name)]
                    old_cell, cell.cell_contents = cell.cell_contents, bad
                try:
                    rejected = _capture(rejected_bind)
                finally:
                    method.__code__, method.__defaults__ = old_code, old_defaults
                    if cell is not None:
                        cell.cell_contents = old_cell
                _need(rejected[:2] == ("error", "RuntimeError") and prebind_owner.runtime is None,
                      "V7 accepted a changed final class before the first virtual check")
                mark_v7("final-class-" + method_name + "-" + kind, {
                    "actual": rejected, "constructor_entered": False,
                    "first_virtual_check_entered": False})
        class ForeignFinal(prebind_final):
            pass
        def reject_unregistered_final():
            # V8_CALLER_GATE_BEGIN cache_controls_v8.py:14
            _ca_desc = cold_caller_descriptor
            _ca_p = _ca_desc[5]
            _ca_type, _ca_function, _ca_id = _ca_p[0], _ca_p[1], _ca_p[2]
            _ca_error, _ca_value_error, _ca_zip = _ca_p[7], _ca_p[8], _ca_p[18]
            _ca_dispatch, _ca_record = _ca_desc[2], _ca_desc[3]
            if cold_authority is not _ca_desc[1] or _ca_dispatch is not _ca_record[0] or _ca_type(_ca_dispatch) is not _ca_function:
                raise _ca_error('Cold authority caller dispatcher identity differs')
            for (_ca_name, _ca_getter), _ca_expected in _ca_zip(_ca_p[4], _ca_record[1:7]):
                if _ca_id(_ca_getter(_ca_dispatch, _ca_function)) != _ca_id(_ca_expected):
                    raise _ca_error('Cold authority caller dispatcher environment differs')
            if _ca_record[4] is not None or _ca_record[5] is not None or _ca_record[7]:
                raise _ca_error('Cold authority caller dispatcher defaults contract differs')
            for _ca_cell, _ca_expected in _ca_record[8]:
                try:
                    _ca_observed_id = _ca_id(_ca_p[6](_ca_cell, _ca_p[5]))
                except _ca_value_error:
                    raise _ca_error('Cold authority caller dispatcher cell became empty') from None
                if _ca_observed_id != _ca_id(_ca_expected):
                    raise _ca_error('Cold authority caller dispatcher cell differs')
            # V8_CALLER_GATE_END cache_controls_v8.py:14
            return _ca_dispatch(5, backend_handle, ForeignFinal)
        rejected_subclass = _capture(reject_unregistered_final)
        _need(rejected_subclass[:2] == ("error", "RuntimeError") and
              backend.RuntimeGuard is prebind_final and prebind_owner.runtime is None,
              "V7 admitted an arbitrary final guard subclass")
        mark_v7("unregistered-final-subclass", {
            "actual": rejected_subclass, "installed_guard_unchanged": True})
        # The same unchanged, source-owned final product now binds once. This
        # ensures negative controls did not merely rely on an unusable owner.
        prebind_result = rejected_bind()
        _need(prebind_owner.runtime is prebind_result["runtime_guard"] and
              type(prebind_owner.runtime) is prebind_final,
              "Restored final guard did not perform its first real binding")
        prebind_result["runtime_guard"].check_backend()
        prebind_result["runtime_guard"].check()
        mark_v7("restored-final-class-binds", {"exact_registered_final_class": True,
                                               "full_and_light_checks": True})
    finally:
        try:
            # V8_CALLER_GATE_BEGIN cache_controls_v8.py:15
            _ca_desc = cold_caller_descriptor
            _ca_p = _ca_desc[5]
            _ca_type, _ca_function, _ca_id = _ca_p[0], _ca_p[1], _ca_p[2]
            _ca_error, _ca_value_error, _ca_zip = _ca_p[7], _ca_p[8], _ca_p[18]
            _ca_dispatch, _ca_record = _ca_desc[2], _ca_desc[3]
            if cold_authority is not _ca_desc[1] or _ca_dispatch is not _ca_record[0] or _ca_type(_ca_dispatch) is not _ca_function:
                raise _ca_error('Cold authority caller dispatcher identity differs')
            for (_ca_name, _ca_getter), _ca_expected in _ca_zip(_ca_p[4], _ca_record[1:7]):
                if _ca_id(_ca_getter(_ca_dispatch, _ca_function)) != _ca_id(_ca_expected):
                    raise _ca_error('Cold authority caller dispatcher environment differs')
            if _ca_record[4] is not None or _ca_record[5] is not None or _ca_record[7]:
                raise _ca_error('Cold authority caller dispatcher defaults contract differs')
            for _ca_cell, _ca_expected in _ca_record[8]:
                try:
                    _ca_observed_id = _ca_id(_ca_p[6](_ca_cell, _ca_p[5]))
                except _ca_value_error:
                    raise _ca_error('Cold authority caller dispatcher cell became empty') from None
                if _ca_observed_id != _ca_id(_ca_expected):
                    raise _ca_error('Cold authority caller dispatcher cell differs')
            # V8_CALLER_GATE_END cache_controls_v8.py:15
            _ca_dispatch(5, backend_handle, original_guard)
        finally:
            prebind_receipt = prebind_owner.teardown()
    _need(prebind_receipt["probe_closed"] is True and prebind_receipt["teardowns"] == 1,
          "V7 pre-bind control owner did not close exactly once")

    # V8_REAL_CALLER_CONTROLS_BEGIN
    # Real caller paths complement the separate authority-wide helper suite.
    # Source ordering proves pre-use admission; receipts record actual errors
    # and counters, not an invented count of executed replacement instructions.
    v8_cases = []

    def mark_v8(name, detail):
        v8_cases.append(name)
        record(("native-v8", name), detail)

    actual_cold_dispatcher = cold_caller_descriptor[2]
    actual_runtime_dispatcher = owner.collector_descriptor[2]
    actual_runtime_collector = owner.collector_guard
    for target_name, target in (("cold-dispatcher", actual_cold_dispatcher),
                                ("runtime-dispatcher", actual_runtime_dispatcher),
                                ("runtime-collector", actual_runtime_collector)):
        for mutation in ("code", "defaults", "kwdefaults", "closure"):
            old_code, old_defaults, old_keywords = target.__code__, target.__defaults__, target.__kwdefaults__
            changed_cell = old_cell_value = None
            before = dict(binding["counters"])
            if mutation == "code":
                target.__code__ = old_code.replace(co_name="v8_changed_" + target_name.replace("-", "_"))
            elif mutation == "defaults":
                target.__defaults__ = (False,)
            elif mutation == "kwdefaults":
                target.__kwdefaults__ = {"v8_changed_keyword": False}
            else:
                _need(type(target.__closure__) is tuple and len(target.__closure__) > 0,
                      "Actual V8 caller target lacks the declared closure fixture")
                changed_cell = target.__closure__[0]
                old_cell_value = changed_cell.cell_contents
                changed_cell.cell_contents = object()
            try:
                if target_name == "cold-dispatcher":
                    # invoke is the actual source control entry used throughout
                    # the preserved suite; its inline gate runs before dispatch.
                    rejected = [_capture(lambda: invoke("_record", sample_function))]
                else:
                    # Both real final-row paths enter the actual cache class,
                    # whose already-admitted frame checks the child dispatcher.
                    rejected = [_capture(binding["runtime_guard"].check),
                                _capture(binding["runtime_guard"].check_backend)]
            finally:
                target.__code__, target.__defaults__, target.__kwdefaults__ = old_code, old_defaults, old_keywords
                if changed_cell is not None:
                    changed_cell.cell_contents = old_cell_value
            _need(all(item[:2] == ("error", "RuntimeError") for item in rejected) and
                  dict(binding["counters"]) == before,
                  "V8 actual caller allowed changed authority dispatch metadata")
            if target_name == "cold-dispatcher":
                _need("Cold authority caller dispatcher" in rejected[0][2],
                      "V8 cold rejection was not at the inline caller boundary")
            elif target_name == "runtime-dispatcher":
                _need(all("Runtime drift: cache collector dispatcher" in item[2] for item in rejected),
                      "V8 runtime dispatcher reached execution before caller admission")
            else:
                expected_message = (
                    "Runtime drift: cache collector caller: target closure value differs"
                    if mutation == "closure" else
                    "Runtime drift: cache collector caller: target function environment differs")
                expected_rejection = ("error", "RuntimeError", expected_message)
                _need(rejected[0] == expected_rejection and rejected[1] == expected_rejection,
                      "V9 full/light collector rejection did not originate before target entry")
            binding["runtime_guard"].check()
            mark_v8(target_name + "-" + mutation, {
                "actual_rejections": rejected, "arithmetic_delta": 0,
                "path": "actual control invoke" if target_name == "cold-dispatcher" else "actual full and light runtime guards",
                "pre_use_proof": "literal caller gate and primitive-only dispatcher source ordering",
                "metadata_restored_before_followup": True})
    # V8_REAL_CALLER_CONTROLS_END

    # Loading the same file creates independent native module state. Closing the
    # first owner must not disarm the second owner or reuse its admission state.
    other = load_source("_h25_cache_other_probe_module_v7")
    other_prepared = invoke("prepare_cache_contract", other, extension_path, expected_extension_sha256,
        bootstrap_root=bootstrap_root, bootstrap_capability=bootstrap_capability, bootstrap_api=bootstrap_api,
        factory_environment=factory_environment)
    other.Checks.residual_ok = other_prepared["residual_ok"]
    other.Checks.label_ok = other_prepared["label_ok"]
    other_binding, other_row_helper, other_row_guard, other_rank_rows = bind_prepared(other, other_prepared)
    other_checks = _checks(other)
    other_small, other_big = other.Label([1]), other.Label([1])
    _need(other_checks.residual_ok(other_small, other_big) is True,
          "Independent native module failed initial request")
    binding["runtime_guard"].check()
    receipt = owner.teardown()
    _need(receipt["current_authority_entries"] == 0 and not owner.states and receipt["probe_closed"] is True,
          "Cache/native teardown retained active state")
    closed = _capture(binding["runtime_guard"].check)
    _need(closed[:2] == ("error", "RuntimeError"), "Closed native binding remained admitted")
    closed_backend = _capture(binding["runtime_guard"].check_backend)
    _need(closed_backend[:2] == ("error", "RuntimeError"),
          "Closed cache owner remained usable through backend guard")
    mark_v6("closed-owner-backend-rejection", {"full": closed, "backend": closed_backend})
    other_binding["runtime_guard"].check()
    _need(other_checks.residual_ok(other_small, other_big) is True,
          "Closing one owner affected another native module")
    other_receipt = other_prepared["owner"].teardown()
    _need(other_receipt["probe_closed"] is True and other_receipt["teardowns"] == 1,
          "Second native owner cleanup incomplete")
    mark_native("isolated-module-close", {"first_closed_rejection": closed,
                                          "second_owner_unchanged": True})

    # Two fresh provider/native owners exercise terminal failures without a
    # scientific request or fabricated native counters. They deliberately alter
    # a public native binding, keeping captured cleanup entries untouched.
    teardown_failures = []
    for failure_kind in ("validation", "attempted-native-accounting"):
        failing = load_source("_h25_cache_teardown_" + failure_kind.replace("-", "_") + "_v7")
        failing_prepared = invoke("prepare_cache_contract", failing, extension_path, expected_extension_sha256,
            bootstrap_root=bootstrap_root, bootstrap_capability=bootstrap_capability, bootstrap_api=bootstrap_api,
        factory_environment=factory_environment)
        failing_owner = failing_prepared["owner"]
        provider = failing_owner.probe_provider
        probe_binding = failing_owner.probe_binding
        registered = provider._OWNERS[id(probe_binding)]
        native_module, native_entries = registered[1], registered[2]
        original_check = native_module.check
        native_before_failure = failing_owner.probe_counters()
        native_module.check = bad
        if failure_kind == "attempted-native-accounting":
            try:
                attempted = _capture(lambda: failing_owner._probe_safe({}, ((1,), (1,))))
            finally:
                native_module.check = original_check
            _need(attempted[:2] == ("error", "RuntimeError") and
                  failing_owner.receipt["probe_entry_calls"] == 1 and
                  failing_owner.probe_counters()["calls"] == native_before_failure["calls"] == 0,
                  "Failed actual provider inspection did not preserve attempted/native mismatch")
        caught = None
        try:
            failing_owner.teardown()
        except Exception as error:
            caught = error
        finally:
            native_module.check = original_check
        stop = failing_owner.teardown_stop
        _need(caught is not None and caught is failing_owner.teardown_primary_error and
              _TYPE(caught) is RuntimeError and _TYPE(stop) is dict and stop["status"] == "STOP",
              "Teardown replaced or hid its original primary failure")
        _need(failing_owner.probe_closed is True and not failing_owner.states and
              id(probe_binding) not in provider._OWNERS and
              failing_owner.receipt["teardowns"] == 1 and stop["close_attempted"] is True and
              stop["owner_terminal"] is True,
              "Rejected teardown skipped disarm/registry release/terminal state")
        disarmed = _capture(native_entries[1])
        _need(disarmed == ("error", "RuntimeError", "Probe is not authenticated and active"),
              "Captured actual native check did not observe disarmed module")
        if failure_kind == "validation":
            _need(stop["stage"] == "validation" and stop["native_counters_available"] is False and
                  stop["native_probe"] is None and stop["observed_probe_calls"] is None and
                  stop["attempted_minus_native"] is None and stop["expected_probe_calls"] == 0 and
                  caught.__cause__ is failing_owner.teardown_close_error and
                  failing_owner.teardown_close_error is not None,
                  "Validation/close failures lost primary identity or fabricated native counts")
        else:
            _need(stop["stage"] == "accounting" and stop["native_counters_available"] is True and
                  stop["expected_probe_calls"] == 1 and stop["observed_probe_calls"] == 0 and
                  stop["attempted_minus_native"] == 1 and stop["close_error"] is None,
                  "Attempted/native mismatch was repaired or hidden during teardown")
        teardown_failures.append(stop)
        mark_native("teardown-" + failure_kind + "-rejection",
                    {"stop": stop, "disarmed": disarmed, "primary_identity_preserved": True},
                    revision="v5")
    _need(native_cases == ["empty-first-result-authority", "offhash-foreign-key", "offhash-value-resize",
                           "eligible-native-exit-unsupported",
                           "provider-function-binding", "binding-inspect-code", "binding-inspect-defaults",
                           "isolated-module-close", "teardown-validation-rejection",
                           "teardown-attempted-native-accounting-rejection"],
          "Exact v5 consumer control census changed")
    _need(len(v7_cases) == 24 and transcript_record_count - len(v8_cases) == V7_DECLARED_TRANSCRIPT_RECORDS,
          "V7 observed transcript census differs from the separately declared source census")
    _need(len(v8_cases) == 12 and transcript_record_count == V8_DECLARED_TRANSCRIPT_RECORDS,
          "V8 actual caller-control transcript census differs")
    return {"status": "PASS", "counts": counts, "transcript_sha256": transcript.hexdigest(),
            "transcript_record_count": transcript_record_count,
            "native_consumer_cases": native_cases, "native_consumer_case_count": 10,
            "v6_consumer_cases": v6_cases, "v6_consumer_case_count": len(v6_cases),
            "v7_consumer_cases": v7_cases, "v7_consumer_case_count": len(v7_cases),
            "v7_prebind_native_owner": prebind_receipt,
            "v8_caller_cases": v8_cases, "v8_caller_case_count": len(v8_cases),
            "backend_binding_derivation": owner.binding_derivation,
            "expected_teardown_stop_evidence": teardown_failures,
            "second_native_owner": other_receipt,
            "candidate_cache": receipt, "candidate_native": dict(binding["counters"]),
            "reference": "separate unchanged original module; fresh exact dictionaries except independent forced-miss old-value-finalizer fixture",
            "no_shared_labels_snapshots_or_answers": True,
            "full_caller_and_normal_O_gates_required_separately": True,
            "native_profile_layout_controls_and_v3_reference_required_separately": True,
            "full_caller_cost_feasibility_and_exact_coverage_gate_closed": True}
