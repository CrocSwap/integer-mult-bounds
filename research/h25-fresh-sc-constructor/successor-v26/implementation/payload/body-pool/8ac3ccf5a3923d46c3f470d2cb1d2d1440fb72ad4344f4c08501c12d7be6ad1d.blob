    # Exact dict alone is insufficient: a non-string key may compare against a
    # known name. Admission must reject before the first named base lookup and
    # release the temporary iterator/key even while the error remains alive.
    key_events = []
    class ForeignName:
        def __hash__(self):
            return hash("odd")
        def __eq__(self, other):
            key_events.append("equality")
            return False
        def __del__(self):
