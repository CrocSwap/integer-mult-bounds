"""Source-authenticated optional immutable observation sharing; no cached rank answer."""
import ast
import hashlib
from pathlib import Path
from types import FunctionType, ModuleType

ORIGINAL_SHA256 = "e473c38245c3668715b5a78dfe980b2fe3ed0d0c9b8c97c666fbae6ecf1fffd5"

def install(backend):
    if type(backend) is not ModuleType or type(backend.bind) is not FunctionType:
        raise RuntimeError("Unexpected original backend owner")
    raw = Path(backend.__file__).read_bytes()
    if hashlib.sha256(raw).hexdigest() != ORIGINAL_SHA256:
        raise RuntimeError("Original backend derivation source changed")
    original_code = compile(raw, backend.__file__, "exec", dont_inherit=True)
    expected_codes = [value for value in original_code.co_consts if type(value) is type(original_code) and value.co_name == "bind"]
    original = backend.bind
    if (len(expected_codes) != 1 or original.__globals__ is not backend.__dict__ or original.__builtins__ is not backend._BUILTINS or
            original.__closure__ is not None or original.__defaults__ != (None, None) or
            original.__kwdefaults__ is not None or
            backend._code_shape(original.__code__) != backend._code_shape(expected_codes[0])):
        raise RuntimeError("Original loaded bind drifted before derivation")
    tree = ast.parse(raw, filename=backend.__file__)
    nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "bind"]
    if len(nodes) != 1:
        raise RuntimeError("Missing unique original bind")
    node = nodes[0]
    if [a.arg for a in node.args.args] != ["module", "native", "rank_calls", "complement_trace"] or len(node.args.defaults) != 2:
        raise RuntimeError("Original bind signature changed")
    node.args.args.append(ast.arg(arg="rank_row_intern"))
    node.args.defaults.append(ast.Constant(None))
    target = ast.parse("rank_calls.append((rows, rank))").body[0]
    matches = 0
    for parent in ast.walk(node):
        for field, value in ast.iter_fields(parent):
            if type(value) is not list:
                continue
            rewritten = []
            for child in value:
                if isinstance(child, ast.Expr) and ast.dump(child, include_attributes=False) == ast.dump(target, include_attributes=False):
                    replacement = ast.parse("observed_rows = rows if rank_row_intern is None else rank_row_intern(rows)\nrank_calls.append((observed_rows, rank))").body
                    for item in replacement:
                        ast.copy_location(item, child)
                    rewritten.extend(replacement)
                    matches += 1
                else:
                    rewritten.append(child)
            setattr(parent, field, rewritten)
    if matches != 1:
        raise RuntimeError("Native-success observer derivation changed")
    derived = ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[]))
    code = compile(derived, backend.__file__ + "#immutable-observation-v1", "exec", dont_inherit=True)
    namespace = {}
    exec(code, backend.__dict__, namespace)
    function = namespace["bind"]
    if type(function) is not FunctionType or function.__globals__ is not backend.__dict__:
        raise RuntimeError("Derived bind ownership changed")
    backend.bind = function
    return {"status": "SOURCE_DERIVED", "original_sha256": ORIGINAL_SHA256,
            "replacement_count": matches, "arithmetic_and_fallback_unchanged": True,
            "derivation_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
