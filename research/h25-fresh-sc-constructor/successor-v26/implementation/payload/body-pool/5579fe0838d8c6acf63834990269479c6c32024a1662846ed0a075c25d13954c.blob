def prepare(root, backend, backend_handle, native, output, lanes, phases,
            authority, adapters_handle, source_custody, *, cold_caller_descriptor):
    """The original prepare sequence with source-authenticated class producers."""
    selected = set() if lanes == 'none' else ({'sets', 'guards', 'trace'} if lanes == 'all' else {lanes})
    if not selected <= {'sets', 'guards', 'trace'}:
        raise RuntimeError('Unsupported frozen lane selection')
    state = {'selected': selected, 'controls': {}, 'trace_type': backend.ComplementTrace,
             'set_binding': None, 'encoder_build': None, 'encoder': None,
             'authority': authority, 'authority_adapters_handle': adapters_handle,
             'cold_caller_descriptor': cold_caller_descriptor,
             'authority_backend_handle': backend_handle, 'authority_handles': {},
             'authority_product_cases': []}
    handles = state['authority_handles']
    if 'guards' in selected:
        state['guard_adapter'], handles['guard_adapter'] = _load(
            authority, cold_caller_descriptor, root, 'priorities/runtime-guards/guard_candidate.py',
            '_h25_guard_candidate', source_custody)
        state['guard_controls'], handles['guard_controls'] = _load(
            authority, cold_caller_descriptor, root, 'priorities/runtime-guards/guard_controls.py',
