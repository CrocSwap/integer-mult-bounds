    # END caller admission guarded_adapters_v4:33
    _ca_dispatch(4, *_ca_args, **_ca_kwargs)
    _need(type(trace_type) is type, 'Trace producer returned a different metaclass')
    members = type.__getattribute__(trace_type, '__dict__')
    _need('_h25_native_entries' in members, 'Actual trace native-entry tuple is absent')
    entries = members['_h25_native_entries']
    _need(type(entries) is tuple and all(type(item) is tuple and len(item) == 3 for item in entries),
          'Actual trace native-entry tuple shape differs')
    return entries


