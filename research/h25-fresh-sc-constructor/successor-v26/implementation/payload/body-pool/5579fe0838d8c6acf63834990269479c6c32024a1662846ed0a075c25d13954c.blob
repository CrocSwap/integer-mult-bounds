"""Source-owned setup for the original bookkeeping adapters under the V8 caller protocol.

The old adapters.py remains byte-for-byte unchanged. This wrapper preserves its
setup order, cold encoder build, selected controls and original native/trace/P1
operations. Only module loading and exact returned guard-class installation use
the early source authority. It must itself be loaded and invoked by that token.
"""
import adapters


def _need(condition, message):
    if not condition:
        raise RuntimeError(message)


def _load(authority, cold_caller_descriptor, root, relative, name, source_custody, *, kind='module'):
    _need(type(relative) is str and relative in source_custody,
          'Guarded setup source is absent from the frozen custody map')
    row = source_custody[relative]
    _need(type(row) is dict and type(row.get('sha256')) is str,
          'Guarded setup source pin is not configured')
    # BEGIN evaluated dispatch arguments guarded_adapters_v4:22
    _ca_args = (str(root / relative), row['sha256'], name)
    _ca_kwargs = {'kind': kind}
    # END evaluated dispatch arguments guarded_adapters_v4:22
    # BEGIN caller admission guarded_adapters_v4:22
    _ca_desc = cold_caller_descriptor
    _ca_p = _ca_desc[5]
    _ca_type, _ca_function, _ca_id = _ca_p[0], _ca_p[1], _ca_p[2]
    _ca_error, _ca_value_error, _ca_zip = _ca_p[7], _ca_p[8], _ca_p[18]
    _ca_dispatch, _ca_record = _ca_desc[2], _ca_desc[3]
    if authority is not _ca_desc[1] or _ca_dispatch is not _ca_record[0] or _ca_type(_ca_dispatch) is not _ca_function:
        raise _ca_error('Cold authority caller dispatcher identity differs')
    for (_ca_name, _ca_getter), _ca_expected in _ca_zip(_ca_p[4], _ca_record[1:7]):
        if _ca_id(_ca_getter(_ca_dispatch, _ca_function)) != _ca_id(_ca_expected):
            raise _ca_error('Cold authority caller dispatcher environment differs')
    if _ca_record[4] is not None or _ca_record[5] is not None or _ca_record[7]:
        raise _ca_error('Cold authority caller dispatcher defaults contract differs')
    for _ca_cell, _ca_expected in _ca_record[8]:
        try:
            _ca_observed_id = _ca_id(_ca_p[6](_ca_cell, _ca_p[5]))
        except _ca_value_error:
            raise _ca_error('Cold authority caller dispatcher cell became empty') from None
        if _ca_observed_id != _ca_id(_ca_expected):
            raise _ca_error('Cold authority caller dispatcher cell differs')
    # END caller admission guarded_adapters_v4:22
    return _ca_dispatch(0, *_ca_args, **_ca_kwargs)


