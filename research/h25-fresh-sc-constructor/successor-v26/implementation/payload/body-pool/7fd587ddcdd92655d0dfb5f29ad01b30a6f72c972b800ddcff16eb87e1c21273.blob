    used = SHAPE_CAP - 1;
    shape = shape && key_shape(&state, query, &used) == -1 && used == SHAPE_CAP;
    Py_DECREF(query);
    int indices = 1;
    int8_t small[3] = {-1, -2, 127};
    indices = indices && read_index_bytes((const char *)small, 0, 1) == -1 &&
              read_index_bytes((const char *)small, 1, 1) == -2 && read_index_bytes((const char *)small, 2, 1) == 127;
    int16_t medium[3] = {-1, -2, 32767};
    indices = indices && read_index_bytes((const char *)medium, 0, 2) == -1 &&
              read_index_bytes((const char *)medium, 1, 2) == -2 && read_index_bytes((const char *)medium, 2, 2) == 32767;
    int32_t large[3] = {-1, -2, INT32_MAX};
    indices = indices && read_index_bytes((const char *)large, 0, 4) == -1 &&
              read_index_bytes((const char *)large, 1, 4) == -2 && read_index_bytes((const char *)large, 2, 4) == INT32_MAX;
    if (!(exact && saturation && shape && indices)) {
