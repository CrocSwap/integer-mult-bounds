        PyErr_SetString(PyExc_RuntimeError, "Bounds fixture public runtime differs");
        return NULL;
    }
    ProbeState state = {0};
    uint64_t counter = UINT64_MAX - 1;
    add_count(&state, &counter, 1);
    int exact = counter == UINT64_MAX && state.overflow == 0;
    add_count(&state, &counter, 1);
    int saturation = counter == UINT64_MAX && state.overflow == 1;
    add_count(&state, &counter, UINT64_MAX);
    saturation = saturation && counter == UINT64_MAX && state.overflow == 1;
    uint32_t used = SHAPE_CAP - 1;
