ring r=2,(u_0_0,u_0_6,u_3_1,u_3_7,u_4_0,u_4_7,u_10_0,u_10_1,u_12_0,u_12_2,u_13_1,u_13_2,w_0_0,w_0_6,w_3_1,w_3_7,w_4_0,w_4_7,w_10_0,w_10_1,w_12_0,w_12_2,w_13_1,w_13_2),dp;
option(redSB);
ideal I=w_0_0*u_0_0+w_0_6*u_0_6-1,
w_3_1*u_3_1+w_3_7*u_3_7-1,
w_4_0*u_4_0+w_4_7*u_4_7-1,
w_10_0*u_10_0+w_10_1*u_10_1-1,
w_12_0*u_12_0+w_12_2*u_12_2-1,
w_13_1*u_13_1+w_13_2*u_13_2-1,
w_0_0*u_4_0,
w_0_0*u_10_0,
w_0_0*u_12_0,
w_3_7*u_4_7,
w_3_1*u_10_1,
w_3_1*u_13_1,
w_4_0*u_0_0,
w_4_7*u_3_7,
w_4_0*u_10_0,
w_4_0*u_12_0,
w_10_0*u_0_0,
w_10_1*u_3_1,
w_10_0*u_4_0,
w_10_0*u_12_0,
w_10_1*u_13_1,
w_12_0*u_0_0,
w_12_0*u_4_0,
w_12_0*u_10_0,
w_12_2*u_13_2,
w_13_1*u_3_1,
w_13_1*u_10_1,
w_13_2*u_12_2;
ideal G=std(I);
print("size of std basis:"); print(size(G)); print(G[1]);
quit;
