{
  "commands": [
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/verify.py"
      ],
      "checks": "Exact live-source and exported-source pins; complete new receipt binding",
      "timeout_seconds": 30
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/check_bit_prime.py"
      ],
      "checks": "Complete recursive Lucas certificate and bad-class bound",
      "timeout_seconds": 30
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/check_composition.py"
      ],
      "checks": "Exact root, both BIT moments, cost and side slacks, rejected old routes and scalar grid",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/check_batched_crt.py"
      ],
      "checks": "Complete modular networks, padded CRT endpoints, dirty compact guards and repairs",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/check_compact_crt.py"
      ],
      "checks": "Actual raw compact words and keyed repair composed into forward/inverse CRT",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "{python}",
        "-B",
        "{package}/vendor/source_sched_test.py"
      ],
      "checks": "Retained exact current-value sparse-union schedule",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "{python}",
        "-O",
        "-B",
        "{package}/check_composition.py"
      ],
      "checks": "Optimized-mode exact arithmetic and rejecting controls",
      "timeout_seconds": 60
    }
  ],
