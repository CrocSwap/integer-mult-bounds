+        int next=point^(1<<word[i]);
+        int side=parity(next&mask);
+        size[side]++;
+        if(word[i]==omitted) stays[side]++; else crossing++;
+        point=next;
+    }
+    if(!r) return __builtin_popcount((unsigned)q)==1 ? (uint32_t)1<<size[0] : 0;
+    for(int vertex=0;vertex<(1<<N);vertex++) if(!(seen&bit(vertex))) {
