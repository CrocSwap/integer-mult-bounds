  "scope": {
    "JsonTableGather": "Actual AST bounded-index success derives logical gathered payloads in original order, with arbitrary payload universes, array lengths and repeated indices.",
    "JsonOwnerFieldAdapter": "Strict named owners-field decoding retains each complete raw route and actual route-decoder equation. Executed family-list comparison against an existing assignment derives ordered payload output.",
    "JsonGlobalCallAdapter": "Named calls-array count and original index selection feed the accepted owners adapter. Actual composed success derives both selected AST fields and checked assignment output.",
    "JsonPackedColumnDictionary": "Actual named dictionary entry decodes into bounded ordered packed columns. A separately checked auxiliary JSON certificate and executed scalar column comparison derive the independent column operator, both inverses and arbitrary-payload cancellation."
  },
  "limits": [
