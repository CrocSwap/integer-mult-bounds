private def supported (region : Reg → Prop) [DecidablePred region]
    (word : List (Gate Reg)) : Bool :=
  word.all (fun g => decide (region g.dst) &&
    g.sources.all (fun r => decide (region r)))

private theorem supported_sound (region : Reg → Prop) [DecidablePred region]
    (word : List (Gate Reg)) (h : supported region word = true) :
    ClosedOn region word := by
  intro g hg
  have hx := List.all_eq_true.mp h g hg
  obtain ⟨hd, hs⟩ := Bool.and_eq_true_iff.mp hx
  exact ⟨of_decide_eq_true hd,
    fun r hr => of_decide_eq_true (List.all_eq_true.mp hs r hr)⟩

/-- All498 actual preparation gates are retained, at frame zero. -/
theorem complete_layout : helpers.length = 192 ∧ preparation.length = 306 ∧
    (helpers ++ preparation).all (fun g => decide (g.frame = 0)) = true := by
  decide +kernel

private theorem helper_support_check :
    supported (fun r => ¬ target r) helpers = true := by decide +kernel
private theorem preparation_support_check :
    supported target preparation = true := by decide +kernel
private theorem helper_self_check :
    helpers.all (fun g => g.sources.all (fun r => decide (r ≠ g.dst))) = true := by
  decide +kernel

theorem helpers_closed : ClosedOn (fun r => ¬ target r) helpers :=
  supported_sound _ _ helper_support_check

theorem preparation_closed : ClosedOn target preparation :=
  supported_sound _ _ preparation_support_check

theorem helpers_no_self : ∀ g ∈ helpers, g.dst ∉ g.sources := by
  intro g hg hself
  have h := List.all_eq_true.mp helper_self_check g hg
  exact (of_decide_eq_true (List.all_eq_true.mp h g.dst hself)) rfl

