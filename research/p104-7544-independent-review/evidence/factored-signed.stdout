"count": 1, "source": "EXPECTED='64fca675b91298868e12f09423b47e0c2327cba7095e35c8919c1953b4ed68b8'"}, {"adapted": "affected={(3,721),(721,724),(721,904),(3,724),(724,904)}\n    before = read(ROOT/'frozen-composition/7481-WORD.json.gz')\n    need(sha256(canonical(before)).hexdigest()=='64fca675b91298868e12f09423b47e0c2327cba7095e35c8919c1953b4ed68b8','Exact #7481 control')\n    pairs = lambda w: {(e[2],e[3]) for e in w['program'] if e[0]=='MOVE'}\n    new_pairs = pairs(word)-pairs(before)\n    need(len(new_pairs)==2,'Both new chart pairs')\n    affected |= new_pairs", "count": 1, "source": "affected={(3,721),(721,724),(721,904),(3,724),(724,904)}"}, {"adapted": "incumbent=read(ROOT/'frozen-composition/7481-WORD.json.gz')\n        need(incumbent==dict(old,program=emitted),'Rebuild exact #7481 from its predecessor')\n        need(new==read(ROOT/'frozen-composition/COMPOSED-WORD.json.gz'),'Literal composed word')\n        need({k:v for k,v in new.items() if k!='program'}=={k:v for k,v in incumbent.items() if k!='program'},'Unchanged boundary metadata')", "count": 1, "source": "need(new==dict(old,program=emitted),'Literal complete emitted splice and unchanged boundary')"}, {"adapted": "=={1:-1,3:-1,4:-1,5:-1,6:1,7:1}", "count": 1, "source": "=={1:1,3:-1,4:-1,6:1}"}, {"adapted": "len(old['program'])+19", "count": 1, "source": "len(old['program'])+3"}, {"adapted": "('doubled_824_compensation',['ADD',824,54,'-1',721]),\n            ('doubled_1438_restoration',['ADD',1438,1439,'1',127])):", "count": 1, "source": "('doubled_824_compensation',['ADD',824,54,'-1',721])):"}, {"adapted": "'PASS_COMPOSED_7481_7542_COMPLETE_NATIVE'", "count": 1, "source": "'PASS_CHANGED_485_1455_PRODUCER_COMPLETE_NATIVE'"}], "source_sha256": "96257fbcebd3a1ac7f742868bd40d6a15dc4804bda2802ecf5d89bbd88e3a5d4"}, "native_receipt_origin": "authenticated frozen source receipt, mathematically equal to required fresh native command", "signed_adapter": {"adapted_sha256": "f3a09f651e51b781c2b99244b21513161546