tructed #7481 invoice", "count": 1, "source": "Whole reconstructed #7480 invoice"}, {"adapted": "assert Q(gate['claim'])>Q(previous['gate']['raw_bracket'][1]),'Strictly higher than #7481 raw crossing'\n  assert Q(gate['claim'])>Q('0.0036475398278'),'Strictly higher than upper endpoint of #7542 price enclosure'", "count": 1, "source": "assert Q(gate['claim'])>Q('0.003646777872835')"}, {"adapted": "directed=G.module('producer_native_comparator',vendor/'interval_gate.py')\n  assert directed.moment(G.signed(before),Q(gate['claim']))[1]<0,'Exact #7481 invoice rejects the new signed claim'", "count": 1, "source": "directed=G.module('producer_native_comparator',vendor/'interval_gate.py')"}, {"adapted": "    native_baseline_rejects_new_claim=True,signed_incumbent_rejects_new_claim=True,\n    old_native=old_result['word_canonical_sha256'],new_native=new_result['word_canonical_sha256']))", "count": 1, "source": "    native_baseline_rejects_new_claim=True,old_native=old_result['word_canonical_sha256'],new_native=new_result['word_canonical_sha256']))"}, {"adapted": "PASS_COMPOSED_7481_7542_COMPLETE_SIGNED_APPLICATION", "count": 1, "source": "PASS_CHANGED_485_1455_PRODUCER_COMPLETE_SIGNED_APPLICATION"}, {"adapted": "source_head='89eaa9d8cae37c1540de98f2d29a3abaabb96a2b',\n    component_head='71f5acb0409daf208a865482f3349049dbd3251c',timings=log", "count": 1, "source": "source_head='58a9d052143f5d85295ed2d0163591c47f89a331',timings=log"}], "source_sha256": "af1ec8e27b39fdcfe8c1c5ec3eae14c1124c62b5cdcf3c1218482b6291c6ceef"}, "stage": "signed"}
