+def center_segments(word, current, frames):
+    """Literal nested target COPY paths, including every intermediate child.
+
+    Seed39 adaptation by Tekalign (@tekuuu), with substantial Codex assistance.
+    External ports/frames are independently checked by audit_mixed.py.
+    """
+    levels = {int(t): f for t, f in word['target_levels'].items()}
+    require(set(levels) == {23, 34, 50, 108}, 'four lifted target offsets')
+    require(all(frames[f] == (30,) for f in levels.values()), 'target line30')
+    require(all(current[V+t] == frames[levels.get(t, 0)] for t in range(V)), 'target centre level')
+    forward, backward = [], []
+    for index, (register, frame_id) in enumerate(zip(word['centers'], word['center_frames'])):
+        require(current[register] == frames[frame_id], 'centre carrier frame')
+        served = set()
+        for event in word['cut']:
+            require(event[0] == 'add' and V <= event[1] < 2*V and event[2] in word['centers'], 'centre cut interface')
+            if event[2] == register:
+                served.add(levels.get(event[1]-V, 0))
+        require(0 in served, 'centre COPY reaches zero')
+        origin, segments = frame_id, []
+        for destination in sorted(served, key=lambda f: -len(frames[f])):
+            require(basis(frames[destination] + frames[origin]) == frames[origin], 'nested centre COPY')
+            rank = len(frames[origin])-len(frames[destination])
+            if rank:
+                segments.append(['center', index, origin, destination, rank])
+            origin = destination
+        forward.extend(segments)
+        backward.extend(e[:2]+[e[3], e[2], e[4]] for e in reversed(segments))
+    require(Counter(e[4] for e in forward) == {1:4, 7:4, 8:4}, 'twelve centre children')
+    return {'forward': forward, 'backward': backward}
+
