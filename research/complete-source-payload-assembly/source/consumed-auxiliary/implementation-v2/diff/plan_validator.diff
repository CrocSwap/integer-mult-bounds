+def command_plain(value):
+    """Bounded built-in DATA only, before comparison, formatting or dispatch.
+
+    This is a per-command SOURCE record bound; no runtime/wire cap is raised.
+    """
+    budget = [0, 0]
+    def visit(item, depth):
+        budget[0] += 1
+        need(depth <= 24 and budget[0] <= 8192, 'command DATA node/depth bound')
+        if item is None or type(item) is bool:
+            return
+        if type(item) is int:
+            need(-(1 << 127) <= item < (1 << 127), 'command DATA integer')
+            return
+        if type(item) is str:
+            budget[1] += len(item)
+            need(len(item) <= 8192 and budget[1] <= 524288, 'command DATA text bound')
+            return
+        need(type(item) in (dict, list) and len(item) <= 8192, 'command native DATA container')
+        if type(item) is dict:
+            for key, sub in item.items():
+                need(type(key) is str, 'command native DATA key')
+                visit(key, depth + 1)
+                visit(sub, depth + 1)
+        else:
+            for sub in item:
+                visit(sub, depth + 1)
+    visit(value, 0)
+
+
+def typed_equal(left, right):
+    """For already checked native DATA, bool is never interchangeable with int."""
+    if type(left) is not type(right):
+        return False
+    if type(left) is dict:
+        return set(left) == set(right) and all(typed_equal(left[k], right[k]) for k in left)
+    if type(left) is list:
+        return len(left) == len(right) and all(typed_equal(a, b) for a, b in zip(left, right))
+    return left == right
+
+
+def _command_fields(value, keys, message):
+    need(type(value) is dict, message)
+    command_plain(value)
+    need(set(value) == keys, message)
+
+
+def _validate_root_command(command, expected, role):
+    _command_fields(command, ROOT_COMMAND_KEYS, 'Root command exact fields')
+    need(type(command['optimize']) is int and command['optimize'] in (0, 1), 'Root optimize exact integer')
+    need(command['execution_authorized'] is False, 'Root execution authority remains false')
+    need(type(command['argv']) is list and all(type(v) is str for v in command['argv']), 'Root argv native strings')
+    argv = command['argv']
+    prefix = [PYTHON] + (['-O'] if command['optimize'] else []) + ['-S', '-s', '-P', '-B']
+    root, locators = role['runtime_stage_root'], role['source_locator']
+    driver_path = expected['argv'][len(prefix) + 7]
+    need(driver_path.startswith(root + '/') and driver_path[len(root) + 1:] in locators,
+         'Root prescribed driver belongs to exact role')
+    # The complete Root boundary is fixed, including flag ordering. Tail argv
+    # remains exact DATA from the independently frozen full row below.
+    head = prefix + [root + '/integration/full_driver.py', '--root-sha256',
+        locators['integration/full_driver.py']['sha256'], '--provider',
+        root + '/integration/probe_binding_v3.py', locators['integration/probe_binding_v3.py']['sha256'],
+        '--driver', driver_path, locators[driver_path[len(root) + 1:]]['sha256'],
+        '--integration', root + '/integration', '--']
+    need(argv[:len(head)] == head and argv.count('--') == 1, 'Root exact grammar and delimiter')
+    need(command['cwd'] == EXACT_WORKSPACE + '/outputs/h25-data-handling-20261028'
+         and typed_equal(command['environment'], COMMAND_ENVIRONMENT), 'Root cwd/environment')
+    need(typed_equal(command, expected), 'Root complete prescribed record')
+
