+def validate_command_catalogue(commands, fixed, roles, expected_commands):
+    """Pure mixed-catalogue validation; no file IO, imports or commands run.
+
+    expected_commands comes from the separately frozen original COMMANDS input,
+    not from observed results or this validator's emitted labels. Controls may
+    mutate commands in memory while this independent expected DATA stays fixed.
+    Outer file hashes remain an additional authentication boundary in the real
+    authenticate_recipe caller, never a semantic-test bypass.
+    """
+    need(type(commands) is list and len(commands) == 100, 'exact ordered 100 command records')
+    need(type(expected_commands) is list and len(expected_commands) == 100, 'frozen expected command records')
+    need(type(fixed) is dict and type(fixed.get('commands')) is dict
+         and type(fixed.get('preparations')) is dict, 'frozen fixed preparations')
+    need(type(roles) is list and len(roles) == 71, 'all 71 source roles remain required')
+    by_role = {r['role']: r for r in roles}
+    need(len(by_role) == 71, 'distinct source role identities')
+    command_roles, identities = set(), set()
+    root_count, prep_count, normal_count, optimized_count = 0, 0, 0, 0
+    for index in range(100):
+        command, expected = commands[index], expected_commands[index]
+        need(type(command) is dict and type(expected) is dict, 'native command record')
+        command_plain(command)
+        command_plain(expected)
+        kind = PREPARATION_COMMAND_POSITIONS.get(index)
+        keys = PREPARATION_COMMAND_KEYS if kind is not None else ROOT_COMMAND_KEYS
+        _command_fields(command, keys, 'prescribed structural command family')
+        _command_fields(expected, keys, 'frozen structural command family')
+        for field in ('role', 'selection_id', 'optimize'):
+            need(typed_equal(command[field], expected[field]), 'ordered command identity')
+        need(type(command['role']) is str and command['role'] in by_role, 'known command role')
+        need(type(command['optimize']) is int and command['optimize'] in (0, 1), 'command optimize exact integer')
+        identity = (command['role'], command['optimize'])
+        need(identity not in identities, 'duplicate command identity')
+        identities.add(identity)
+        command_roles.add(command['role'])
+        if kind is not None:
+            joined = dict(fixed['commands'][kind])
+            need(not ({'optimize', 'role', 'selection_id'} & set(joined)), 'fixed preparation annotation collision')
+            joined.update(optimize=0, role='selection:' + kind + ':', selection_id=kind + ':')
+            command_plain(joined)
+            need(typed_equal(command, joined) and typed_equal(expected, joined), 'complete typed fixed preparation join')
+            need(typed_equal(command['preparation_pin'], fixed['preparations'][kind]), 'fixed preparation pin join')
+            need(command['execution_authorized'] is False and type(command['mode']) is int
+                 and command['mode'] == 0, 'preparation inert authority and mode')
+            prep_count += 1
+        else:
+            _validate_root_command(command, expected, by_role[command['role']])
+            root_count += 1
+            if command['optimize'] == 0:
+                normal_count += 1
+            else:
+                optimized_count += 1
+    need((root_count, prep_count, normal_count, optimized_count) == (97, 3, 64, 33), 'mixed command denominators')
+    need(len(command_roles) == 69 and set(by_role) - command_roles == {'reference:G12', 'reference:P02'},
+         '69 command roles and two required source-only references')
+    return {'commands': 100, 'root_commands': 97, 'preparation_commands': 3,
+            'root_normal': 64, 'root_optimized': 33, 'command_roles': 69, 'source_roles': 71}
