+# Frozen command DATA has two structural families and NO per-record schema
+# field. These positions/cases come from the independent frozen catalogue and
+# source-input comparison; delimiter presence never chooses a family.
+PREPARATION_COMMAND_POSITIONS = {36: 'N22', 41: 'P02', 46: 'P07'}
+ROOT_COMMAND_KEYS = {'argv', 'cwd', 'environment', 'execution_authorized',
+                     'optimize', 'role', 'scope', 'selection_id',
+                     'source_method', 'variant'}
+PREPARATION_COMMAND_KEYS = {'argv', 'catalog_row_currently_ready', 'cwd',
+    'environment', 'execution_authorized', 'mode', 'optimize',
+    'preliteral_whole_code_accepted', 'preparation_pin', 'role', 'selection_id',
+    'status', 'whole_source_acceptance', 'whole_source_acceptance_scope'}
+COMMAND_ENVIRONMENT = {'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8', 'PATH': '/usr/bin:/bin',
