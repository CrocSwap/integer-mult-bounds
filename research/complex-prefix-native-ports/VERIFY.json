    "research/complex-prefix-native-ports/README.md",
    "research/complex-prefix-native-ports/SECTOR-COMPLETION.md",
    "research/complex-prefix-native-ports/SOURCE-PINS.json",
    "research/complex-prefix-native-ports/SOURCES.json",
    "research/complex-prefix-native-ports/TASK.json",
    "research/complex-prefix-native-ports/VERIFY.json",
    "research/complex-prefix-native-ports/WORD-REVIEW.md",
    "research/complex-prefix-native-ports/finite_geometry.py",
