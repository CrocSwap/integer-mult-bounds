{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "research/p112-root-simplex-exclusion/geometry.py"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-W",
        "error",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 120,
      "checks": "source-bound roots/labels; complete polar section certificate and equality"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-W",
        "error",
        "-B",
        "{package}/independent_check.py"
      ],
      "timeout_seconds": 120,
      "checks": "independent norm/root reconstruction and dot-RREF section certificate"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-W",
        "error",
        "-B",
        "{package}/test_package.py"
      ],
      "timeout_seconds": 120,
      "checks": "six source controls and four geometry controls, with optimized checks enabled"
    }
  ]
}
