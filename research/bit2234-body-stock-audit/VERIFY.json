{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "certificates/selected-result.json"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 60,
      "checks": "Source-authenticated canonical receipt; exact cutoff, prime, staircase, tail constants and nofixedpoint witness"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/independent_check.py"
      ],
      "timeout_seconds": 120,
      "checks": "Independent full-GL integer comparisons and all1048575 positive widths below2^20"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/test_verify.py"
      ],
      "timeout_seconds": 180,
      "checks": "Independent boundary, row and public-CLI failure controls"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-B",
        "{package}/test_verify.py"
      ],
      "timeout_seconds": 180,
      "checks": "The same semantic and source/receipt controls with Python assertions disabled"
    }
  ]
}
