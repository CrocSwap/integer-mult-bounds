{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "research/c5-dyadic-decoder-gate/inputs/DATA-PHASES.json.gz",
    "research/c5-dyadic-decoder-gate/inputs/MATCHING.json"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-W",
        "error",
        "-B",
        "{package}/verify.py"
      ],
      "timeout_seconds": 120,
      "checks": "All physical tariffs, exact traces, bounded counts and strict cost20 fits"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-W",
        "error",
        "-B",
        "{package}/independent.py"
      ],
      "timeout_seconds": 120,
      "checks": "Dense binary ranks, integer traces, cost layers and singleton attainment"
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-W",
        "error",
        "-B",
        "{package}/test_verify.py"
      ],
      "timeout_seconds": 120,
      "checks": "Rank-only false positive, loose/capped blocks, source inventories and corruption controls"
    }
  ]
}
