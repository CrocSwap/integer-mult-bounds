import BinaryChartCanonicalEncoding
import Current1094L450OrderedChart

/-!
UNCOMPILED thin application of the reusable parsed chart checker to the already
accepted L450 definitions. No source array is copied or re-enumerated. The old
sourceColumn, axis, u, parity, all_columns_factor and column_action are reused.
Only a small constant bound and symbolic finite-function facts are added.

The new five-array Value certificate is generated by the generic canonical
encoder and actually accepted by the parsed checker. Its independent column
operator is the old accepted L450 sourceLinear. This does not prove a byte
parser or external conversion from ACTUAL-SIGMAS to this new grammar, nor bind
an actual Hosting pullback convention, affine shift or complex phase. The
physical executor, recipes, precision and cost remain separate.
Author-checked source context:
kappa=836330098538459/500000000000000000=0.001672660197076918.
Attribution: accepted L450 source retains Rohan Arun/PR1094, Jeremy Kothe and
Hao Yan/icekylinx lineage; generic strict codec/chart certificates and Lean/
Mathlib. Apache-2.0; OpenAI assistance.
-/
set_option Elab.async false
set_option autoImplicit false

namespace CurrentMain.Current1094L450ParsedCertificate

def candidate : CheckedBinaryChart.Candidate 73 :=
  CheckedBinaryChart.Candidate.mk Current1094L450OrderedChart.sourceColumn
    Current1094L450OrderedChart.axis Current1094L450OrderedChart.u
    (fun j => Current1094L450OrderedChart.parity (Pi.single j 1))

private theorem tiny_bounds : 1 < (2 : Nat) ∧ 9 < (73 : Nat) ∧ 387 < 2 ^ (9 : Nat) := by
  decide +kernel

private theorem column_bounds (j : Fin 73) : candidate.columns j < 2 ^ 73 := by
  change Current1094L450OrderedChart.sourceColumn j < 2 ^ 73
  rw [Current1094L450OrderedChart.all_columns_factor]
  have hp : 2 ^ (Current1094L450OrderedChart.axis j).val < 2 ^ 73 :=
    Nat.pow_lt_pow_right tiny_bounds.1 (Current1094L450OrderedChart.axis j).isLt
  have hu : 387 < 2 ^ 73 :=
    lt_trans tiny_bounds.2.2 (Nat.pow_lt_pow_right tiny_bounds.1 tiny_bounds.2.1)
  unfold Current1094L450OrderedChart.factorColumn
  split
  · exact Nat.xor_lt_two_pow hp hu
  · exact hp

/-- Reconstructing a linear form from all unit-coordinate coefficients recovers
it on arbitrary coefficients; this is not a finite address census. -/
private theorem form_eq_parity :
    CheckedBinaryChart.form candidate = Current1094L450OrderedChart.parity := by
  apply LinearMap.pi_ext
  intro j a
  rw [CheckedBinaryChart.form, LinearMap.lsum_piSingle]
  change a • Current1094L450OrderedChart.parity (Pi.single j 1) =
    Current1094L450OrderedChart.parity (Pi.single j a)
  have hs : Pi.single j a = a • (Pi.single j 1 : CheckedBinaryChart.Address 73) := by
    rw [← Pi.single_smul']
    simp
  rw [hs, map_smul]

private theorem parity_update_zero :
    Current1094L450OrderedChart.parity Current1094L450OrderedChart.u = 0 := by
  change ((Current1094L450OrderedChart.u 0 + Current1094L450OrderedChart.u 1) +
    Current1094L450OrderedChart.u 7) + Current1094L450OrderedChart.u 8 = 0
  have h0 : Current1094L450OrderedChart.u 0 = 1 := by simp [Current1094L450OrderedChart.u]
  have h1 : Current1094L450OrderedChart.u 1 = 1 := by simp [Current1094L450OrderedChart.u]
  have h7 : Current1094L450OrderedChart.u 7 = 1 := by simp [Current1094L450OrderedChart.u]
  have h8 : Current1094L450OrderedChart.u 8 = 1 := by simp [Current1094L450OrderedChart.u]
  rw [h0, h1, h7, h8, ZModModule.add_self, zero_add, ZModModule.add_self]

private theorem reorder_unit {n : Nat} (p : Equiv.Perm (Fin n)) (j : Fin n) :
    CheckedBinaryChart.reorder p (Pi.single j 1) = Pi.single (p j) 1 := by
  funext i
  change (Pi.single j 1 : CheckedBinaryChart.Address n) (p.symm i) =
    (Pi.single (p j) 1 : CheckedBinaryChart.Address n) i
  simp only [Pi.single_apply, Equiv.symm_apply_eq]

private theorem reorder_eq : Current1094L450OrderedChart.reorder =
    CheckedBinaryChart.reorder Current1094L450OrderedChart.axis := by
  apply LinearEquiv.ext
  intro x
  funext i
  rfl

/-- The accepted old column theorem supplies every scalar certificate entry. -/
private theorem scalar_entry (j i : Fin 73) :
    CheckedBinaryChart.bits (candidate.columns j) i =
      (Pi.single (candidate.permutation j) 1 : CheckedBinaryChart.Address 73) i +
        candidate.coefficients (candidate.permutation j) * candidate.updateVector i := by
  have hc := Current1094L450OrderedChart.column_action j
  change CheckedBinaryChart.bits (Current1094L450OrderedChart.sourceColumn j) =
    Current1094L450OrderedChart.transvection
      (Current1094L450OrderedChart.reorder (Pi.single j 1)) at hc
  rw [reorder_eq, reorder_unit] at hc
  change CheckedBinaryChart.bits (Current1094L450OrderedChart.sourceColumn j) =
    Pi.single (Current1094L450OrderedChart.axis j) 1 +
      Current1094L450OrderedChart.parity
        (Pi.single (Current1094L450OrderedChart.axis j) 1) • Current1094L450OrderedChart.u at hc
  exact congrFun hc i

/-- Real scalar checks are derived from existing accepted structural identities. -/
theorem candidate_check : CheckedBinaryChart.check candidate = true := by
  apply (CheckedBinaryChart.check_iff candidate).mpr
  refine ⟨column_bounds, ?_, scalar_entry⟩
  rw [form_eq_parity]
  exact parity_update_zero

def parsedCertificate : SelectedSourceSyntax.Value :=
  BinaryChartCanonicalEncoding.encodeCandidate candidate candidate_check

theorem certify_result : ParsedBinaryChartCertificate.certify 73 parsedCertificate =
    some (⟨candidate, candidate_check⟩ : ParsedBinaryChartCertificate.Certified 73) :=
  BinaryChartCanonicalEncoding.certify_encodeCandidate candidate candidate_check

theorem parsed_check : ParsedBinaryChartCertificate.checkParsed 73 parsedCertificate = true :=
  BinaryChartCanonicalEncoding.checkParsed_encodeCandidate candidate candidate_check

theorem source_operator_eq : CheckedBinaryChart.sourceLinear candidate =
    Current1094L450OrderedChart.sourceLinear := rfl

/-- The accepted parser result denotes the already source-bound old operator. -/
theorem parsed_source_operator :
    ∃ r : ParsedBinaryChartCertificate.Certified 73,
      ParsedBinaryChartCertificate.certify 73 parsedCertificate = some r ∧
      CheckedBinaryChart.sourceLinear r.val = Current1094L450OrderedChart.sourceLinear :=
  ⟨⟨candidate, candidate_check⟩, certify_result, source_operator_eq⟩

theorem factored_operator_eq :
    (CheckedBinaryChart.checkedEquiv candidate candidate_check).toLinearMap =
      Current1094L450OrderedChart.addressEquiv.toLinearMap := by
  rw [← CheckedBinaryChart.sourceLinear_eq_checked candidate candidate_check,
    source_operator_eq, Current1094L450OrderedChart.sourceLinear_eq]

end CurrentMain.Current1094L450ParsedCertificate
#print axioms CurrentMain.Current1094L450ParsedCertificate.candidate_check
#print axioms CurrentMain.Current1094L450ParsedCertificate.certify_result
#print axioms CurrentMain.Current1094L450ParsedCertificate.parsed_check
#print axioms CurrentMain.Current1094L450ParsedCertificate.source_operator_eq
#print axioms CurrentMain.Current1094L450ParsedCertificate.parsed_source_operator
#print axioms CurrentMain.Current1094L450ParsedCertificate.factored_operator_eq
#check @CurrentMain.Current1094L450ParsedCertificate.parsed_source_operator
