set_option Elab.async false
set_option autoImplicit false
namespace CurrentMain.Current1094L450RecoveredEntry
open Current1094L450ParsedCertificate (candidate candidate_check)

def columns : JsonPackedColumnDictionary.Columns 73 :=
  BinaryChartCanonicalEncoding.columnVector candidate candidate_check

theorem columns_match : candidate.columns = ParsedBinaryChartCertificate.columnFunction columns := by
  funext j
  change candidate.columns j = (ParsedBinaryChartCertificate.vectorAt
    (BinaryChartCanonicalEncoding.vectorOfFunction (fun i =>
      (⟨candidate.columns i, CheckedBinaryChart.checked_column_bounds candidate candidate_check i⟩ :
        Fin (2 ^ 73)))) j).val
  rw [BinaryChartCanonicalEncoding.vectorAt_ofFunction]

def entry : JsonPackedColumnDictionary.CheckedEntry 73 :=
  ⟨columns, ⟨candidate, candidate_check⟩, fun j => congrFun columns_match j⟩

/-- Reuses actual old source data; the external named-field equality is explicit. -/
theorem recovered_entry (dictionary : Lean.Json) (key : String)
    (hfield : dictionary.getObjVal? key = .ok
      (StrictJsonValueBridge.reencode 2 (ParsedBinaryChartCertificate.vectorValue columns))) :
    RecoveredJsonProviderEntry.recoverEntry 73 dictionary key
      candidate.updateVector candidate.coefficients = some entry := by
  have hd : JsonPackedColumnDictionary.dictionaryColumns 73 dictionary key = some columns := by
    simp only [JsonPackedColumnDictionary.dictionaryColumns, hfield]
    exact JsonPackedColumnDictionary.decodeColumns_canonical columns
  exact RecoveredJsonProviderEntry.recoverEntry_complete dictionary key columns
    candidate candidate_check columns_match hd

/-- Independent operator equality reuses the old accepted source binding. -/
theorem source_operator : JsonPackedColumnDictionary.columnOperator columns =
    Current1094L450OrderedChart.sourceLinear := by
  rw [← Current1094L450ParsedCertificate.source_operator_eq]
  unfold JsonPackedColumnDictionary.columnOperator CheckedBinaryChart.sourceLinear
  rw [← columns_match]

end CurrentMain.Current1094L450RecoveredEntry
