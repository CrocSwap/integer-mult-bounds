{
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/source_check.py"
      ],
      "checks": "Authenticate the compact exact public source closure and reject a source-byte mutation.",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/check_terminal.py"
      ],
      "checks": "All-width terminal fixtures, original-source comparisons, exact histories and adversarial controls.",
      "timeout_seconds": 30
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/verify.py"
      ],
      "checks": "One fresh complete literal arithmetic/lifecycle/terminal source invocation on the fixed 73-role graph; exact residual and histories.",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-B",
        "-W",
        "error",
        "{package}/verify.py"
      ],
      "checks": "Repeat the full deterministic receipt with assertions disabled.",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "-W",
        "error",
        "{package}/review/check_terminal.py",
        "--terminal",
        "{package}/terminal.py",
        "--expected",
        "{package}/review/RESULT.json"
      ],
      "checks": "Independent raw-character arrays, all-role/target scan, exact per-op prices, retained histories, separate relocation and controls.",
      "timeout_seconds": 30
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-O",
        "-B",
        "-W",
        "error",
        "{package}/review/check_terminal.py",
        "--terminal",
        "{package}/terminal.py",
        "--expected",
        "{package}/review/RESULT.json"
      ],
      "checks": "Independent raw-character arrays, all-role/target scan, exact per-op prices, retained histories, separate relocation and controls with assertions disabled.",
      "timeout_seconds": 30
    }
  ],
