{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "research/capped-phase-fusion/evidence/inplace_algebra_ultra/check_circuits.py",
    "research/cubic-cyclic-inverse/vendor/interval_kernel.py",
    "research/rational-unitary-fft/engine.py",
    "research/rational-unitary-fft/exact.py",
    "research/rational-unitary-fft/full.py",
    "research/rational-unitary-fft/generator.py",
    "research/rational-unitary-fft/triangular.py",
    "research/rational-unitary-fft/vendor/STEIN-PROVENANCE.json",
    "research/rational-unitary-fft/vendor/stein_rational.py",
    "research/unconditional-batched-crt/check_batched_crt.py"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/check_root_gates.py"
      ],
      "timeout_seconds": 120,
      "checks": "Execute the padded root and verify each distinct issued pair word exactly, including bad-branch and singular controls."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/check_cartesian.py"
      ],
      "timeout_seconds": 60,
      "checks": "Generate, apply and independently check a nonunitary Cartesian multiplier on dirty wires."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/check_spectra.py"
      ],
      "timeout_seconds": 90,
      "checks": "Check the generated polar and Cartesian square symbols and the odd-grid cut on asymmetric spectra."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/check_outer.py"
      ],
      "timeout_seconds": 120,
      "checks": "Check the composite controller, global switch significance, complete CRT, direct character, old-weight mutant and tape exponents."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/check_filter.py"
      ],
      "timeout_seconds": 240,
      "checks": "Apply a rank-eight nonseparable projection twice to two fields and restore every dirty word."
    },
    {
      "argv": [
        "{python}",
        "-I",
        "-B",
        "{package}/check_product.py"
      ],
      "timeout_seconds": 480,
      "checks": "Generate and apply both forward and opposite physical transforms, recover coefficients before carry, and test signed and zero operands on distinct geometries."
    }
  ]
