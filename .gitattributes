* text=auto eol=lf
*.pdf binary
# Unified diffs require a leading space on blank context lines.
*.patch -whitespace
# Preserve the exact upstream bytes, including original whitespace.
upstream/** -whitespace
# Preserve the exact pinned third-party proof snapshots and notices.
references/copied-centers/pr29/** -whitespace
references/copied-centers/pr33/** -whitespace
references/semantic-bulk/** -whitespace

# Preserve the exact bytes of pinned upstream proof and witness snapshots.
references/partial-gauge/pr97/** whitespace=-blank-at-eof
# Preserve the exact pinned PR117 source bytes and legal notices.
references/three-stage-cover/pr117/** -whitespace
# PR186's manifest hashes original bytes, including two CRLF JSON artifacts.
research/coordinated-frames-and-entrance-banks/** -text -whitespace

# The target-pair manifest preserves this pinned upstream notice verbatim.
research/gen4-extra-target-pairs/NOTICE-PR283.md -text whitespace=cr-at-eol

# Preserve every source byte covered by the gen5 composition manifest.
research/gen5-retiming-targets/** -text whitespace=cr-at-eol
# Imported native files retain their original trailing blank lines.
research/gen5-retiming-targets/code/** whitespace=cr-at-eol,-blank-at-eof

# Preserve every source byte covered by the kernel/restoration manifest.
research/gen5-kernel-restoration/** -text whitespace=cr-at-eol
research/gen5-kernel-restoration/code/** whitespace=cr-at-eol,-blank-at-eof

# Preserve exact manifest-covered gen5b sources and inherited notices.
research/gen5b-weighted-matching/** -text -whitespace

# Frozen PR210 package and round-nine evidence retain their audited bytes.
research/five-stage-source527-banks/** -text -whitespace
research/community-round9-audit/** -text -whitespace
