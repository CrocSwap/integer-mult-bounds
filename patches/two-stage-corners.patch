+def rank(matrix):
+    a=[r[:] for r in matrix];rr=0
+    for j in range(len(a[0]) if a else 0):
+        z=next((i for i in range(rr,len(a)) if a[i][j]),None)
+        if z is None:continue
+        a[rr],a[z]=a[z],a[rr];pivot=a[rr][j]
+        for i in range(rr+1,len(a)):
+            q=a[i][j]
+            if not q:continue
