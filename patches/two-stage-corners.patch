+            right=[[int(v==C[col] or v==a+(m-d+col)%b or v==a+b) for v in dual] for col in prior+[j]]
+            l,r=rank(left),rank(right);assert (l,r)==(z['row_rank'],z['column_rank']) and l+r<i+1==z['size'];checked+=1
